<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <!-- 漸變色 -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F9FAFB"/>
      <stop offset="100%" stop-color="#E5E7EB"/>
    </linearGradient>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EF4444"/>
      <stop offset="100%" stop-color="#DC2626"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#4338CA"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#bgGrad)" rx="12"/>

  <!-- 標題欄 -->
  <rect x="0" y="0" width="600" height="48" fill="url(#headerGrad)" rx="12"/>
  <rect x="0" y="24" width="600" height="24" fill="url(#headerGrad)"/>
  <text x="300" y="32" text-anchor="middle" fill="#FFFFFF" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold">等值分數 — 方格模型</text>

  <!-- 三個方格區域 -->
  <!-- 1/2 紅 -->
  <g transform="translate(25, 65)">
    <rect x="0" y="0" width="170" height="170" rx="8" fill="#FFFFFF" filter="url(#shadow)"/>
    <text x="85" y="-8" text-anchor="middle" fill="#EF4444" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold">1/2 = 50格</text>
    <!-- 10x10 方格 -->
    <g transform="translate(10, 10)">
      <!-- 紅色填滿50格（上半部分） -->
      <g fill="url(#redGrad)" opacity="0.85">
        <rect x="0" y="0" width="15" height="15" rx="1"/><rect x="15" y="0" width="15" height="15" rx="1"/>
        <rect x="30" y="0" width="15" height="15" rx="1"/><rect x="45" y="0" width="15" height="15" rx="1"/>
        <rect x="60" y="0" width="15" height="15" rx="1"/><rect x="75" y="0" width="15" height="15" rx="1"/>
        <rect x="90" y="0" width="15" height="15" rx="1"/><rect x="105" y="0" width="15" height="15" rx="1"/>
        <rect x="120" y="0" width="15" height="15" rx="1"/><rect x="135" y="0" width="15" height="15" rx="1"/>
        <rect x="0" y="15" width="15" height="15" rx="1"/><rect x="15" y="15" width="15" height="15" rx="1"/>
        <rect x="30" y="15" width="15" height="15" rx="1"/><rect x="45" y="15" width="15" height="15" rx="1"/>
        <rect x="60" y="15" width="15" height="15" rx="1"/><rect x="75" y="15" width="15" height="15" rx="1"/>
        <rect x="90" y="15" width="15" height="15" rx="1"/><rect x="105" y="15" width="15" height="15" rx="1"/>
        <rect x="120" y="15" width="15" height="15" rx="1"/><rect x="135" y="15" width="15" height="15" rx="1"/>
        <rect x="0" y="30" width="15" height="15" rx="1"/><rect x="15" y="30" width="15" height="15" rx="1"/>
        <rect x="30" y="30" width="15" height="15" rx="1"/><rect x="45" y="30" width="15" height="15" rx="1"/>
        <rect x="60" y="30" width="15" height="15" rx="1"/><rect x="75" y="30" width="15" height="15" rx="1"/>
        <rect x="90" y="30" width="15" height="15" rx="1"/><rect x="105" y="30" width="15" height="15" rx="1"/>
        <rect x="120" y="30" width="15" height="15" rx="1"/><rect x="135" y="30" width="15" height="15" rx="1"/>
        <rect x="0" y="45" width="15" height="15" rx="1"/><rect x="15" y="45" width="15" height="15" rx="1"/>
        <rect x="30" y="45" width="15" height="15" rx="1"/><rect x="45" y="45" width="15" height="15" rx="1"/>
        <rect x="60" y="45" width="15" height="15" rx="1"/><rect x="75" y="45" width="15" height="15" rx="1"/>
        <rect x="90" y="45" width="15" height="15" rx="1"/><rect x="105" y="45" width="15" height="15" rx="1"/>
        <rect x="120" y="45" width="15" height="15" rx="1"/><rect x="135" y="45" width="15" height="15" rx="1"/>
      </g>
      <!-- 網格線 -->
      <g stroke="#D1D5DB" stroke-width="0.8" fill="none">
        <line x1="0" y1="0" x2="150" y2="0"/><line x1="0" y1="15" x2="150" y2="15"/>
        <line x1="0" y1="30" x2="150" y2="30"/><line x1="0" y1="45" x2="150" y2="45"/>
        <line x1="0" y1="60" x2="150" y2="60"/><line x1="0" y1="75" x2="150" y2="75"/>
        <line x1="0" y1="90" x2="150" y2="90"/><line x1="0" y1="105" x2="150" y2="105"/>
        <line x1="0" y1="120" x2="150" y2="120"/><line x1="0" y1="135" x2="150" y2="135"/>
        <line x1="0" y1="150" x2="150" y2="150"/>
        <line x1="0" y1="0" x2="0" y2="150"/><line x1="15" y1="0" x2="15" y2="150"/>
        <line x1="30" y1="0" x2="30" y2="150"/><line x1="45" y1="0" x2="45" y2="150"/>
        <line x1="60" y1="0" x2="60" y2="150"/><line x1="75" y1="0" x2="75" y2="150"/>
        <line x1="90" y1="0" x2="90" y2="150"/><line x1="105" y1="0" x2="105" y2="150"/>
        <line x1="120" y1="0" x2="120" y2="150"/><line x1="135" y1="0" x2="135" y2="150"/>
        <line x1="150" y1="0" x2="150" y2="150"/>
      </g>
      <!-- 邊框 -->
      <rect x="0" y="0" width="150" height="150" rx="2" fill="none" stroke="#EF4444" stroke-width="2"/>
    </g>
  </g>

  <!-- 2/4 藍 -->
  <g transform="translate(215, 65)">
    <rect x="0" y="0" width="170" height="170" rx="8" fill="#FFFFFF" filter="url(#shadow)"/>
    <text x="85" y="-8" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold">2/4 = 50格</text>
    <g transform="translate(10, 10)">
      <!-- 藍色填滿50格（上半部分） -->
      <g fill="url(#blueGrad)" opacity="0.85">
        <rect x="0" y="0" width="15" height="15" rx="1"/><rect x="15" y="0" width="15" height="15" rx="1"/>
        <rect x="30" y="0" width="15" height="15" rx="1"/><rect x="45" y="0" width="15" height="15" rx="1"/>
        <rect x="60" y="0" width="15" height="15" rx="1"/><rect x="75" y="0" width="15" height="15" rx="1"/>
        <rect x="90" y="0" width="15" height="15" rx="1"/><rect x="105" y="0" width="15" height="15" rx="1"/>
        <rect x="120" y="0" width="15" height="15" rx="1"/><rect x="135" y="0" width="15" height="15" rx="1"/>
        <rect x="0" y="15" width="15" height="15" rx="1"/><rect x="15" y="15" width="15" height="15" rx="1"/>
        <rect x="30" y="15" width="15" height="15" rx="1"/><rect x="45" y="15" width="15" height="15" rx="1"/>
        <rect x="60" y="15" width="15" height="15" rx="1"/><rect x="75" y="15" width="15" height="15" rx="1"/>
        <rect x="90" y="15" width="15" height="15" rx="1"/><rect x="105" y="15" width="15" height="15" rx="1"/>
        <rect x="120" y="15" width="15" height="15" rx="1"/><rect x="135" y="15" width="15" height="15" rx="1"/>
        <rect x="0" y="30" width="15" height="15" rx="1"/><rect x="15" y="30" width="15" height="15" rx="1"/>
        <rect x="30" y="30" width="15" height="15" rx="1"/><rect x="45" y="30" width="15" height="15" rx="1"/>
        <rect x="60" y="30" width="15" height="15" rx="1"/><rect x="75" y="30" width="15" height="15" rx="1"/>
        <rect x="90" y="30" width="15" height="15" rx="1"/><rect x="105" y="30" width="15" height="15" rx="1"/>
        <rect x="120" y="30" width="15" height="15" rx="1"/><rect x="135" y="30" width="15" height="15" rx="1"/>
        <rect x="0" y="45" width="15" height="15" rx="1"/><rect x="15" y="45" width="15" height="15" rx="1"/>
        <rect x="30" y="45" width="15" height="15" rx="1"/><rect x="45" y="45" width="15" height="15" rx="1"/>
        <rect x="60" y="45" width="15" height="15" rx="1"/><rect x="75" y="45" width="15" height="15" rx="1"/>
        <rect x="90" y="45" width="15" height="15" rx="1"/><rect x="105" y="45" width="15" height="15" rx="1"/>
        <rect x="120" y="45" width="15" height="15" rx="1"/><rect x="135" y="45" width="15" height="15" rx="1"/>
      </g>
      <g stroke="#D1D5DB" stroke-width="0.8" fill="none">
        <line x1="0" y1="0" x2="150" y2="0"/><line x1="0" y1="15" x2="150" y2="15"/>
        <line x1="0" y1="30" x2="150" y2="30"/><line x1="0" y1="45" x2="150" y2="45"/>
        <line x1="0" y1="60" x2="150" y2="60"/><line x1="0" y1="75" x2="150" y2="75"/>
        <line x1="0" y1="90" x2="150" y2="90"/><line x1="0" y1="105" x2="150" y2="105"/>
        <line x1="0" y1="120" x2="150" y2="120"/><line x1="0" y1="135" x2="150" y2="135"/>
        <line x1="0" y1="150" x2="150" y2="150"/>
        <line x1="0" y1="0" x2="0" y2="150"/><line x1="15" y1="0" x2="15" y2="150"/>
        <line x1="30" y1="0" x2="30" y2="150"/><line x1="45" y1="0" x2="45" y2="150"/>
        <line x1="60" y1="0" x2="60" y2="150"/><line x1="75" y1="0" x2="75" y2="150"/>
        <line x1="90" y1="0" x2="90" y2="150"/><line x1="105" y1="0" x2="105" y2="150"/>
        <line x1="120" y1="0" x2="120" y2="150"/><line x1="135" y1="0" x2="135" y2="150"/>
        <line x1="150" y1="0" x2="150" y2="150"/>
      </g>
      <rect x="0" y="0" width="150" height="150" rx="2" fill="none" stroke="#4F46E5" stroke-width="2"/>
    </g>
  </g>

  <!-- 4/8 綠 -->
  <g transform="translate(405, 65)">
    <rect x="0" y="0" width="170" height="170" rx="8" fill="#FFFFFF" filter="url(#shadow)"/>
    <text x="85" y="-8" text-anchor="middle" fill="#10B981" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold">4/8 = 50格</text>
    <g transform="translate(10, 10)">
      <!-- 綠色填滿50格（上半部分） -->
      <g fill="url(#greenGrad)" opacity="0.85">
        <rect x="0" y="0" width="15" height="15" rx="1"/><rect x="15" y="0" width="15" height="15" rx="1"/>
        <rect x="30" y="0" width="15" height="15" rx="1"/><rect x="45" y="0" width="15" height="15" rx="1"/>
        <rect x="60" y="0" width="15" height="15" rx="1"/><rect x="75" y="0" width="15" height="15" rx="1"/>
        <rect x="90" y="0" width="15" height="15" rx="1"/><rect x="105" y="0" width="15" height="15" rx="1"/>
        <rect x="120" y="0" width="15" height="15" rx="1"/><rect x="135" y="0" width="15" height="15" rx="1"/>
        <rect x="0" y="15" width="15" height="15" rx="1"/><rect x="15" y="15" width="15" height="15" rx="1"/>
        <rect x="30" y="15" width="15" height="15" rx="1"/><rect x="45" y="15" width="15" height="15" rx="1"/>
        <rect x="60" y="15" width="15" height="15" rx="1"/><rect x="75" y="15" width="15" height="15" rx="1"/>
        <rect x="90" y="15" width="15" height="15" rx="1"/><rect x="105" y="15" width="15" height="15" rx="1"/>
        <rect x="120" y="15" width="15" height="15" rx="1"/><rect x="135" y="15" width="15" height="15" rx="1"/>
        <rect x="0" y="30" width="15" height="15" rx="1"/><rect x="15" y="30" width="15" height="15" rx="1"/>
        <rect x="30" y="30" width="15" height="15" rx="1"/><rect x="45" y="30" width="15" height="15" rx="1"/>
        <rect x="60" y="30" width="15" height="15" rx="1"/><rect x="75" y="30" width="15" height="15" rx="1"/>
        <rect x="90" y="30" width="15" height="15" rx="1"/><rect x="105" y="30" width="15" height="15" rx="1"/>
        <rect x="120" y="30" width="15" height="15" rx="1"/><rect x="135" y="30" width="15" height="15" rx="1"/>
        <rect x="0" y="45" width="15" height="15" rx="1"/><rect x="15" y="45" width="15" height="15" rx="1"/>
        <rect x="30" y="45" width="15" height="15" rx="1"/><rect x="45" y="45" width="15" height="15" rx="1"/>
        <rect x="60" y="45" width="15" height="15" rx="1"/><rect x="75" y="45" width="15" height="15" rx="1"/>
        <rect x="90" y="45" width="15" height="15" rx="1"/><rect x="105" y="45" width="15" height="15" rx="1"/>
        <rect x="120" y="45" width="15" height="15" rx="1"/><rect x="135" y="45" width="15" height="15" rx="1"/>
      </g>
      <g stroke="#D1D5DB" stroke-width="0.8" fill="none">
        <line x1="0" y1="0" x2="150" y2="0"/><line x1="0" y1="15" x2="150" y2="15"/>
        <line x1="0" y1="30" x2="150" y2="30"/><line x1="0" y1="45" x2="150" y2="45"/>
        <line x1="0" y1="60" x2="150" y2="60"/><line x1="0" y1="75" x2="150" y2="75"/>
        <line x1="0" y1="90" x2="150" y2="90"/><line x1="0" y1="105" x2="150" y2="105"/>
        <line x1="0" y1="120" x2="150" y2="120"/><line x1="0" y1="135" x2="150" y2="135"/>
        <line x1="0" y1="150" x2="150" y2="150"/>
        <line x1="0" y1="0" x2="0" y2="150"/><line x1="15" y1="0" x2="15" y2="150"/>
        <line x1="30" y1="0" x2="30" y2="150"/><line x1="45" y1="0" x2="45" y2="150"/>
        <line x1="60" y1="0" x2="60" y2="150"/><line x1="75" y1="0" x2="75" y2="150"/>
        <line x1="90" y1="0" x2="90" y2="150"/><line x1="105" y1="0" x2="105" y2="150"/>
        <line x1="120" y1="0" x2="120" y2="150"/><line x1="135" y1="0" x2="135" y2="150"/>
        <line x1="150" y1="0" x2="150" y2="150"/>
      </g>
      <rect x="0" y="0" width="150" height="150" rx="2" fill="none" stroke="#10B981" stroke-width="2"/>
    </g>
  </g>

  <!-- 等值箭頭連接 -->
  <!-- 1/2 → 2/4 -->
  <line x1="200" y1="150" x2="210" y2="150" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrowOrange)"/>
  <!-- 2/4 → 4/8 -->
  <line x1="390" y1="150" x2="400" y2="150" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrowOrange)"/>

  <!-- 底部等值結論 -->
  <g transform="translate(300, 365)">
    <rect x="-175" y="-18" width="350" height="36" rx="18" fill="#FFFFFF" filter="url(#shadowLight)"/>
    <rect x="-175" y="-18" width="350" height="36" rx="18" fill="none" stroke="#F59E0B" stroke-width="1.5"/>
    <text x="0" y="6" text-anchor="middle" fill="#1F2937" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold">
      結論：1/2 = 2/4 = 4/8（全部都是50格，所以相等！）
    </text>
  </g>
</svg>