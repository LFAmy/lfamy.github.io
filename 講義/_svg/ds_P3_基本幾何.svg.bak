<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#F97316"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    
    <!-- 箭頭定義 -->
    <marker id="arrow1" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrow2" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrow3" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
    <marker id="arrow4" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#3B82F6"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="12" fill="#F8FAFC"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei" font-size="22" font-weight="bold" fill="#1E293B">基本平面圖形特徵</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>

  <!-- ==================== 三角形 ==================== -->
  <g filter="url(#shadow)">
    <rect x="25" y="65" width="260" height="145" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
  </g>
  <text x="155" y="92" text-anchor="middle" font-family="Microsoft YaHei" font-size="16" font-weight="bold" fill="#4F46E5">三角形</text>
  
  <!-- 三角形圖形 -->
  <polygon points="155,105 115,160 195,160" fill="url(#grad1)" opacity="0.85" stroke="#4F46E5" stroke-width="2"/>
  
  <!-- 邊標記 -->
  <text x="128" y="178" font-family="Microsoft YaHei" font-size="11" fill="#4F46E5">3條邊</text>
  <!-- 角標記 -->
  <text x="155" y="195" text-anchor="middle" font-family="Microsoft YaHei" font-size="11" fill="#4F46E5">3個角</text>
  
  <!-- 箭頭標記邊 -->
  <line x1="115" y1="160" x2="195" y2="160" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrow1)" stroke-dasharray="4,3"/>
  <line x1="155" y1="105" x2="115" y2="160" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrow1)" stroke-dasharray="4,3"/>

  <!-- ==================== 正方形 ==================== -->
  <g filter="url(#shadow)">
    <rect x="315" y="65" width="260" height="145" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
  </g>
  <text x="445" y="92" text-anchor="middle" font-family="Microsoft YaHei" font-size="16" font-weight="bold" fill="#F59E0B">正方形</text>
  
  <!-- 正方形圖形 -->
  <rect x="395" y="105" width="55" height="55" fill="url(#grad2)" opacity="0.85" stroke="#F59E0B" stroke-width="2"/>
  
  <!-- 邊標記 -->
  <text x="410" y="178" font-family="Microsoft YaHei" font-size="11" fill="#F59E0B">4條等邊</text>
  <!-- 直角標記 -->
  <text x="440" y="195" text-anchor="middle" font-family="Microsoft YaHei" font-size="11" fill="#F59E0B">4個直角</text>
  
  <!-- 直角符號 -->
  <polyline points="395,105 405,105 405,115" fill="none" stroke="#F59E0B" stroke-width="1.5"/>
  <polyline points="450,105 450,115 440,115" fill="none" stroke="#F59E0B" stroke-width="1.5"/>
  <polyline points="395,160 405,160 405,150" fill="none" stroke="#F59E0B" stroke-width="1.5"/>
  <polyline points="450,160 450,150 440,150" fill="none" stroke="#F59E0B" stroke-width="1.5"/>

  <!-- ==================== 長方形 ==================== -->
  <g filter="url(#shadow)">
    <rect x="25" y="225" width="260" height="145" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
  </g>
  <text x="155" y="252" text-anchor="middle" font-family="Microsoft YaHei" font-size="16" font-weight="bold" fill="#10B981">長方形</text>
  
  <!-- 長方形圖形 -->
  <rect x="105" y="268" width="100" height="55" fill="url(#grad3)" opacity="0.85" stroke="#10B981" stroke-width="2"/>
  
  <!-- 邊標記 -->
  <text x="120" y="340" font-family="Microsoft YaHei" font-size="11" fill="#10B981">對邊相等</text>
  <text x="155" y="357" text-anchor="middle" font-family="Microsoft YaHei" font-size="11" fill="#10B981">4個直角</text>
  
  <!-- 箭頭標記對邊 -->
  <line x1="105" y1="268" x2="205" y2="268" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrow3)" stroke-dasharray="4,3"/>
  <line x1="105" y1="323" x2="205" y2="323" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrow3)" stroke-dasharray="4,3"/>
  
  <!-- 直角符號 -->
  <polyline points="105,268 115,268 115,278" fill="none" stroke="#10B981" stroke-width="1.5"/>

  <!-- ==================== 圓形 ==================== -->
  <g filter="url(#shadow)">
    <rect x="315" y="225" width="260" height="145" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
  </g>
  <text x="445" y="252" text-anchor="middle" font-family="Microsoft YaHei" font-size="16" font-weight="bold" fill="#3B82F6">圓形</text>
  
  <!-- 圓形圖形 -->
  <circle cx="445" cy="295" r="32" fill="url(#grad4)" opacity="0.85" stroke="#3B82F6" stroke-width="2"/>
  
  <!-- 特徵標記 -->
  <text x="445" y="340" text-anchor="middle" font-family="Microsoft YaHei" font-size="11" fill="#3B82F6">沒有角</text>
  <text x="445" y="357" text-anchor="middle" font-family="Microsoft YaHei" font-size="11" fill="#3B82F6">1條曲線邊</text>
  
  <!-- 半徑標記 -->
  <line x1="445" y1="295" x2="477" y2="295" stroke="#3B82F6" stroke-width="1.5" marker-end="url(#arrow4)" stroke-dasharray="4,3"/>
  <text x="456" y="290" font-family="Microsoft YaHei" font-size="10" fill="#3B82F6">半徑</text>

  <!-- 底部裝飾線 -->
  <rect x="0" y="390" width="600" height="10" rx="5" fill="url(#grad1)" opacity="0.3"/>
</svg>