<svg viewBox="0 0 300 180" width="300" height="180" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <rect x="30" y="30" width="240" height="130" fill="#E0F2FE" stroke="#1E40AF" stroke-width="2.5" rx="2"/>
  <rect x="30" y="60" width="240" height="100" fill="#93C5FD" opacity="0.5"/>
  <text x="150" y="15" text-anchor="middle" font-size="11" fill="#1E40AF" font-weight="bold">長方體容器</text>
  <text x="150" y="80" text-anchor="middle" font-size="10" fill="#1E3A5F">水</text>
  <text x="55" y="50" font-size="8" fill="#64748B">底面積</text>
  <line x1="40" y1="55" x2="80" y2="55" stroke="#64748B" stroke-width="0.5" stroke-dasharray="3,2"/>
  <text x="90" y="53" font-size="8" fill="#64748B">50 cm²</text>
  <line x1="30" y1="60" x2="15" y2="60" stroke="#EF4444" stroke-width="1" marker-end="none"/>
  <text x="10" y="65" font-size="8" fill="#EF4444">原水高 8cm</text>
  <line x1="30" y1="30" x2="15" y2="30" stroke="#059669" stroke-width="1"/>
  <text x="10" y="35" font-size="8" fill="#059669">新水高 11cm</text>
  <polygon points="150,160 270,100 270,160" fill="#94A3B8" stroke="#475569" stroke-width="1.5" opacity="0.7"/>
  <text x="210" y="145" font-size="9" fill="#475569">石頭</text>
  <line x1="270" y1="130" x2="285" y2="130" stroke="#059669" stroke-width="1"/>
  <text x="270" y="140" font-size="8" fill="#059669">上升3cm</text>
</svg>