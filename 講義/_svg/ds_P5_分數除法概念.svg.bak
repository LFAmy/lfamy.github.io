<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.1"/>
    </filter>
    <filter id="shadowCard" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1E293B" flood-opacity="0.12"/>
    </filter>

    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowRed" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#EF4444"/>
    </marker>

    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366F1"/>
      <stop offset="100%" stop-color="#4F46E5"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F87171"/>
      <stop offset="100%" stop-color="#EF4444"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="#F9FAFB"/>

  <!-- 標題區域 -->
  <rect x="0" y="0" width="600" height="60" rx="16" fill="url(#gradBlue)" filter="url(#shadow)"/>
  <rect x="0" y="30" width="600" height="30" fill="url(#gradBlue)"/>
  <text x="300" y="40" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#FFFFFF">📐 分數除法概念 — 1 ÷ 1/3 = 3</text>

  <!-- 主卡片 -->
  <rect x="30" y="80" width="540" height="290" rx="14" fill="url(#gradBg)" filter="url(#shadowCard)" stroke="#E5E7EB" stroke-width="1"/>

  <!-- 數線區域 -->
  <g transform="translate(50, 140)">
    <!-- 數線主軸 -->
    <line x1="0" y1="30" x2="500" y2="30" stroke="#4F46E5" stroke-width="3" stroke-linecap="round" marker-end="url(#arrowBlue)"/>

    <!-- 0 刻度 -->
    <line x1="0" y1="20" x2="0" y2="40" stroke="#4F46E5" stroke-width="2.5"/>
    <text x="0" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#4F46E5">0</text>

    <!-- 1/3 刻度 -->
    <line x1="166.7" y1="20" x2="166.7" y2="40" stroke="#F59E0B" stroke-width="2.5"/>
    <text x="166.7" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">1/3</text>

    <!-- 2/3 刻度 -->
    <line x1="333.3" y1="20" x2="333.3" y2="40" stroke="#F59E0B" stroke-width="2.5"/>
    <text x="333.3" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">2/3</text>

    <!-- 1 刻度 -->
    <line x1="500" y1="20" x2="500" y2="40" stroke="#4F46E5" stroke-width="2.5"/>
    <text x="500" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#4F46E5">1</text>

    <!-- 1/3 區段標示 - 第1段 -->
    <rect x="2" y="10" width="163" height="8" rx="4" fill="#F59E0B" opacity="0.4"/>
    <text x="83" y="-5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#F59E0B" font-weight="bold">1 個 1/3</text>

    <!-- 1/3 區段標示 - 第2段 -->
    <rect x="169" y="10" width="163" height="8" rx="4" fill="#10B981" opacity="0.4"/>
    <text x="250" y="-5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">2 個 1/3</text>

    <!-- 1/3 區段標示 - 第3段 -->
    <rect x="336" y="10" width="163" height="8" rx="4" fill="#EF4444" opacity="0.4"/>
    <text x="417" y="-5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#EF4444" font-weight="bold">3 個 1/3</text>

    <!-- 大括號 -->
    <path d="M10,70 Q5,70 5,75 Q5,80 10,80" stroke="#4F46E5" stroke-width="2" fill="none"/>
    <path d="M490,70 Q495,70 495,75 Q495,80 490,80" stroke="#4F46E5" stroke-width="2" fill="none"/>
    <line x1="10" y1="75" x2="490" y2="75" stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="250" y="95" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#4F46E5">1 裡面有 3 個 1/3</text>
  </g>

  <!-- 答案標示 -->
  <g transform="translate(50, 260)">
    <rect x="0" y="0" width="540" height="80" rx="10" fill="#EEF2FF" filter="url(#shadowLight)" stroke="#C7D2FE" stroke-width="1.5"/>
    <text x="270" y="30" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#4F46E5">1 ÷ 1/3 = 3</text>
    <text x="270" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#6B7280">因為 1 可以被分成 3 個 1/3</text>
  </g>

  <!-- 裝飾元素 -->
  <circle cx="45" cy="95" r="6" fill="#4F46E5" opacity="0.15"/>
  <circle cx="555" cy="95" r="6" fill="#4F46E5" opacity="0.15"/>
  <circle cx="45" cy="355" r="6" fill="#4F46E5" opacity="0.15"/>
  <circle cx="555" cy="355" r="6" fill="#4F46E5" opacity="0.15"/>

  <!-- 底部標籤 -->
  <text x="300" y="385" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#9CA3AF">P5 數學 · 分數除法概念 · 數線模型</text>
</svg>