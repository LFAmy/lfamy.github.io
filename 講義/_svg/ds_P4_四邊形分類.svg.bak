<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-opacity="0.15" flood-color="#333"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-opacity="0.10" flood-color="#555"/>
    </filter>

    <!-- 漸變色 -->
    <linearGradient id="gradMain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#6366F1;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FBBF24;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradSuccess" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#34D399;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#A78BFA;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradPink" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EC4899;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F472B6;stop-opacity:1"/>
    </linearGradient>

    <!-- 箭頭標記 -->
    <marker id="arrowDown" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#9CA3AF"/>
    </marker>
    <marker id="arrowDownBlue" markerWidth="10" markerHeight="8" refX="5" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#4F46E5"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="12" fill="#F9FAFB"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">四邊形家族樹</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>

  <!-- ===== 第一層：正方形 ===== -->
  <rect x="225" y="62" width="150" height="42" rx="21" fill="url(#gradMain)" filter="url(#shadow)"/>
  <text x="300" y="89" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" font-weight="bold" fill="#FFFFFF">正方形</text>

  <!-- 箭頭：正方形 → 長方形 -->
  <line x1="300" y1="104" x2="300" y2="130" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrowDownBlue)"/>

  <!-- ===== 第二層：長方形 ===== -->
  <rect x="225" y="135" width="150" height="42" rx="21" fill="url(#gradAccent)" filter="url(#shadow)"/>
  <text x="300" y="162" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" font-weight="bold" fill="#FFFFFF">長方形</text>

  <!-- 箭頭：長方形 → 菱形 -->
  <line x1="300" y1="177" x2="300" y2="203" stroke="#9CA3AF" stroke-width="2" marker-end="url(#arrowDown)"/>

  <!-- ===== 第三層：菱形 ===== -->
  <rect x="225" y="208" width="150" height="42" rx="21" fill="url(#gradSuccess)" filter="url(#shadow)"/>
  <text x="300" y="235" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" font-weight="bold" fill="#FFFFFF">菱形</text>

  <!-- 箭頭：菱形 → 平行四邊形 -->
  <line x1="300" y1="250" x2="300" y2="276" stroke="#9CA3AF" stroke-width="2" marker-end="url(#arrowDown)"/>

  <!-- ===== 第四層：平行四邊形 ===== -->
  <rect x="225" y="281" width="150" height="42" rx="21" fill="url(#gradPurple)" filter="url(#shadow)"/>
  <text x="300" y="308" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" font-weight="bold" fill="#FFFFFF">平行四邊形</text>

  <!-- 箭頭：平行四邊形 → 梯形 -->
  <line x1="300" y1="323" x2="300" y2="349" stroke="#9CA3AF" stroke-width="2" marker-end="url(#arrowDown)"/>

  <!-- ===== 第五層：梯形 ===== -->
  <rect x="225" y="354" width="150" height="42" rx="21" fill="url(#gradPink)" filter="url(#shadow)"/>
  <text x="300" y="381" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" font-weight="bold" fill="#FFFFFF">梯形</text>

  <!-- ===== 右側說明框 ===== -->
  <rect x="420" y="62" width="160" height="334" rx="10" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.5" filter="url(#shadowLight)"/>
  <text x="500" y="88" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">▸ 關係說明</text>
  <line x1="435" y1="98" x2="565" y2="98" stroke="#E5E7EB" stroke-width="1"/>

  <circle cx="442" cy="118" r="5" fill="#4F46E5"/>
  <text x="455" y="123" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">四邊相等 + 直角</text>

  <circle cx="442" cy="148" r="5" fill="#F59E0B"/>
  <text x="455" y="153" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">對邊相等 + 直角</text>

  <circle cx="442" cy="178" r="5" fill="#10B981"/>
  <text x="455" y="183" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">四邊相等</text>

  <circle cx="442" cy="208" r="5" fill="#8B5CF6"/>
  <text x="455" y="213" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">對邊平行且相等</text>

  <circle cx="442" cy="238" r="5" fill="#EC4899"/>
  <text x="455" y="243" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">只有一組對邊平行</text>

  <!-- 箭頭圖例 -->
  <line x1="440" y1="268" x2="470" y2="268" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrowDownBlue)"/>
  <text x="478" y="273" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">繼承關係</text>

  <!-- 底部裝飾 -->
  <rect x="0" y="0" width="600" height="4" rx="2" fill="#4F46E5" opacity="0.8"/>
</svg>