<svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" style="font-family: 'Microsoft YaHei', SimHei, sans-serif;">
  <defs>
    <!-- 漸變色定義 -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#818CF8;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FBBF24;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="successGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#34D399;stop-opacity:1" />
    </linearGradient>
    
    <!-- 陰影濾鏡 -->
    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.1"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4F46E5"/>
    </marker>
  </defs>
  
  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB"/>
  
  <!-- 標題卡片 -->
  <rect x="20" y="20" width="560" height="60" rx="12" ry="12" fill="url(#mainGradient)" filter="url(#dropShadow)"/>
  <text x="300" y="60" text-anchor="middle" font-size="24" fill="white" font-weight="bold">分數應用題進階</text>
  
  <!-- 主圖卡片：披薩分割圖 -->
  <rect x="20" y="100" width="260" height="280" rx="12" ry="12" fill="white" filter="url(#dropShadow)"/>
  <text x="150" y="130" text-anchor="middle" font-size="16" fill="#4F46E5" font-weight="bold">披薩分割視覺化</text>
  
  <!-- 披薩圖：分成8塊，展示分數 -->
  <circle cx="150" cy="220" r="80" fill="#F59E0B" stroke="#4F46E5" stroke-width="2"/>
  <!-- 分割線和分數標籤 -->
  <line x1="150" y1="140" x2="150" y2="300" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4"/>
  <line x1="70" y1="220" x2="230" y2="220" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4"/>
  <line x1="93" y1="163" x2="207" y2="277" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4"/>
  <line x1="207" y1="163" x2="93" y2="277" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4"/>
  <!-- 分數標籤 -->
  <text x="150" y="160" text-anchor="middle" font-size="12" fill="#4F46E5">1/4</text>
  <text x="110" y="200" text-anchor="middle" font-size="12" fill="#4F46E5">1/8</text>
  <text x="190" y="200" text-anchor="middle" font-size="12" fill="#4F46E5">1/8</text>
  <text x="110" y="250" text-anchor="middle" font-size="12" fill="#4F46E5">1/8</text>
  <text x="190" y="250" text-anchor="middle" font-size="12" fill="#4F46E5">1/8</text>
  <text x="150" y="290" text-anchor="middle" font-size="12" fill="#4F46E5">1/4</text>
  
  <!-- 步驟卡片 -->
  <rect x="300" y="100" width="280" height="280" rx="12" ry="12" fill="white" filter="url(#dropShadow)"/>
  <text x="440" y="130" text-anchor="middle" font-size="16" fill="#4F46E5" font-weight="bold">分數運算步驟</text>
  
  <!-- 步驟內容 -->
  <rect x="320" y="150" width="240" height="40" rx="8" ry="8" fill="url(#accentGradient)" filter="url(#dropShadow)"/>
  <text x="440" y="175" text-anchor="middle" font-size="14" fill="white">加法：1/4 + 1/8 = 3/8</text>
  
  <rect x="320" y="200" width="240" height="40" rx="8" ry="8" fill="url(#accentGradient)" filter="url(#dropShadow)"/>
  <text x="440" y="225" text-anchor="middle" font-size="14" fill="white">減法：1/2 - 1/4 = 1/4</text>
  
  <rect x="320" y="250" width="240" height="40" rx="8" ry="8" fill="url(#successGradient)" filter="url(#dropShadow)"/>
  <text x="440" y="275" text-anchor="middle" font-size="14" fill="white">乘法：1/4 × 2/3 = 1/6</text>
  
  <rect x="320" y="300" width="240" height="40" rx="8" ry="8" fill="url(#successGradient)" filter="url(#dropShadow)"/>
  <text x="440" y="325" text-anchor="middle" font-size="14" fill="white">除法：1/2 ÷ 1/4 = 2</text>
  
  <!-- 箭頭連接標題到主圖 -->
  <line x1="300" y1="80" x2="150" y2="100" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead)"/>
  <!-- 箭頭連接標題到步驟 -->
  <line x1="300" y1="80" x2="440" y2="100" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead)"/>
</svg>