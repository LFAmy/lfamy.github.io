<svg viewBox="0 0 260 200" width="260" height="200" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <rect x="80" y="30" width="80" height="150" fill="#E0F2FE" stroke="#1E40AF" stroke-width="2" rx="3"/>
  <text x="120" y="20" text-anchor="middle" font-size="9" fill="#1E40AF" font-weight="bold">量杯</text>
  <text x="120" y="42" text-anchor="middle" font-size="7" fill="#64748B">底面積 20cm²</text>
  <rect x="82" y="120" width="76" height="58" fill="#93C5FD" opacity="0.5"/>
  <circle cx="120" cy="145" r="12" fill="#6366F1" stroke="#4338CA" stroke-width="1" opacity="0.8"/>
  <text x="120" y="148" text-anchor="middle" font-size="7" fill="white">波子</text>
  <line x1="80" y1="120" x2="60" y2="120" stroke="#EF4444" stroke-width="1"/>
  <text x="55" y="125" font-size="8" fill="#EF4444">原水位 15cm</text>
  <line x1="80" y1="105" x2="60" y2="105" stroke="#059669" stroke-width="1"/>
  <text x="55" y="100" font-size="8" fill="#059669">新水位 16cm</text>
  <text x="120" y="190" text-anchor="middle" font-size="8" fill="#1E3A5F">體積 = 20×(16-15) = 20cm³</text>
</svg>