<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C73E6"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" rx="16" fill="#F9FAFB"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#1F2937">圓形圖扇形 — 角度計算</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" opacity="0.5"/>

  <!-- ========== 左側：圓形圖 ========== -->
  <g transform="translate(160, 220)">
    <!-- 外圈陰影 -->
    <circle cx="0" cy="0" r="108" fill="none" stroke="#E5E7EB" stroke-width="2" filter="url(#shadowLight)"/>
    
    <!-- 50% 扇形（180°）- 橙色，從 -90° 到 90° -->
    <path d="M0,0 L0,-100 A100,100 0 0,1 0,100 Z" fill="url(#grad2)" filter="url(#shadowLight)" opacity="0.95"/>
    
    <!-- 25% 扇形（90°）- 綠色，從 90° 到 180° -->
    <path d="M0,0 L0,100 A100,100 0 0,1 100,0 Z" fill="url(#grad3)" filter="url(#shadowLight)" opacity="0.95"/>
    
    <!-- 25% 扇形（90°）- 藍色，從 180° 到 270° -->
    <path d="M0,0 L100,0 A100,100 0 0,1 0,-100 Z" fill="url(#grad1)" filter="url(#shadowLight)" opacity="0.95"/>
    
    <!-- 圓形圖邊框 -->
    <circle cx="0" cy="0" r="100" fill="none" stroke="#FFFFFF" stroke-width="2.5"/>
    
    <!-- 中心點 -->
    <circle cx="0" cy="0" r="5" fill="#1F2937"/>
    
    <!-- 分割線 -->
    <line x1="0" y1="0" x2="0" y2="-100" stroke="#FFFFFF" stroke-width="2"/>
    <line x1="0" y1="0" x2="0" y2="100" stroke="#FFFFFF" stroke-width="2"/>
    <line x1="0" y1="0" x2="100" y2="0" stroke="#FFFFFF" stroke-width="2"/>
    
    <!-- 扇形標籤 - 50% -->
    <text x="-45" y="-10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">50%</text>
    <text x="-45" y="10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#FFFFFF">180°</text>
    
    <!-- 扇形標籤 - 25%（綠色） -->
    <text x="45" y="55" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">25%</text>
    <text x="45" y="75" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#FFFFFF">90°</text>
    
    <!-- 扇形標籤 - 25%（藍色） -->
    <text x="55" y="-10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">25%</text>
    <text x="55" y="10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#FFFFFF">90°</text>
  </g>

  <!-- ========== 右側：角度計算說明 ========== -->
  <g transform="translate(380, 100)">
    <!-- 計算卡片背景 -->
    <rect x="0" y="0" width="200" height="270" rx="12" fill="#FFFFFF" filter="url(#shadow)" stroke="#E5E7EB" stroke-width="1"/>
    
    <!-- 標題 -->
    <text x="100" y="28" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#374151">扇形角度計算</text>
    <line x1="20" y1="36" x2="180" y2="36" stroke="#E5E7EB" stroke-width="1"/>
    
    <!-- 公式 -->
    <text x="20" y="62" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">公式：</text>
    <text x="20" y="82" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#1F2937">角度 = 360° × 百分比</text>
    
    <!-- 分隔線 -->
    <line x1="20" y1="96" x2="180" y2="96" stroke="#F3F4F6" stroke-width="1"/>
    
    <!-- 計算 1：50% -->
    <rect x="20" y="106" width="160" height="44" rx="8" fill="#FEF3C7"/>
    <text x="30" y="124" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#92400E">50% 扇形</text>
    <text x="30" y="142" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#D97706">360° × 50% = 360° × 0.5 = 180°</text>
    
    <!-- 計算 2：25% -->
    <rect x="20" y="158" width="160" height="44" rx="8" fill="#D1FAE5"/>
    <text x="30" y="176" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#065F46">25% 扇形</text>
    <text x="30" y="194" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#059669">360° × 25% = 360° × 0.25 = 90°</text>
    
    <!-- 計算 3：10% -->
    <rect x="20" y="210" width="160" height="44" rx="8" fill="#E0E7FF"/>
    <text x="30" y="228" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#3730A3">10% 扇形</text>
    <text x="30" y="246" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#4F46E5">360° × 10% = 360° × 0.1 = 36°</text>
  </g>

  <!-- ========== 箭頭指示 ========== -->
  <!-- 從圓形圖指向計算卡片的箭頭 -->
  <line x1="275" y1="200" x2="370" y2="160" stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3" marker-end="url(#arrowBlue)" opacity="0.7"/>
  
  <!-- 從圓形圖 50% 區域指向計算的箭頭 -->
  <path d="M160,165 C200,140 280,130 370,145" fill="none" stroke="#F59E0B" stroke-width="1.8" stroke-dasharray="5,3" marker-end="url(#arrowOrange)" opacity="0.6"/>

  <!-- ========== 底部提示 ========== -->
  <g transform="translate(300, 370)">
    <rect x="-140" y="-10" width="280" height="28" rx="14" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
    <text x="0" y="8" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4338CA">💡 圓形圖總和 = 360° = 100% · 每個扇形角度 = 360° × 該扇形百分比</text>
  </g>

  <!-- 裝飾小圓點 -->
  <circle cx="30" cy="30" r="4" fill="#4F46E5" opacity="0.3"/>
  <circle cx="570" cy="30" r="4" fill="#F59E0B" opacity="0.3"/>
  <circle cx="30" cy="370" r="4" fill="#10B981" opacity="0.3"/>
  <circle cx="570" cy="370" r="4" fill="#4F46E5" opacity="0.3"/>
</svg>