<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000018"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F87171;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#EF4444;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#60A5FA;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#3B82F6;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#A78BFA;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowRed" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#EF4444"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#3B82F6"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGray" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#6B7280"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#FFFBEB" rx="12"/>
  
  <!-- 標題 -->
  <text x="300" y="32" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#1F2937">📐 分數四則混合 · 運算優先級</text>
  
  <!-- 優先級流程圖背景 -->
  <rect x="30" y="48" width="540" height="90" rx="10" fill="#FEF3C7" filter="url(#shadowLight)" opacity="0.6"/>
  
  <!-- 優先級流程圖 -->
  <!-- 步驟1：括號 -->
  <rect x="55" y="60" width="120" height="36" rx="18" fill="url(#gradRed)" filter="url(#shadow)"/>
  <text x="115" y="83" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">① 括號 ( )</text>
  
  <!-- 箭頭 1→2 -->
  <line x1="175" y1="78" x2="215" y2="78" stroke="#EF4444" stroke-width="2.5" marker-end="url(#arrowRed)"/>
  
  <!-- 步驟2：乘除 -->
  <rect x="220" y="60" width="140" height="36" rx="18" fill="url(#gradBlue)" filter="url(#shadow)"/>
  <text x="290" y="83" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">② × ÷ 乘除</text>
  
  <!-- 箭頭 2→3 -->
  <line x1="360" y1="78" x2="400" y2="78" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrowBlue)"/>
  
  <!-- 步驟3：加減 -->
  <rect x="405" y="60" width="140" height="36" rx="18" fill="url(#gradGreen)" filter="url(#shadow)"/>
  <text x="475" y="83" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">③ + − 加減</text>
  
  <!-- 優先級說明小字 -->
  <text x="300" y="122" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">⬅ 由左至右，先算括號內，再算乘除，最後算加減</text>

  <!-- 分隔線 -->
  <line x1="30" y1="145" x2="570" y2="145" stroke="#FDE68A" stroke-width="1.5" stroke-dasharray="6,4"/>

  <!-- 例題標題 -->
  <text x="40" y="172" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#1F2937">例題：</text>
  
  <!-- 例題算式 -->
  <text x="100" y="172" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#1F2937">
    <tspan fill="#EF4444">(</tspan>
    <tspan fill="#3B82F6">1/2</tspan>
    <tspan fill="#EF4444"> + </tspan>
    <tspan fill="#10B981">1/4</tspan>
    <tspan fill="#EF4444">)</tspan>
    <tspan fill="#F59E0B"> × </tspan>
    <tspan fill="#8B5CF6">2/3</tspan>
  </text>

  <!-- 逐步計算區域 -->
  
  <!-- 步驟1：先算括號內 -->
  <rect x="40" y="195" width="520" height="55" rx="8" fill="#FEF2F2" filter="url(#shadowLight)" stroke="#FECACA" stroke-width="1"/>
  
  <text x="55" y="218" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#EF4444">步驟①：先算括號內</text>
  
  <!-- 括號內計算過程 -->
  <text x="55" y="240" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#374151">
    <tspan fill="#3B82F6">1/2</tspan>
    <tspan fill="#374151"> + </tspan>
    <tspan fill="#10B981">1/4</tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#3B82F6">2/4</tspan>
    <tspan fill="#374151"> + </tspan>
    <tspan fill="#10B981">1/4</tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#EF4444" font-weight="bold">3/4</tspan>
  </text>
  
  <!-- 箭頭從步驟1到步驟2 -->
  <line x1="300" y1="250" x2="300" y2="262" stroke="#EF4444" stroke-width="2" marker-end="url(#arrowRed)"/>

  <!-- 步驟2：再算乘法 -->
  <rect x="40" y="265" width="520" height="55" rx="8" fill="#EFF6FF" filter="url(#shadowLight)" stroke="#BFDBFE" stroke-width="1"/>
  
  <text x="55" y="288" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#3B82F6">步驟②：再算乘法</text>
  
  <!-- 乘法計算過程 -->
  <text x="55" y="310" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#374151">
    <tspan fill="#EF4444" font-weight="bold">3/4</tspan>
    <tspan fill="#374151"> × </tspan>
    <tspan fill="#8B5CF6">2/3</tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#374151"> (3×2) / (4×3) </tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#F59E0B" font-weight="bold">6/12</tspan>
  </text>
  
  <!-- 箭頭從步驟2到步驟3 -->
  <line x1="300" y1="320" x2="300" y2="332" stroke="#3B82F6" stroke-width="2" marker-end="url(#arrowBlue)"/>

  <!-- 步驟3：約簡 -->
  <rect x="40" y="335" width="520" height="50" rx="8" fill="#ECFDF5" filter="url(#shadowLight)" stroke="#A7F3D0" stroke-width="1"/>
  
  <text x="55" y="358" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">步驟③：約簡答案</text>
  
  <!-- 約簡過程 -->
  <text x="55" y="376" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#374151">
    <tspan fill="#F59E0B" font-weight="bold">6/12</tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#374151"> (6÷6) / (12÷6) </tspan>
    <tspan fill="#374151"> = </tspan>
    <tspan fill="#10B981" font-weight="bold" font-size="18">1/2</tspan>
  </text>

  <!-- 答案框 -->
  <rect x="430" y="340" width="115" height="38" rx="19" fill="url(#gradOrange)" filter="url(#shadow)"/>
  <text x="487" y="365" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">答案：1/2 ✓</text>

</svg>