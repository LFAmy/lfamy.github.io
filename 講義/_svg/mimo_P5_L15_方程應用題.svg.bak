<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <!-- 阴影滤镜 -->
    <filter id="dropShadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.15" flood-color="#4F46E5"/>
    </filter>
    <!-- 箭头标记 -->
    <marker id="arrowhead" viewBox="0 0 10 7" refX="10" refY="3.5" markerWidth="10" markerHeight="7" orient="auto-start-reverse">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4F46E5"/>
    </marker>
    <!-- 渐变色 -->
    <linearGradient id="gradTitle" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5"/>
      <stop offset="100%" style="stop-color:#7C3AED"/>
    </linearGradient>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:0.05"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:0.05"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#7C3AED;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:0.05"/>
    </linearGradient>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:0.05"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="100%" height="100%" fill="#F9FAFB"/>

  <!-- 主标题卡片 -->
  <rect x="20" y="15" width="560" height="70" rx="15" fill="url(#gradTitle)" filter="url(#dropShadow)"/>
  <text x="300" y="58" text-anchor="middle" fill="white" font-size="28" font-weight="bold">方程應用題解題步驟</text>

  <!-- 连接箭头 (水平) -->
  <line x1="225" y1="240" x2="275" y2="240" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead)" opacity="0.6"/>
  <line x1="395" y1="240" x2="445" y2="240" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead)" opacity="0.6"/>
  <line x1="565" y1="240" x2="615" y2="240" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead)" opacity="0.6"/>

  <!-- 步骤卡片1: 设未知数 -->
  <rect x="20" y="110" width="140" height="260" rx="12" fill="white" stroke="#4F46E5" stroke-width="1.5" filter="url(#dropShadow)"/>
  <rect x="20" y="110" width="140" height="40" rx="12" fill="url(#grad1)"/>
  <rect x="20" y="138" width="140" height="2" fill="url(#grad1)"/>
  <circle cx="90" cy="130" r="14" fill="#4F46E5"/>
  <text x="90" y="135" text-anchor="middle" fill="white" font-size="16" font-weight="bold">1</text>
  <text x="90" y="175" text-anchor="middle" fill="#4F46E5" font-size="18" font-weight="bold">設未知數</text>
  <text x="90" y="205" text-anchor="middle" fill="#374151" font-size="13">用字母代表</text>
  <text x="90" y="225" text-anchor="middle" fill="#374151" font-size="13">題目中的未知量</text>
  <text x="90" y="245" text-anchor="middle" fill="#374151" font-size="13">例如：設蘋果數量為 x 個</text>

  <!-- 步骤卡片2: 列方程 -->
  <rect x="190" y="110" width="140" height="260" rx="12" fill="white" stroke="#F59E0B" stroke-width="1.5" filter="url(#dropShadow)"/>
  <rect x="190" y="110" width="140" height="40" rx="12" fill="url(#grad2)"/>
  <rect x="190" y="138" width="140" height="2" fill="url(#grad2)"/>
  <circle cx="260" cy="130" r="14" fill="#F59E0B"/>
  <text x="260" y="135" text-anchor="middle" fill="white" font-size="16" font-weight="bold">2</text>
  <text x="260" y="175" text-anchor="middle" fill="#F59E0B" font-size="18" font-weight="bold">列方程</text>
  <text x="260" y="205" text-anchor="middle" fill="#374151" font-size="13">根據題目意思</text>
  <text x="260" y="225" text-anchor="middle" fill="#374151" font-size="13">找出數量關係</text>
  <text x="260" y="245" text-anchor="middle" fill="#374151" font-size="13">列出等式</text>

  <!-- 步骤卡片3: 解方程 -->
  <rect x="360" y="110" width="140" height="260" rx="12" fill="white" stroke="#7C3AED" stroke-width="1.5" filter="url(#dropShadow)"/>
  <rect x="360" y="110" width="140" height="40" rx="12" fill="url(#grad3)"/>
  <rect x="360" y="138" width="140" height="2" fill="url(#grad3)"/>
  <circle cx="430" cy="130" r="14" fill="#7C3AED"/>
  <text x="430" y="135" text-anchor="middle" fill="white" font-size="16" font-weight="bold">3</text>
  <text x="430" y="175" text-anchor="middle" fill="#7C3AED" font-size="18" font-weight="bold">解方程</text>
  <text x="430" y="205" text-anchor="middle" fill="#374151" font-size="13">通過計算</text>
  <text x="430" y="225" text-anchor="middle" fill="#374151" font-size="13">求出未知數的值</text>
  <text x="430" y="245" text-anchor="middle" fill="#374151" font-size="13">例如：x = 5</text>

  <!-- 步骤卡片4: 验算 -->
  <rect x="530" y="110" width="50" height="260" rx="12" fill="white" stroke="#10B981" stroke-width="1.5" filter="url(#dropShadow)"/>
  <rect x="530" y="110" width="50" height="40" rx="12" fill="url(#grad4)"/>
  <rect x="530" y="138" width="50" height="2" fill="url(#grad4)"/>
  <circle cx="555" cy="130" r="14" fill="#10B981"/>
  <text x="555" y="135" text-anchor="middle" fill="white" font-size="16" font-weight="bold">4</text>
  <text x="555" y="185" text-anchor="middle" fill="#10B981" font-size="18" font-weight="bold">驗</text>
  <text x="555" y="205" text-anchor="middle" fill="#10B981" font-size="18" font-weight="bold">算</text>
  <text x="555" y="235" text-anchor="middle" fill="#374151" font-size="12">將結果</text>
  <text x="555" y="255" text-anchor="middle" fill="#374151" font-size="12">代回原題</text>
  <text x="555" y="275" text-anchor="middle" fill="#374151" font-size="12">檢查是否</text>
  <text x="555" y="295" text-anchor="middle" fill="#374151" font-size="12">符合題意</text>

  <!-- 底部提示 -->
  <text x="300" y="395" text-anchor="middle" fill="#6B7280" font-size="12">提示：解題時要細心，特別注意驗算步驟，確保答案正確！</text>
</svg>