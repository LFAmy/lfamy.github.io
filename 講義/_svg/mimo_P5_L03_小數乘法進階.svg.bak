<svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <!-- 渐变定义 -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FBBF24;stop-opacity:1" />
    </linearGradient>
    <!-- 阴影滤镜 -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-opacity="0.3" />
    </filter>
    <!-- 箭头标记 -->
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4F46E5" />
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" />

  <!-- 标题卡片 -->
  <rect x="20" y="20" width="560" height="50" rx="10" ry="10" fill="url(#mainGradient)" filter="url(#shadow)" />
  <text x="300" y="52" text-anchor="middle" font-size="20" fill="#FFFFFF" font-weight="bold">小數乘法進階：定位規則可視化</text>

  <!-- 面積模型主圖卡片 -->
  <rect x="20" y="80" width="340" height="220" rx="10" ry="10" fill="#FFFFFF" filter="url(#shadow)" />
  <!-- 面積模型標題 -->
  <text x="190" y="110" text-anchor="middle" font-size="16" fill="#4F46E5" font-weight="bold">面積模型：0.3 × 0.4</text>
  <!-- 網格背景 -->
  <rect x="70" y="130" width="200" height="140" fill="#E5E7EB" />
  <!-- 分割線（10x10網格） -->
  <!-- 水平線 -->
  <line x1="70" y1="144" x2="270" y2="144" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="158" x2="270" y2="158" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="172" x2="270" y2="172" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="186" x2="270" y2="186" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="200" x2="270" y2="200" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="214" x2="270" y2="214" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="228" x2="270" y2="228" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="242" x2="270" y2="242" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="70" y1="256" x2="270" y2="256" stroke="#D1D5DB" stroke-width="0.5" />
  <!-- 垂直線 -->
  <line x1="90" y1="130" x2="90" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="110" y1="130" x2="110" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="130" y1="130" x2="130" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="150" y1="130" x2="150" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="170" y1="130" x2="170" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="190" y1="130" x2="190" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="210" y1="130" x2="210" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="230" y1="130" x2="230" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <line x1="250" y1="130" x2="250" y2="270" stroke="#D1D5DB" stroke-width="0.5" />
  <!-- 高亮交叉區域（0.3列 × 0.4行 = 12小格） -->
  <rect x="70" y="200" width="60" height="70" fill="#10B981" opacity="0.5" />
  <text x="100" y="240" text-anchor="middle" font-size="12" fill="#FFFFFF">0.12</text>
  <!-- 標籤 -->
  <text x="170" y="290" text-anchor="middle" font-size="14" fill="#4F46E5">0.3（3列）</text>
  <text x="40" y="200" text-anchor="middle" font-size="14" fill="#4F46E5" transform="rotate(-90, 40, 200)">0.4（4行）</text>

  <!-- 步驟卡片 -->
  <rect x="380" y="80" width="200" height="220" rx="10" ry="10" fill="#FFFFFF" filter="url(#shadow)" />
  <!-- 步驟標題 -->
  <text x="480" y="110" text-anchor="middle" font-size="16" fill="#4F46E5" font-weight="bold">計算步驟</text>
  <!-- 步驟內容 -->
  <text x="400" y="140" font-size="14" fill="#374151">1. 忽略小數點相乘：</text>
  <text x="400" y="160" font-size="14" fill="#F59E0B" font-weight="bold">3 × 4 = 12</text>
  <text x="400" y="190" font-size="14" fill="#374151">2. 數小數位數：</text>
  <text x="400" y="210" font-size="14" fill="#F59E0B" font-weight="bold">0.3（1位） + 0.4（1位） = 2位</text>
  <text x="400" y="240" font-size="14" fill="#374151">3. 定位小數點：</text>
  <text x="400" y="260" font-size="14" fill="#10B981" font-weight="bold">12 → 0.12</text>

  <!-- 重點框 -->
  <rect x="20" y="310" width="560" height="70" rx="10" ry="10" fill="#FFFFFF" filter="url(#shadow)" />
  <text x="300" y="340" text-anchor="middle" font-size="16" fill="#4F46E5" font-weight="bold">重點提醒</text>
  <text x="300" y="365" text-anchor="middle" font-size="14" fill="#374151">小數乘法定位：乘積的小數位數等於兩個因數的小數位數之和！</text>

  <!-- 箭頭示例（用於數線概念，但此處為裝飾） -->
  <line x1="100" y1="300" x2="150" y2="300" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrow)" />
</svg>