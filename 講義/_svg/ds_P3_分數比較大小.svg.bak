<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-2%" y="-2%" width="104%" height="108%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-2%" y="-2%" width="104%" height="108%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000018"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradRed" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#EF4444"/>
      <stop offset="100%" stop-color="#F87171"/>
    </linearGradient>
    <linearGradient id="gradBlue" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#818CF8"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F9FAFB"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowRight" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#6B7280"/>
    </marker>
    <marker id="arrowLeft" markerWidth="10" markerHeight="8" refX="1" refY="4" orient="auto">
      <path d="M10,0 L0,4 L10,8 Z" fill="#6B7280"/>
    </marker>
    <marker id="arrowDown" markerWidth="8" markerHeight="10" refX="4" refY="9" orient="auto">
      <path d="M0,0 L4,10 L8,0 Z" fill="#4F46E5"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="url(#gradBg)"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">
    📐 分數比較大小 — 同分母分數
  </text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2" opacity="0.4"/>

  <!-- 第一條：1/5（紅色） -->
  <g filter="url(#shadowLight)">
    <!-- 完整長條背景 -->
    <rect x="60" y="80" width="480" height="36" rx="6" fill="#E5E7EB"/>
    <!-- 填充部分 -->
    <rect x="60" y="80" width="96" height="36" rx="6" fill="url(#gradRed)" filter="url(#shadow)"/>
    <!-- 分隔線（五等分） -->
    <line x1="156" y1="80" x2="156" y2="116" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="252" y1="80" x2="252" y2="116" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="348" y1="80" x2="348" y2="116" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="444" y1="80" x2="444" y2="116" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
  </g>
  <!-- 標籤 -->
  <text x="60" y="140" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#EF4444">
    1/5
  </text>
  <text x="110" y="140" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">
    (1份)
  </text>

  <!-- 第二條：2/5（藍色） -->
  <g filter="url(#shadowLight)">
    <rect x="60" y="165" width="480" height="36" rx="6" fill="#E5E7EB"/>
    <rect x="60" y="165" width="192" height="36" rx="6" fill="url(#gradBlue)" filter="url(#shadow)"/>
    <line x1="156" y1="165" x2="156" y2="201" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="252" y1="165" x2="252" y2="201" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="348" y1="165" x2="348" y2="201" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="444" y1="165" x2="444" y2="201" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
  </g>
  <text x="60" y="225" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#4F46E5">
    2/5
  </text>
  <text x="110" y="225" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">
    (2份)
  </text>

  <!-- 第三條：4/5（綠色） -->
  <g filter="url(#shadowLight)">
    <rect x="60" y="250" width="480" height="36" rx="6" fill="#E5E7EB"/>
    <rect x="60" y="250" width="384" height="36" rx="6" fill="url(#gradGreen)" filter="url(#shadow)"/>
    <line x1="156" y1="250" x2="156" y2="286" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="252" y1="250" x2="252" y2="286" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="348" y1="250" x2="348" y2="286" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
    <line x1="444" y1="250" x2="444" y2="286" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>
  </g>
  <text x="60" y="310" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#10B981">
    4/5
  </text>
  <text x="110" y="310" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">
    (4份)
  </text>

  <!-- 比較箭頭與標示 -->
  <!-- 從1/5到2/5 -->
  <line x1="156" y1="130" x2="252" y2="155" stroke="#6B7280" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowRight)"/>
  <text x="195" y="148" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#6B7280">小</text>

  <!-- 從2/5到4/5 -->
  <line x1="252" y1="215" x2="384" y2="240" stroke="#6B7280" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowRight)"/>
  <text x="310" y="233" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#6B7280">小</text>

  <!-- 從1/5到4/5（大箭頭） -->
  <line x1="96" y1="118" x2="420" y2="252" stroke="#F59E0B" stroke-width="2" stroke-dasharray="6,4" marker-end="url(#arrowRight)" opacity="0.7"/>
  <text x="240" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">
    1/5 &lt; 2/5 &lt; 4/5
  </text>

  <!-- 結論框 -->
  <rect x="140" y="335" width="320" height="44" rx="10" fill="#FFFFFF" stroke="#4F46E5" stroke-width="1.5" filter="url(#shadowLight)"/>
  <text x="300" y="358" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">
    ✨ 分母相同時，分子越大，分數越大！
  </text>

  <!-- 裝飾小圓點 -->
  <circle cx="30" cy="30" r="6" fill="#4F46E5" opacity="0.15"/>
  <circle cx="570" cy="30" r="6" fill="#F59E0B" opacity="0.15"/>
  <circle cx="30" cy="370" r="6" fill="#10B981" opacity="0.15"/>
  <circle cx="570" cy="370" r="6" fill="#EF4444" opacity="0.15"/>
</svg>