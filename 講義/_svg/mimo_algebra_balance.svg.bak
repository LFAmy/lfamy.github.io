<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <!-- 定义渐变和滤镜 -->
  <defs>
    <linearGradient id="gradScale" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#E5E7EB"/>
      <stop offset="100%" style="stop-color:#D1D5DB"/>
    </linearGradient>
    <linearGradient id="gradLeft" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#818CF8"/>
      <stop offset="100%" style="stop-color:#4F46E5"/>
    </linearGradient>
    <linearGradient id="gradRight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FCD34D"/>
      <stop offset="100%" style="stop-color:#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradSuccess" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#6EE7B7"/>
      <stop offset="100%" style="stop-color:#10B981"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-opacity="0.3"/>
    </filter>
    <filter id="textShadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="1" dy="1" stdDeviation="1" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" fill="#F9FAFB" rx="20"/>

  <!-- 标题 -->
  <text x="300" y="40" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="24" font-weight="bold" fill="#1F2937" filter="url(#textShadow)">天秤解方程原理</text>

  <!-- 天秤支点 -->
  <rect x="275" y="130" width="50" height="10" fill="url(#gradScale)" rx="5" filter="url(#shadow)"/>
  
  <!-- 天秤横杆 -->
  <rect x="125" y="135" width="350" height="8" fill="url(#gradScale)" rx="4" filter="url(#shadow)"/>
  
  <!-- 左侧吊绳和托盘 -->
  <line x1="175" y1="143" x2="175" y2="200" stroke="#6B7280" stroke-width="3"/>
  <rect x="125" y="200" width="100" height="20" fill="url(#gradScale)" rx="5" filter="url(#shadow)"/>
  
  <!-- 右侧吊绳和托盘 -->
  <line x1="425" y1="143" x2="425" y2="200" stroke="#6B7280" stroke-width="3"/>
  <rect x="375" y="200" width="100" height="20" fill="url(#gradScale)" rx="5" filter="url(#shadow)"/>
  
  <!-- 左侧3个x+2方块 -->
  <g transform="translate(135, 210)">
    <!-- 第一个方块 -->
    <rect x="0" y="0" width="80" height="40" fill="url(#gradLeft)" rx="8" filter="url(#shadow)"/>
    <text x="40" y="25" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">x+2</text>
    
    <!-- 第二个方块 -->
    <rect x="0" y="45" width="80" height="40" fill="url(#gradLeft)" rx="8" filter="url(#shadow)"/>
    <text x="40" y="70" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">x+2</text>
    
    <!-- 第三个方块 -->
    <rect x="0" y="90" width="80" height="40" fill="url(#gradLeft)" rx="8" filter="url(#shadow)"/>
    <text x="40" y="115" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">x+2</text>
  </g>
  
  <!-- 右侧11方块 -->
  <g transform="translate(385, 210)">
    <rect x="0" y="0" width="80" height="40" fill="url(#gradRight)" rx="8" filter="url(#shadow)"/>
    <text x="40" y="25" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">11</text>
  </g>
  
  <!-- 天秤平衡提示 -->
  <text x="300" y="170" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#4B5563">平衡状态</text>
  
  <!-- 解方程步骤背景 -->
  <rect x="150" y="290" width="300" height="90" fill="#EFF6FF" rx="15" filter="url(#shadow)" stroke="#BFDBFE" stroke-width="1"/>
  
  <!-- 解方程步骤 -->
  <text x="300" y="315" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#1E40AF">解方程步骤</text>
  
  <!-- 步骤1 -->
  <g transform="translate(160, 325)">
    <circle cx="10" cy="0" r="8" fill="url(#gradLeft)"/>
    <text x="25" y="5" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#374151">3x+2=11</text>
  </g>
  
  <!-- 步骤2 -->
  <g transform="translate(160, 345)">
    <circle cx="10" cy="0" r="8" fill="url(#gradSuccess)"/>
    <text x="25" y="5" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#374151">3x=9</text>
  </g>
  
  <!-- 步骤3 -->
  <g transform="translate(160, 365)">
    <circle cx="10" cy="0" r="8" fill="url(#gradSuccess)"/>
    <text x="25" y="5" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#059669">x=3</text>
  </g>
  
  <!-- 左侧箭头指示 -->
  <line x1="220" y1="280" x2="170" y2="295" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="190" y="285" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4F46E5">左侧表达式</text>
  
  <!-- 右侧箭头指示 -->
  <line x1="380" y1="280" x2="430" y2="295" stroke="#F59E0B" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="390" y="285" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#F59E0B">右侧数值</text>
  
  <!-- 底部装饰 -->
  <rect x="200" y="385" width="200" height="8" fill="url(#gradScale)" rx="4" opacity="0.5"/>
</svg>