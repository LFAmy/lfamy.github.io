<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" font-family="Microsoft YaHei, sans-serif">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <!-- 箭頭 -->
    <marker id="arrow1" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrow2" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrow3" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- 標題 -->
  <text x="300" y="42" text-anchor="middle" font-size="22" font-weight="bold" fill="#1E293B">小數運算三步曲</text>
  <text x="300" y="62" text-anchor="middle" font-size="13" fill="#64748B">加減乘除定位規則流程圖</text>
  <line x1="180" y1="72" x2="420" y2="72" stroke="#CBD5E1" stroke-width="1"/>

  <!-- ========== 第一步：對齊小數點 ========== -->
  <rect x="40" y="95" width="160" height="70" rx="12" fill="url(#grad1)" filter="url(#shadow)"/>
  <text x="120" y="122" text-anchor="middle" font-size="14" font-weight="bold" fill="#FFFFFF">第一步</text>
  <text x="120" y="145" text-anchor="middle" font-size="15" font-weight="bold" fill="#FFFFFF">對齊小數點</text>

  <!-- 範例：對齊小數點 -->
  <rect x="45" y="172" width="150" height="50" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1" filter="url(#shadowLight)"/>
  <text x="120" y="192" text-anchor="middle" font-size="13" fill="#4338CA" font-weight="bold">12.3</text>
  <text x="120" y="210" text-anchor="middle" font-size="13" fill="#4338CA" font-weight="bold">+ 4.56</text>
  <line x1="65" y1="215" x2="175" y2="215" stroke="#4338CA" stroke-width="1" stroke-dasharray="3,2"/>

  <!-- 箭頭 1→2 -->
  <line x1="200" y1="130" x2="240" y2="130" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrow1)"/>

  <!-- ========== 第二步：計算 ========== -->
  <rect x="250" y="95" width="160" height="70" rx="12" fill="url(#grad2)" filter="url(#shadow)"/>
  <text x="330" y="122" text-anchor="middle" font-size="14" font-weight="bold" fill="#FFFFFF">第二步</text>
  <text x="330" y="145" text-anchor="middle" font-size="15" font-weight="bold" fill="#FFFFFF">計算</text>

  <!-- 範例：計算 -->
  <rect x="255" y="172" width="150" height="50" rx="8" fill="#FFFBEB" stroke="#FDE68A" stroke-width="1" filter="url(#shadowLight)"/>
  <text x="330" y="192" text-anchor="middle" font-size="13" fill="#B45309" font-weight="bold">12.3</text>
  <text x="330" y="210" text-anchor="middle" font-size="13" fill="#B45309" font-weight="bold">+ 4.56</text>
  <line x1="275" y1="215" x2="385" y2="215" stroke="#B45309" stroke-width="1" stroke-dasharray="3,2"/>
  <text x="330" y="228" text-anchor="middle" font-size="11" fill="#D97706">先當作整數計算</text>

  <!-- 箭頭 2→3 -->
  <line x1="410" y1="130" x2="450" y2="130" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrow2)"/>

  <!-- ========== 第三步：點小數點 ========== -->
  <rect x="460" y="95" width="120" height="70" rx="12" fill="url(#grad3)" filter="url(#shadow)"/>
  <text x="520" y="122" text-anchor="middle" font-size="14" font-weight="bold" fill="#FFFFFF">第三步</text>
  <text x="520" y="145" text-anchor="middle" font-size="15" font-weight="bold" fill="#FFFFFF">點小數點</text>

  <!-- 範例：點小數點 -->
  <rect x="455" y="172" width="130" height="50" rx="8" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="1" filter="url(#shadowLight)"/>
  <text x="520" y="192" text-anchor="middle" font-size="13" fill="#047857" font-weight="bold">1686</text>
  <text x="520" y="210" text-anchor="middle" font-size="13" fill="#047857" font-weight="bold">→ 16.86</text>
  <line x1="475" y1="215" x2="565" y2="215" stroke="#047857" stroke-width="1" stroke-dasharray="3,2"/>

  <!-- ========== 運算規則區域 ========== -->
  <rect x="40" y="255" width="520" height="125" rx="12" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" filter="url(#shadowLight)"/>

  <text x="60" y="280" font-size="14" font-weight="bold" fill="#334155">運算規則</text>

  <!-- 加法 -->
  <rect x="55" y="290" width="110" height="36" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <text x="110" y="312" text-anchor="middle" font-size="13" fill="#4338CA" font-weight="bold">加法</text>
  <text x="170" y="312" font-size="12" fill="#475569">小數點對齊，末位對齊</text>

  <!-- 減法 -->
  <rect x="55" y="332" width="110" height="36" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <text x="110" y="354" text-anchor="middle" font-size="13" fill="#4338CA" font-weight="bold">減法</text>
  <text x="170" y="354" font-size="12" fill="#475569">小數點對齊，末位對齊</text>

  <!-- 乘法 -->
  <rect x="340" y="290" width="110" height="36" rx="8" fill="#FFFBEB" stroke="#FDE68A" stroke-width="1"/>
  <text x="395" y="312" text-anchor="middle" font-size="13" fill="#B45309" font-weight="bold">乘法</text>
  <text x="455" y="312" font-size="12" fill="#475569">末位對齊，按整數乘</text>

  <!-- 除法 -->
  <rect x="340" y="332" width="110" height="36" rx="8" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="1"/>
  <text x="395" y="354" text-anchor="middle" font-size="13" fill="#047857" font-weight="bold">除法</text>
  <text x="455" y="354" font-size="12" fill="#475569">除數變整數，商不變</text>

  <!-- 底部提示 -->
  <text x="300" y="388" text-anchor="middle" font-size="11" fill="#94A3B8">口訣：小數點對齊，計算不心急，點對位置就 OK！</text>
</svg>