<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    <filter id="shadowCard" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1E3A8A20"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradMain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366F1"/>
      <stop offset="100%" stop-color="#4F46E5"/>
    </linearGradient>
    <linearGradient id="gradAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradSuccess" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F9FAFB"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    
    <!-- 糖果圖案 -->
    <g id="candy">
      <ellipse cx="0" cy="0" rx="10" ry="7" fill="#EF4444"/>
      <ellipse cx="0" cy="0" rx="10" ry="7" fill="url(#gradAccent)" opacity="0.7"/>
      <path d="M-8,-4 Q-4,-6 0,-4 Q4,-2 8,-4" stroke="#fff" stroke-width="1.5" fill="none" opacity="0.6"/>
      <path d="M-8,4 Q-4,2 0,4 Q4,6 8,4" stroke="#fff" stroke-width="1.5" fill="none" opacity="0.6"/>
    </g>
  </defs>
  
  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#gradBg)" rx="12"/>
  
  <!-- 標題區域 -->
  <rect x="0" y="0" width="600" height="56" fill="url(#gradMain)" rx="12"/>
  <rect x="0" y="28" width="600" height="28" fill="url(#gradMain)"/>
  <text x="300" y="36" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#fff" filter="url(#shadowLight)">🍬 除法概念：分物模型</text>
  
  <!-- 問題陳述 -->
  <rect x="30" y="72" width="540" height="40" rx="20" fill="#fff" filter="url(#shadowLight)"/>
  <text x="300" y="98" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="17" fill="#374151" font-weight="bold">12 顆糖平均分給 3 人，每人得到幾顆？</text>
  
  <!-- ===== 左側：分物前（12顆糖） ===== -->
  <rect x="30" y="130" width="255" height="250" rx="14" fill="#fff" filter="url(#shadowCard)"/>
  <rect x="30" y="130" width="255" height="36" rx="14" fill="#4F46E5" opacity="0.1"/>
  <text x="157" y="154" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#4F46E5" font-weight="bold">📦 分物前：12 顆糖</text>
  
  <!-- 12顆糖排列 -->
  <use href="#candy" x="62" y="190"/>
  <use href="#candy" x="100" y="190"/>
  <use href="#candy" x="138" y="190"/>
  <use href="#candy" x="176" y="190"/>
  <use href="#candy" x="214" y="190"/>
  <use href="#candy" x="252" y="190"/>
  
  <use href="#candy" x="62" y="228"/>
  <use href="#candy" x="100" y="228"/>
  <use href="#candy" x="138" y="228"/>
  <use href="#candy" x="176" y="228"/>
  <use href="#candy" x="214" y="228"/>
  <use href="#candy" x="252" y="228"/>
  
  <!-- 糖的數字標籤 -->
  <text x="157" y="280" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">總數：12 顆</text>
  
  <!-- 總數標籤 -->
  <rect x="110" y="300" width="95" height="30" rx="15" fill="url(#gradMain)" filter="url(#shadowLight)"/>
  <text x="157" y="320" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#fff" font-weight="bold">12 ÷ 3 = ?</text>
  
  <!-- ===== 中間：箭頭 ===== -->
  <line x1="295" y1="255" x2="305" y2="255" stroke="#4F46E5" stroke-width="3" marker-end="url(#arrowBlue)"/>
  
  <!-- ===== 右側：分物後（每人4顆） ===== -->
  <rect x="315" y="130" width="255" height="250" rx="14" fill="#fff" filter="url(#shadowCard)"/>
  <rect x="315" y="130" width="255" height="36" rx="14" fill="#10B981" opacity="0.1"/>
  <text x="442" y="154" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#10B981" font-weight="bold">✅ 分物後：每人 4 顆</text>
  
  <!-- 第一人 -->
  <rect x="330" y="180" width="70" height="90" rx="10" fill="#FEF3C7" filter="url(#shadowLight)"/>
  <text x="365" y="200" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#D97706" font-weight="bold">👤 第1人</text>
  <use href="#candy" x="345" y="215"/>
  <use href="#candy" x="365" y="215"/>
  <use href="#candy" x="345" y="240"/>
  <use href="#candy" x="365" y="240"/>
  <text x="365" y="262" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">4 顆</text>
  
  <!-- 第二人 -->
  <rect x="410" y="180" width="70" height="90" rx="10" fill="#FEF3C7" filter="url(#shadowLight)"/>
  <text x="445" y="200" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#D97706" font-weight="bold">👤 第2人</text>
  <use href="#candy" x="425" y="215"/>
  <use href="#candy" x="445" y="215"/>
  <use href="#candy" x="425" y="240"/>
  <use href="#candy" x="445" y="240"/>
  <text x="445" y="262" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">4 顆</text>
  
  <!-- 第三人 -->
  <rect x="490" y="180" width="70" height="90" rx="10" fill="#FEF3C7" filter="url(#shadowLight)"/>
  <text x="525" y="200" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#D97706" font-weight="bold">👤 第3人</text>
  <use href="#candy" x="505" y="215"/>
  <use href="#candy" x="525" y="215"/>
  <use href="#candy" x="505" y="240"/>
  <use href="#candy" x="525" y="240"/>
  <text x="525" y="262" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">4 顆</text>
  
  <!-- 答案標籤 -->
  <rect x="395" y="300" width="95" height="30" rx="15" fill="url(#gradSuccess)" filter="url(#shadowLight)"/>
  <text x="442" y="320" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#fff" font-weight="bold">12 ÷ 3 = 4</text>
  
  <!-- 底部提示 -->
  <rect x="150" y="360" width="300" height="28" rx="14" fill="#EEF2FF" filter="url(#shadowLight)"/>
  <text x="300" y="379" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#4F46E5">💡 除法就是「平均分」— 總數 ÷ 人數 = 每人數量</text>
</svg>