<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.1"/>
    </filter>
    <filter id="shadowCard" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#1E293B" flood-opacity="0.08"/>
    </filter>

    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowRed" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#EF4444"/>
    </marker>

    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F87171;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#EF4444;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F9FAFB;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F3F4F6;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" fill="url(#gradBg)" rx="12"/>

  <!-- 標題區域 -->
  <rect x="0" y="0" width="600" height="52" fill="url(#gradBlue)" rx="12"/>
  <rect x="0" y="26" width="600" height="26" fill="url(#gradBlue)"/>
  <text x="300" y="34" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#FFFFFF">速率公式：路程 = 速率 × 時間</text>

  <!-- 三角形關係圖 - 卡片背景 -->
  <rect x="30" y="70" width="340" height="200" rx="14" fill="#FFFFFF" filter="url(#shadowCard)"/>

  <!-- 三角形 - 路程=速率×時間 -->
  <!-- 三角形外框 -->
  <polygon points="200,90 110,230 290,230" fill="none" stroke="#E5E7EB" stroke-width="2" stroke-dasharray="6,3"/>

  <!-- 三角形上部分區塊 - 路程 (頂部) -->
  <polygon points="200,90 155,160 245,160" fill="#EEF2FF" stroke="#4F46E5" stroke-width="2.5" rx="4"/>
  <text x="200" y="138" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#4F46E5">路程</text>
  <text x="200" y="156" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6366F1">S</text>

  <!-- 三角形左下區塊 - 速率 -->
  <polygon points="110,230 155,160 200,230" fill="#FFF7ED" stroke="#F59E0B" stroke-width="2.5"/>
  <text x="148" y="208" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#F59E0B">速率</text>
  <text x="148" y="224" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#D97706">v</text>

  <!-- 三角形右下區塊 - 時間 -->
  <polygon points="200,230 245,160 290,230" fill="#ECFDF5" stroke="#10B981" stroke-width="2.5"/>
  <text x="252" y="208" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#10B981">時間</text>
  <text x="252" y="224" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#059669">t</text>

  <!-- 乘號和等號 -->
  <text x="200" y="196" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#9CA3AF">×</text>
  <text x="200" y="250" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#9CA3AF">=</text>

  <!-- 公式說明文字 -->
  <text x="200" y="270" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">S = v × t</text>

  <!-- 例題區域 -->
  <rect x="390" y="70" width="185" height="200" rx="14" fill="#FFFFFF" filter="url(#shadowCard)"/>

  <text x="482" y="98" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#1F2937">例題</text>

  <!-- 分隔線 -->
  <line x1="405" y1="108" x2="560" y2="108" stroke="#E5E7EB" stroke-width="1.5"/>

  <!-- 題目 -->
  <text x="400" y="132" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">小明以</text>
  <text x="446" y="132" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">60 km/h</text>
  <text x="400" y="152" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">行駛</text>
  <text x="434" y="152" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">2.5 小時</text>
  <text x="400" y="172" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">路程是多少？</text>

  <!-- 解題步驟 -->
  <rect x="400" y="185" width="165" height="75" rx="8" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>

  <text x="410" y="203" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" font-weight="bold" fill="#4F46E5">解：</text>
  <text x="410" y="219" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">路程 = 速率 × 時間</text>
  <text x="410" y="237" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#374151">= 60 × 2.5</text>
  <text x="410" y="255" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#EF4444">= 150 km</text>

  <!-- 箭頭指示 - 從三角形到例題 -->
  <line x1="340" y1="150" x2="385" y2="130" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowBlue)" stroke-dasharray="4,3"/>

  <!-- 底部提示 -->
  <rect x="30" y="290" width="545" height="90" rx="12" fill="#FFFFFF" filter="url(#shadowCard)"/>

  <!-- 提示1 -->
  <rect x="45" y="302" width="160" height="65" rx="8" fill="#EEF2FF"/>
  <text x="125" y="324" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#4F46E5">📌 求路程</text>
  <text x="125" y="344" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4B5563">速率 × 時間</text>
  <text x="125" y="360" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#9CA3AF">S = v × t</text>

  <!-- 提示2 -->
  <rect x="220" y="302" width="160" height="65" rx="8" fill="#FFF7ED"/>
  <text x="300" y="324" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#F59E0B">📌 求速率</text>
  <text x="300" y="344" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4B5563">路程 ÷ 時間</text>
  <text x="300" y="360" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#9CA3AF">v = S ÷ t</text>

  <!-- 提示3 -->
  <rect x="395" y="302" width="165" height="65" rx="8" fill="#ECFDF5"/>
  <text x="477" y="324" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#10B981">📌 求時間</text>
  <text x="477" y="344" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4B5563">路程 ÷ 速率</text>
  <text x="477" y="360" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#9CA3AF">t = S ÷ v</text>

  <!-- 裝飾圓點 -->
  <circle cx="20" cy="20" r="4" fill="#4F46E5" opacity="0.3"/>
  <circle cx="580" cy="20" r="4" fill="#F59E0B" opacity="0.3"/>
  <circle cx="20" cy="380" r="4" fill="#10B981" opacity="0.3"/>
  <circle cx="580" cy="380" r="4" fill="#EF4444" opacity="0.3"/>
</svg>