<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradMain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F97316;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradCard" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:0.95"/>
      <stop offset="100%" style="stop-color:#F3F4F6;stop-opacity:0.95"/>
    </linearGradient>
    
    <!-- 箭頭定義 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="#F0F4FF"/>
  
  <!-- 頂部裝飾條 -->
  <rect x="0" y="0" width="600" height="8" fill="url(#gradMain)" rx="4"/>

  <!-- 標題區 -->
  <rect x="20" y="18" width="560" height="48" rx="12" fill="url(#gradPurple)" filter="url(#shadow)" opacity="0.95"/>
  <text x="300" y="50" text-anchor="middle" fill="#FFFFFF" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="bold">除法進階 — 有餘數除法</text>

  <!-- 算式卡片 -->
  <rect x="30" y="78" width="540" height="56" rx="10" fill="url(#gradCard)" filter="url(#shadowLight)" stroke="#E5E7EB" stroke-width="1"/>
  
  <!-- 算式文字 -->
  <text x="60" y="114" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="26" font-weight="bold">25 ÷ 4 = 6 餘 1</text>
  
  <!-- 算式解釋 -->
  <text x="280" y="114" fill="#6B7280" font-family="Microsoft YaHei, sans-serif" font-size="15">（25個物品，每組4個，可分6組，剩下1個）</text>

  <!-- 分組模型區 -->
  <rect x="30" y="146" width="540" height="240" rx="12" fill="url(#gradCard)" filter="url(#shadowLight)" stroke="#E5E7EB" stroke-width="1"/>
  
  <text x="50" y="178" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="16" font-weight="bold">● 分組模型</text>

  <!-- 第1組 -->
  <rect x="50" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="85" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="85" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="85" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="85" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組1</text>

  <!-- 第2組 -->
  <rect x="135" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="170" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="170" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="170" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="170" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組2</text>

  <!-- 第3組 -->
  <rect x="220" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="255" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="255" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="255" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="255" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組3</text>

  <!-- 第4組 -->
  <rect x="305" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="340" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="340" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="340" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="340" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組4</text>

  <!-- 第5組 -->
  <rect x="390" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="425" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="425" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="425" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="425" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組5</text>

  <!-- 第6組 -->
  <rect x="475" y="192" width="70" height="70" rx="8" fill="#4F46E5" opacity="0.12"/>
  <text x="510" y="222" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="510" y="240" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">●</text>
  <text x="510" y="258" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="13">● ●</text>
  <text x="510" y="280" text-anchor="middle" fill="#4F46E5" font-family="Microsoft YaHei, sans-serif" font-size="11">組6</text>

  <!-- 餘數區域 -->
  <rect x="50" y="296" width="495" height="56" rx="10" fill="#F59E0B" opacity="0.15" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="6,3"/>
  <text x="60" y="330" fill="#F59E0B" font-family="Microsoft YaHei, sans-serif" font-size="14" font-weight="bold">餘數：</text>
  
  <!-- 餘數圓點 -->
  <circle cx="120" cy="326" r="8" fill="#F59E0B" opacity="0.8"/>
  <circle cx="150" cy="326" r="8" fill="#F59E0B" opacity="0.8"/>
  <circle cx="180" cy="326" r="8" fill="#F59E0B" opacity="0.8"/>
  <circle cx="210" cy="326" r="8" fill="#F59E0B" opacity="0.8"/>
  
  <!-- 餘數標記 -->
  <text x="240" y="330" fill="#F59E0B" font-family="Microsoft YaHei, sans-serif" font-size="13">（1個餘數）</text>

  <!-- 箭頭標示：從餘數到算式 -->
  <line x1="260" y1="326" x2="330" y2="114" stroke="#F59E0B" stroke-width="2" stroke-dasharray="5,3" marker-end="url(#arrowOrange)" opacity="0.7"/>

  <!-- 底部說明 -->
  <rect x="30" y="360" width="540" height="30" rx="8" fill="#10B981" opacity="0.1"/>
  <text x="300" y="380" text-anchor="middle" fill="#059669" font-family="Microsoft YaHei, sans-serif" font-size="13">💡 6組 × 4個 + 1個餘數 = 25個 ✓</text>

</svg>