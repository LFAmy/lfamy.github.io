<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C73E6"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradBlueLight" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#EEF2FF"/>
      <stop offset="100%" stop-color="#E0E7FF"/>
    </linearGradient>
    <linearGradient id="gradOrangeLight" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0 L10,5 L0,10 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0 L10,5 L0,10 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0 L10,5 L0,10 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowGray" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 Z" fill="#9CA3AF"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" fill="#F9FAFB" rx="8"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">周界 vs 面積</text>
  <text x="300" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">P4 數學 · 周界是邊框長度，面積是內部大小</text>

  <!-- ============================================ -->
  <!-- 左側：長方形 -->
  <!-- ============================================ -->
  
  <!-- 長方形內部填色（面積） -->
  <rect x="55" y="95" width="200" height="130" rx="4" fill="url(#gradBlueLight)" filter="url(#shadowLight)"/>
  
  <!-- 長方形邊框（周界） -->
  <rect x="55" y="95" width="200" height="130" rx="4" fill="none" stroke="url(#gradBlue)" stroke-width="4" stroke-linejoin="round" filter="url(#shadow)"/>
  
  <!-- 長度標註箭頭（上邊） -->
  <line x1="55" y1="82" x2="255" y2="82" stroke="#4F46E5" stroke-width="2" marker-start="url(#arrowBlue)" marker-end="url(#arrowBlue)"/>
  <text x="155" y="76" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">長度 8 cm</text>
  
  <!-- 寬度標註箭頭（右邊） -->
  <line x1="268" y1="95" x2="268" y2="225" stroke="#F59E0B" stroke-width="2" marker-start="url(#arrowOrange)" marker-end="url(#arrowOrange)"/>
  <text x="280" y="165" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">寬度 5 cm</text>

  <!-- 面積標示 -->
  <text x="155" y="168" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#4F46E5">面積</text>
  <text x="155" y="188" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#4F46E5">= 8 × 5</text>
  <text x="155" y="206" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#4F46E5">= 40 cm²</text>

  <!-- ============================================ -->
  <!-- 右側：正方形 -->
  <!-- ============================================ -->
  
  <!-- 正方形內部填色（面積） -->
  <rect x="345" y="95" width="130" height="130" rx="4" fill="url(#gradOrangeLight)" filter="url(#shadowLight)"/>
  
  <!-- 正方形邊框（周界） -->
  <rect x="345" y="95" width="130" height="130" rx="4" fill="none" stroke="url(#gradOrange)" stroke-width="4" stroke-linejoin="round" filter="url(#shadow)"/>
  
  <!-- 邊長標註箭頭（上邊） -->
  <line x1="345" y1="82" x2="475" y2="82" stroke="#F59E0B" stroke-width="2" marker-start="url(#arrowOrange)" marker-end="url(#arrowOrange)"/>
  <text x="410" y="76" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">邊長 6 cm</text>
  
  <!-- 邊長標註箭頭（右邊） -->
  <line x1="488" y1="95" x2="488" y2="225" stroke="#F59E0B" stroke-width="2" marker-start="url(#arrowOrange)" marker-end="url(#arrowOrange)"/>
  <text x="500" y="165" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">6 cm</text>

  <!-- 面積標示 -->
  <text x="410" y="168" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#F59E0B">面積</text>
  <text x="410" y="188" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#F59E0B">= 6 × 6</text>
  <text x="410" y="206" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#F59E0B">= 36 cm²</text>

  <!-- ============================================ -->
  <!-- 底部：周界計算區 -->
  <!-- ============================================ -->
  
  <rect x="55" y="255" width="490" height="125" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1.5" filter="url(#shadowLight)"/>
  
  <!-- 周界計算 - 長方形 -->
  <text x="130" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">長方形周界</text>
  <text x="130" y="307" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4F46E5">= (8+5) × 2</text>
  <text x="130" y="327" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4F46E5">= 26 cm</text>
  
  <!-- 分隔線 -->
  <line x1="230" y1="265" x2="230" y2="370" stroke="#E5E7EB" stroke-width="1.5"/>
  
  <!-- 周界計算 - 正方形 -->
  <text x="320" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">正方形周界</text>
  <text x="320" y="307" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#F59E0B">= 6 × 4</text>
  <text x="320" y="327" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#F59E0B">= 24 cm</text>
  
  <!-- 分隔線 -->
  <line x1="410" y1="265" x2="410" y2="370" stroke="#E5E7EB" stroke-width="1.5"/>
  
  <!-- 關鍵對比提示 -->
  <text x="500" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">💡 重點</text>
  <text x="500" y="308" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">周界：邊框總長度</text>
  <text x="500" y="328" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">面積：內部空間大小</text>
  <text x="500" y="348" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">單位：cm vs cm²</text>

  <!-- 圖示：周界小圖標（左下） -->
  <rect x="65" y="262" width="12" height="12" rx="2" fill="none" stroke="#4F46E5" stroke-width="2"/>
  
  <!-- 圖示：面積小圖標（右下） -->
  <rect x="65" y="280" width="12" height="12" rx="2" fill="#4F46E5" opacity="0.4"/>
  
  <text x="82" y="273" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#4F46E5">= 邊框</text>
  <text x="82" y="291" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#4F46E5">= 內部</text>
</svg>