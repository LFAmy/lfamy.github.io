<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 背景漸變 -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F9FAFB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#EEF2FF;stop-opacity:1" />
    </linearGradient>
    
    <!-- 主色漸變 -->
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:1" />
    </linearGradient>
    
    <!-- 強調色漸變 -->
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1" />
    </linearGradient>
    
    <!-- 成功色漸變 -->
    <linearGradient id="successGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1" />
    </linearGradient>
    
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.10"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#4F46E5"/>
    </marker>
    
    <marker id="arrowOrange" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#F59E0B"/>
    </marker>
    
    <marker id="arrowGreen" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#10B981"/>
    </marker>
    
    <marker id="arrowGray" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <path d="M0,0 L10,3.5 L0,7 L2.5,3.5 Z" fill="#94A3B8"/>
    </marker>
  </defs>
  
  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#bgGrad)" rx="12"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B">加法進位流程圖</text>
  <text x="300" y="58" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#64748B">P3 數學 · 個位 → 十位 → 百位 → 千位</text>
  
  <!-- 分隔線 -->
  <line x1="50" y1="68" x2="550" y2="68" stroke="#E2E8F0" stroke-width="1.5"/>
  
  <!-- ==================== 計算題區域 ==================== -->
  
  <!-- 計算題背景 -->
  <rect x="50" y="82" width="200" height="130" rx="10" fill="white" filter="url(#shadowLight)" stroke="#E2E8F0" stroke-width="1"/>
  
  <!-- 題目文字 -->
  <text x="150" y="108" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#64748B">計算題</text>
  
  <!-- 直式計算 - 3876 + 2548 -->
  <g transform="translate(100, 118)">
    <!-- 千位 百位 十位 個位 標示 -->
    <text x="10" y="12" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">千</text>
    <text x="40" y="12" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">百</text>
    <text x="70" y="12" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">十</text>
    <text x="100" y="12" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">個</text>
    
    <!-- 橫線 -->
    <line x1="0" y1="48" x2="110" y2="48" stroke="#1E293B" stroke-width="1.5"/>
    
    <!-- 加號 -->
    <text x="-5" y="42" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#1E293B" font-weight="bold">+</text>
    
    <!-- 3876 -->
    <text x="10" y="38" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">3</text>
    <text x="40" y="38" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">8</text>
    <text x="70" y="38" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">7</text>
    <text x="100" y="38" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">6</text>
    
    <!-- 2548 -->
    <text x="10" y="62" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">2</text>
    <text x="40" y="62" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">5</text>
    <text x="70" y="62" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">4</text>
    <text x="100" y="62" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#1E293B" font-weight="bold" text-anchor="middle">8</text>
    
    <!-- 答案 6424 -->
    <text x="10" y="85" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#10B981" font-weight="bold" text-anchor="middle">6</text>
    <text x="40" y="85" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#10B981" font-weight="bold" text-anchor="middle">4</text>
    <text x="70" y="85" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#10B981" font-weight="bold" text-anchor="middle">2</text>
    <text x="100" y="85" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" fill="#10B981" font-weight="bold" text-anchor="middle">4</text>
  </g>
  
  <!-- ==================== 流程圖區域 ==================== -->
  
  <!-- 個位 (6+8=14，進1) -->
  <g filter="url(#shadow)">
    <rect x="290" y="85" width="130" height="55" rx="10" fill="url(#primaryGrad)"/>
    <text x="355" y="108" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="white" font-weight="bold">① 個位</text>
    <text x="355" y="128" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#C7D2FE">6 + 8 = 14</text>
  </g>
  
  <!-- 進位1 → 十位 -->
  <g filter="url(#shadow)">
    <rect x="290" y="155" width="130" height="55" rx="10" fill="url(#accentGrad)"/>
    <text x="355" y="178" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="white" font-weight="bold">② 十位</text>
    <text x="355" y="198" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#FEF3C7">7+4+① = 12</text>
  </g>
  
  <!-- 進位2 → 百位 -->
  <g filter="url(#shadow)">
    <rect x="290" y="225" width="130" height="55" rx="10" fill="url(#primaryGrad)"/>
    <text x="355" y="248" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="white" font-weight="bold">③ 百位</text>
    <text x="355" y="268" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#C7D2FE">8+5+② = 15</text>
  </g>
  
  <!-- 進位3 → 千位 -->
  <g filter="url(#shadow)">
    <rect x="290" y="295" width="130" height="55" rx="10" fill="url(#successGrad)"/>
    <text x="355" y="318" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="white" font-weight="bold">④ 千位</text>
    <text x="355" y="338" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#D1FAE5">3+2+③ = 6</text>
  </g>
  
  <!-- ==================== 箭頭連接 ==================== -->
  
  <!-- 個位 → 十位 (進位1) -->
  <line x1="355" y1="140" x2="355" y2="152" stroke="#F59E0B" stroke-width="3" marker-end="url(#arrowOrange)"/>
  
  <!-- 進位1 標示 -->
  <rect x="365" y="143" width="22" height="16" rx="8" fill="#F59E0B"/>
  <text x="376" y="155" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="white" font-weight="bold">進1</text>
  
  <!-- 十位 → 百位 (進位2) -->
  <line x1="355" y1="210" x2="355" y2="222" stroke="#F59E0B" stroke-width="3" marker-end="url(#arrowOrange)"/>
  
  <!-- 進位2 標示 -->
  <rect x="365" y="213" width="22" height="16" rx="8" fill="#F59E0B"/>
  <text x="376" y="225" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="white" font-weight="bold">進1</text>
  
  <!-- 百位 → 千位 (進位3) -->
  <line x1="355" y1="280" x2="355" y2="292" stroke="#F59E0B" stroke-width="3" marker-end="url(#arrowOrange)"/>
  
  <!-- 進位3 標示 -->
  <rect x="365" y="283" width="22" height="16" rx="8" fill="#F59E0B"/>
  <text x="376" y="295" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="white" font-weight="bold">進1</text>
  
  <!-- ==================== 右側進位數字標示 ==================== -->
  
  <!-- 進位數字圓圈 -->
  <g transform="translate(460, 100)">
    <circle cx="0" cy="0" r="18" fill="#F59E0B" filter="url(#shadowLight)"/>
    <text x="0" y="5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="white" font-weight="bold">1</text>
  </g>
  
  <g transform="translate(460, 170)">
    <circle cx="0" cy="0" r="18" fill="#F59E0B" filter="url(#shadowLight)"/>
    <text x="0" y="5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="white" font-weight="bold">1</text>
  </g>
  
  <g transform="translate(460, 240)">
    <circle cx="0" cy="0" r="18" fill="#F59E0B" filter="url(#shadowLight)"/>
    <text x="0" y="5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="white" font-weight="bold">1</text>
  </g>
  
  <!-- 右側說明文字 -->
  <text x="490" y="105" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#64748B">個位進位</text>
  <text x="490" y="175" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#64748B">十位進位</text>
  <text x="490" y="245" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#64748B">百位進位</text>
  
  <!-- 右側連接線 -->
  <line x1="420" y1="112" x2="440" y2="100" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowOrange)"/>
  <line x1="420" y1="182" x2="440" y2="170" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowOrange)"/>
  <line x1="420" y1="252" x2="440" y2="240" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowOrange)"/>
  
  <!-- ==================== 底部提示 ==================== -->
  <rect x="50" y="358" width="500" height="30" rx="8" fill="#EFF6FF" stroke="#DBEAFE" stroke-width="1"/>
  <text x="300" y="378" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#3B82F6">💡 提示：由個位開始計算，滿10就要進1到前一位！</text>
  
</svg>