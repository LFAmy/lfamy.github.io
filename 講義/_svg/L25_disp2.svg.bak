<svg viewBox="0 0 300 180" width="300" height="180" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <rect x="30" y="20" width="200" height="140" fill="#FEF3C7" stroke="#D97706" stroke-width="2.5" rx="2"/>
  <rect x="30" y="40" width="200" height="120" fill="#FDE68A" opacity="0.6"/>
  <text x="130" y="12" text-anchor="middle" font-size="10" fill="#D97706" font-weight="bold">容器總容量 2000 cm³</text>
  <text x="50" y="75" font-size="9" fill="#92400E">原有水</text>
  <text x="50" y="88" font-size="9" fill="#92400E">1800 cm³</text>
  <polygon points="160,160 240,40 240,160" fill="#94A3B8" stroke="#475569" stroke-width="1.5" opacity="0.7"/>
  <text x="210" y="145" font-size="9" fill="#475569">石頭</text>
  <text x="210" y="157" font-size="8" fill="#475569">500 cm³</text>
  <path d="M30,35 L230,35" stroke="#EF4444" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="235" y="38" font-size="8" fill="#EF4444">滿水位線</text>
  <text x="130" y="175" text-anchor="middle" font-size="8" fill="#EF4444">剩餘空間 = 2000-1800 = 200 cm³，石頭 500 cm³ → 溢出 300 cm³</text>
</svg>