<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.10"/>
    </filter>

    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>

    <!-- 蝴蝶漸變 -->
    <linearGradient id="butterflyGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="butterflyGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>

    <!-- 風車葉片漸變 -->
    <linearGradient id="blade1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#F97316"/>
    </linearGradient>
    <linearGradient id="blade2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
    <linearGradient id="blade3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#F97316"/>
    </linearGradient>
    <linearGradient id="blade4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>

    <!-- 旋轉箭頭弧線 -->
    <path id="arcArrow" d="M0,0 A30,30 0 0,1 30,0" fill="none"/>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="8"/>

  <!-- 標題 -->
  <text x="300" y="35" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#1E293B">軸對稱 vs 旋轉對稱</text>

  <!-- ==================== 左半：軸對稱（蝴蝶） ==================== -->
  <rect x="15" y="50" width="280" height="335" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <text x="155" y="80" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#4F46E5">軸對稱 — 蝴蝶</text>

  <!-- 蝴蝶身體（中心線） -->
  <line x1="155" y1="110" x2="155" y2="310" stroke="#1E293B" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.5"/>

  <!-- 蝴蝶左翅（上） -->
  <path d="M155,140 C130,110 80,115 75,145 C70,175 100,195 130,200 C140,202 150,195 155,185 Z"
        fill="url(#butterflyGrad1)" opacity="0.85" stroke="#4F46E5" stroke-width="1.5"/>
  <!-- 蝴蝶左翅（下） -->
  <path d="M155,200 C130,210 85,225 82,255 C79,285 110,295 135,290 C145,288 152,278 155,265 Z"
        fill="url(#butterflyGrad1)" opacity="0.7" stroke="#4F46E5" stroke-width="1.5"/>

  <!-- 蝴蝶右翅（上） -->
  <path d="M155,140 C180,110 230,115 235,145 C240,175 210,195 180,200 C170,202 160,195 155,185 Z"
        fill="url(#butterflyGrad2)" opacity="0.85" stroke="#4F46E5" stroke-width="1.5"/>
  <!-- 蝴蝶右翅（下） -->
  <path d="M155,200 C180,210 225,225 228,255 C231,285 200,295 175,290 C165,288 158,278 155,265 Z"
        fill="url(#butterflyGrad2)" opacity="0.7" stroke="#4F46E5" stroke-width="1.5"/>

  <!-- 蝴蝶身體 -->
  <ellipse cx="155" cy="200" rx="5" ry="55" fill="#1E293B" opacity="0.8"/>
  <!-- 觸角 -->
  <path d="M155,145 C145,125 130,115 125,110" fill="none" stroke="#1E293B" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M155,145 C165,125 180,115 185,110" fill="none" stroke="#1E293B" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="125" cy="110" r="2.5" fill="#1E293B"/>
  <circle cx="185" cy="110" r="2.5" fill="#1E293B"/>

  <!-- 對稱軸標示 -->
  <line x1="155" y1="100" x2="155" y2="320" stroke="#EF4444" stroke-width="2" stroke-dasharray="8,4" marker-end="url(#arrowGreen)"/>
  <text x="170" y="315" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#EF4444" font-weight="bold">對稱軸</text>

  <!-- 左右標示 -->
  <text x="100" y="340" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">左</text>
  <text x="210" y="340" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">右</text>

  <!-- 說明標籤 -->
  <rect x="30" y="350" width="250" height="28" rx="6" fill="#EEF2FF"/>
  <text x="155" y="369" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4F46E5">左右兩邊完全重疊，沿對稱軸對摺</text>

  <!-- ==================== 右半：旋轉對稱（風車） ==================== -->
  <rect x="305" y="50" width="280" height="335" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <text x="445" y="80" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#F59E0B">旋轉對稱 — 風車</text>

  <!-- 風車中心點 -->
  <circle cx="445" cy="200" r="8" fill="#1E293B" opacity="0.8"/>
  <circle cx="445" cy="200" r="4" fill="#F59E0B"/>

  <!-- 風車葉片1（右上） -->
  <path d="M445,200 L445,120 C445,120 470,130 480,155 C490,180 470,195 445,200 Z"
        fill="url(#blade1)" opacity="0.85" stroke="#D97706" stroke-width="1"/>
  <!-- 風車葉片2（右下） -->
  <path d="M445,200 L525,200 C525,200 515,225 490,235 C465,245 450,225 445,200 Z"
        fill="url(#blade2)" opacity="0.85" stroke="#059669" stroke-width="1"/>
  <!-- 風車葉片3（左下） -->
  <path d="M445,200 L445,280 C445,280 420,270 410,245 C400,220 420,205 445,200 Z"
        fill="url(#blade3)" opacity="0.85" stroke="#D97706" stroke-width="1"/>
  <!-- 風車葉片4（左上） -->
  <path d="M445,200 L365,200 C365,200 375,175 400,165 C425,155 440,175 445,200 Z"
        fill="url(#blade4)" opacity="0.85" stroke="#059669" stroke-width="1"/>

  <!-- 旋轉角度弧線 -->
  <!-- 90度弧 -->
  <path d="M455,195 A55,55 0 0,1 495,155" fill="none" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowOrange)"/>
  <text x="490" y="148" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#F59E0B" font-weight="bold">90°</text>

  <!-- 180度弧 -->
  <path d="M450,205 A60,60 0 0,1 500,240" fill="none" stroke="#10B981" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowGreen)"/>
  <text x="505" y="248" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#10B981" font-weight="bold">180°</text>

  <!-- 270度弧 -->
  <path d="M440,210 A65,65 0 0,1 390,250" fill="none" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowBlue)"/>
  <text x="375" y="260" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#4F46E5" font-weight="bold">270°</text>

  <!-- 360度弧 -->
  <path d="M435,205 A70,70 0 0,1 385,155" fill="none" stroke="#8B5CF6" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowBlue)"/>
  <text x="370" y="145" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#8B5CF6" font-weight="bold">360°</text>

  <!-- 旋轉方向箭頭 -->
  <path d="M460,185 A30,30 0 0,1 470,170" fill="none" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)"/>

  <!-- 說明標籤 -->
  <rect x="320" y="350" width="250" height="28" rx="6" fill="#FFFBEB"/>
  <text x="445" y="369" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#D97706">旋轉 90°、180°、270°、360° 後圖形不變</text>

  <!-- 底部對比標示 -->
  <rect x="130" y="388" width="340" height="1" fill="#CBD5E1" opacity="0.5"/>
</svg>