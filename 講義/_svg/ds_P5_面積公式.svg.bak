<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#6366F1;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FBBF24;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#34D399;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#A78BFA;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EF4444;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F87171;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="50%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowPurple" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#8B5CF6"/>
    </marker>
    <marker id="arrowRed" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#EF4444"/>
    </marker>
    <marker id="arrowGray" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
      <path d="M0,0 L7,2.5 L0,5 Z" fill="#6B7280"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" rx="12" fill="#F8FAFC"/>
  
  <!-- 標題欄 -->
  <rect x="0" y="0" width="600" height="48" rx="12" fill="url(#headerGrad)" opacity="0.9"/>
  <rect x="0" y="30" width="600" height="18" fill="url(#headerGrad)" opacity="0.9"/>
  <text x="300" y="32" font-family="Microsoft YaHei, sans-serif" font-size="20" font-weight="bold" fill="#FFFFFF" text-anchor="middle">📐 平面圖形面積公式一覽</text>

  <!-- ========== 正方形 (左上) ========== -->
  <g filter="url(#shadow)">
    <rect x="20" y="65" width="155" height="140" rx="10" fill="#FFFFFF" stroke="#4F46E5" stroke-width="1.5"/>
    <!-- 正方形圖形 -->
    <rect x="45" y="90" width="55" height="55" rx="2" fill="url(#grad1)" opacity="0.85"/>
    <!-- 邊長標註 a -->
    <line x1="45" y1="150" x2="100" y2="150" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
    <line x1="100" y1="150" x2="45" y2="150" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
    <text x="72" y="163" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" text-anchor="middle" font-weight="bold">a</text>
    <line x1="40" y1="90" x2="40" y2="145" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
    <line x1="40" y1="145" x2="40" y2="90" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
    <text x="25" y="120" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" text-anchor="middle" font-weight="bold" transform="rotate(-90,25,120)">a</text>
    <!-- 公式 -->
    <text x="110" y="110" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">正方形</text>
    <text x="110" y="130" font-family="Microsoft YaHei, sans-serif" font-size="15" fill="#1F2937" font-weight="bold">S = a × a</text>
    <text x="110" y="150" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">= a²</text>
  </g>

  <!-- ========== 長方形 (中上) ========== -->
  <g filter="url(#shadow)">
    <rect x="195" y="65" width="195" height="140" rx="10" fill="#FFFFFF" stroke="#F59E0B" stroke-width="1.5"/>
    <!-- 長方形圖形 -->
    <rect x="215" y="90" width="70" height="45" rx="2" fill="url(#grad2)" opacity="0.85"/>
    <!-- 邊長標註 l -->
    <line x1="215" y1="140" x2="285" y2="140" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)"/>
    <line x1="285" y1="140" x2="215" y2="140" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)"/>
    <text x="250" y="153" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#F59E0B" text-anchor="middle" font-weight="bold">l</text>
    <!-- 邊長標註 w -->
    <line x1="210" y1="90" x2="210" y2="135" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)"/>
    <line x1="210" y1="135" x2="210" y2="90" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)"/>
    <text x="196" y="115" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#F59E0B" text-anchor="middle" font-weight="bold" transform="rotate(-90,196,115)">w</text>
    <!-- 公式 -->
    <text x="295" y="108" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#F59E0B" font-weight="bold">長方形</text>
    <text x="295" y="128" font-family="Microsoft YaHei, sans-serif" font-size="15" fill="#1F2937" font-weight="bold">S = l × w</text>
  </g>

  <!-- ========== 三角形 (右上) ========== -->
  <g filter="url(#shadow)">
    <rect x="410" y="65" width="175" height="140" rx="10" fill="#FFFFFF" stroke="#10B981" stroke-width="1.5"/>
    <!-- 三角形圖形 -->
    <polygon points="460,135 530,135 495,88" fill="url(#grad3)" opacity="0.85"/>
    <!-- 底邊標註 b -->
    <line x1="460" y1="140" x2="530" y2="140" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)"/>
    <line x1="530" y1="140" x2="460" y2="140" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)"/>
    <text x="495" y="153" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" text-anchor="middle" font-weight="bold">b</text>
    <!-- 高度標註 h -->
    <line x1="495" y1="88" x2="495" y2="135" stroke="#10B981" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowGreen)"/>
    <text x="508" y="112" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">h</text>
    <!-- 直角標記 -->
    <rect x="495" y="125" width="6" height="6" fill="none" stroke="#10B981" stroke-width="1"/>
    <!-- 公式 -->
    <text x="555" y="105" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">三角形</text>
    <text x="555" y="125" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">S = ½ × b × h</text>
    <text x="555" y="145" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">= bh ÷ 2</text>
  </g>

  <!-- ========== 梯形 (左下) ========== -->
  <g filter="url(#shadow)">
    <rect x="20" y="225" width="270" height="155" rx="10" fill="#FFFFFF" stroke="#8B5CF6" stroke-width="1.5"/>
    <!-- 梯形圖形 -->
    <polygon points="55,260 175,260 155,305 75,305" fill="url(#grad4)" opacity="0.85"/>
    <!-- 上底標註 a -->
    <line x1="55" y1="255" x2="175" y2="255" stroke="#8B5CF6" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
    <line x1="175" y1="255" x2="55" y2="255" stroke="#8B5CF6" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
    <text x="115" y="248" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#8B5CF6" text-anchor="middle" font-weight="bold">a</text>
    <!-- 下底標註 b -->
    <line x1="75" y1="310" x2="155" y2="310" stroke="#8B5CF6" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
    <line x1="155" y1="310" x2="75" y2="310" stroke="#8B5CF6" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
    <text x="115" y="325" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#8B5CF6" text-anchor="middle" font-weight="bold">b</text>
    <!-- 高度標註 h -->
    <line x1="180" y1="260" x2="180" y2="305" stroke="#8B5CF6" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowPurple)"/>
    <text x="192" y="285" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#8B5CF6" font-weight="bold">h</text>
    <!-- 公式 -->
    <text x="230" y="260" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#8B5CF6" font-weight="bold">梯形</text>
    <text x="230" y="280" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">S = ½ × (a+b) × h</text>
    <text x="230" y="300" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">= (a+b)h ÷ 2</text>
  </g>

  <!-- ========== 平行四邊形 (右下) ========== -->
  <g filter="url(#shadow)">
    <rect x="310" y="225" width="275" height="155" rx="10" fill="#FFFFFF" stroke="#EF4444" stroke-width="1.5"/>
    <!-- 平行四邊形圖形 -->
    <polygon points="340,260 440,260 420,305 320,305" fill="url(#grad5)" opacity="0.85"/>
    <!-- 底邊標註 b -->
    <line x1="320" y1="310" x2="440" y2="310" stroke="#EF4444" stroke-width="1.5" marker-end="url(#arrowRed)"/>
    <line x1="440" y1="310" x2="320" y2="310" stroke="#EF4444" stroke-width="1.5" marker-end="url(#arrowRed)"/>
    <text x="380" y="325" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#EF4444" text-anchor="middle" font-weight="bold">b</text>
    <!-- 高度標註 h -->
    <line x1="445" y1="260" x2="445" y2="305" stroke="#EF4444" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#arrowRed)"/>
    <text x="458" y="285" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#EF4444" font-weight="bold">h</text>
    <!-- 垂直輔助線 -->
    <line x1="440" y1="260" x2="440" y2="305" stroke="#EF4444" stroke-width="0.8" stroke-dasharray="3,3" opacity="0.5"/>
    <!-- 公式 -->
    <text x="500" y="265" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#EF4444" font-weight="bold">平行四邊形</text>
    <text x="500" y="285" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#1F2937" font-weight="bold">S = b × h</text>
  </g>

  <!-- 底部裝飾線 -->
  <rect x="0" y="388" width="600" height="12" rx="6" fill="url(#headerGrad)" opacity="0.6"/>
</svg>