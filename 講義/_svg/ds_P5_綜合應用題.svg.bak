<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>

    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B5CF6"/>
      <stop offset="100%" stop-color="#A78BFA"/>
    </linearGradient>

    <!-- 箭頭 -->
    <marker id="arrow1" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrow2" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrow3" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#10B981"/>
    </marker>
    <marker id="arrow4" markerWidth="12" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L12,4 L0,8 L3,4 Z" fill="#8B5CF6"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="#F8FAFC"/>
  <rect x="0" y="0" width="600" height="400" rx="16" fill="none" stroke="#E2E8F0" stroke-width="2"/>

  <!-- 標題 -->
  <text x="300" y="42" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B" text-anchor="middle">📐 應用題解題四步流程</text>
  <line x1="180" y1="52" x2="420" y2="52" stroke="#4F46E5" stroke-width="3" stroke-linecap="round"/>

  <!-- ===== 步驟1：讀題 ===== -->
  <rect x="40" y="80" width="110" height="110" rx="14" fill="url(#grad1)" filter="url(#shadow)"/>
  <text x="95" y="112" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#FFFFFF" text-anchor="middle" opacity="0.8">步驟 1</text>
  <text x="95" y="140" font-family="Microsoft YaHei, sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF" text-anchor="middle">📖 讀題</text>
  <text x="95" y="165" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">理解題目意思</text>
  <text x="95" y="182" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">找出問題問什麼</text>

  <!-- 箭頭 1→2 -->
  <line x1="150" y1="135" x2="185" y2="135" stroke="#4F46E5" stroke-width="3" marker-end="url(#arrow1)"/>

  <!-- ===== 步驟2：找關鍵數字 ===== -->
  <rect x="195" y="80" width="110" height="110" rx="14" fill="url(#grad2)" filter="url(#shadow)"/>
  <text x="250" y="112" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#FFFFFF" text-anchor="middle" opacity="0.8">步驟 2</text>
  <text x="250" y="140" font-family="Microsoft YaHei, sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF" text-anchor="middle">🔍 找關鍵數字</text>
  <text x="250" y="165" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">圈出數字資料</text>
  <text x="250" y="182" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">標記單位</text>

  <!-- 箭頭 2→3 -->
  <line x1="305" y1="135" x2="340" y2="135" stroke="#F59E0B" stroke-width="3" marker-end="url(#arrow2)"/>

  <!-- ===== 步驟3：選運算 ===== -->
  <rect x="350" y="80" width="110" height="110" rx="14" fill="url(#grad3)" filter="url(#shadow)"/>
  <text x="405" y="112" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#FFFFFF" text-anchor="middle" opacity="0.8">步驟 3</text>
  <text x="405" y="140" font-family="Microsoft YaHei, sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF" text-anchor="middle">🧮 選運算</text>
  <text x="405" y="165" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">決定加減乘除</text>
  <text x="405" y="182" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">列出算式</text>

  <!-- 箭頭 3→4 -->
  <line x1="460" y1="135" x2="495" y2="135" stroke="#10B981" stroke-width="3" marker-end="url(#arrow3)"/>

  <!-- ===== 步驟4：檢查單位 ===== -->
  <rect x="505" y="80" width="90" height="110" rx="14" fill="url(#grad4)" filter="url(#shadow)"/>
  <text x="550" y="112" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#FFFFFF" text-anchor="middle" opacity="0.8">步驟 4</text>
  <text x="550" y="140" font-family="Microsoft YaHei, sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF" text-anchor="middle">✅ 檢查單位</text>
  <text x="550" y="165" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">答案加單位</text>
  <text x="550" y="182" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle" opacity="0.9">驗算答案</text>

  <!-- ===== 下方：例題區 ===== -->
  <rect x="40" y="220" width="520" height="155" rx="12" fill="#FFFFFF" filter="url(#shadowLight)" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- 例題標題 -->
  <rect x="40" y="220" width="520" height="36" rx="12" fill="#F1F5F9"/>
  <rect x="40" y="244" width="520" height="12" fill="#F1F5F9"/>
  <text x="60" y="244" font-family="Microsoft YaHei, sans-serif" font-size="15" font-weight="bold" fill="#334155">📝 例題：</text>

  <!-- 例題內容 -->
  <text x="60" y="278" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#475569">
    小明有 <tspan fill="#F59E0B" font-weight="bold">85</tspan> 元，買一本書用了 <tspan fill="#F59E0B" font-weight="bold">38</tspan> 元，
    之後媽媽給他 <tspan fill="#F59E0B" font-weight="bold">20</tspan> 元。
  </text>
  <text x="60" y="302" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#475569">
    問：小明現在有多少元？
  </text>

  <!-- 解題流程提示 -->
  <line x1="60" y1="316" x2="540" y2="316" stroke="#E2E8F0" stroke-width="1"/>

  <text x="80" y="340" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#4F46E5" font-weight="bold">① 讀題：</text>
  <text x="140" y="340" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#64748B">小明有錢 → 用掉 → 再得到錢 → 求現在有多少</text>

  <text x="80" y="360" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#F59E0B" font-weight="bold">② 找數字：</text>
  <text x="140" y="360" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#64748B">關鍵數字：85、38、20（單位：元）</text>

  <!-- 步驟3-4 在同一行 -->
  <text x="300" y="340" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">③ 選運算：</text>
  <text x="360" y="340" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#64748B">85 − 38 + 20</text>

  <text x="300" y="360" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#8B5CF6" font-weight="bold">④ 檢查單位：</text>
  <text x="360" y="360" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#64748B">答案 = 67（元）✓</text>

  <!-- 底部裝飾 -->
  <rect x="240" y="388" width="120" height="3" rx="1.5" fill="#CBD5E1"/>
</svg>