<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F9FAFB;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F3F4F6;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#gradBg)" rx="16"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">🧮 減法借位 — 三層階梯圖</text>
  <text x="300" y="60" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280">不夠減時，從高位借1當10</text>

  <!-- ==================== 第一層：題目 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="60" y="80" width="480" height="70" rx="12" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/>
  </g>
  <text x="300" y="105" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">① 題目</text>

  <!-- 直式減法：52 - 27 -->
  <g transform="translate(230, 112)">
    <!-- 十位和個位分隔線 -->
    <line x1="45" y1="38" x2="85" y2="38" stroke="#374151" stroke-width="1.5"/>
    <line x1="65" y1="0" x2="65" y2="38" stroke="#D1D5DB" stroke-width="0.5" stroke-dasharray="2,2"/>

    <!-- 被減數 52 -->
    <text x="30" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#1F2937">5</text>
    <text x="70" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#1F2937">2</text>

    <!-- 減號和減數 27 -->
    <text x="10" y="52" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#374151">−</text>
    <text x="30" y="55" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#374151">2</text>
    <text x="70" y="55" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#374151">7</text>
  </g>

  <!-- 第一層到第二層的箭頭 -->
  <line x1="300" y1="155" x2="300" y2="185" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrowBlue)" stroke-dasharray="6,3"/>

  <!-- ==================== 第二層：借位過程 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="60" y="190" width="480" height="90" rx="12" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/>
  </g>
  <text x="300" y="213" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#F59E0B">② 借位（不夠減，向十位借1）</text>

  <!-- 借位視覺化 -->
  <g transform="translate(230, 222)">
    <!-- 十位和個位分隔線 -->
    <line x1="45" y1="38" x2="85" y2="38" stroke="#374151" stroke-width="1.5"/>
    <line x1="65" y1="0" x2="65" y2="38" stroke="#D1D5DB" stroke-width="0.5" stroke-dasharray="2,2"/>

    <!-- 被減數 - 借位後 -->
    <!-- 十位：5被借1，變成4 -->
    <text x="30" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#F59E0B">4</text>
    <!-- 個位：2借1當10，變成12 -->
    <text x="70" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#10B981">12</text>

    <!-- 借位標記：從十位到個位的箭頭 -->
    <line x1="40" y1="5" x2="60" y2="5" stroke="#F59E0B" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <!-- 借1標籤 -->
    <text x="50" y="-5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#F59E0B" font-weight="bold">借1</text>

    <!-- 減數 27 不變 -->
    <text x="10" y="52" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#374151">−</text>
    <text x="30" y="55" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#374151">2</text>
    <text x="70" y="55" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#374151">7</text>
  </g>

  <!-- 借位說明框 -->
  <g transform="translate(380, 230)">
    <rect x="0" y="0" width="130" height="35" rx="8" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1"/>
    <text x="65" y="15" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#92400E">🔹 個位2不夠減7</text>
    <text x="65" y="28" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#92400E">向十位借1 → 12</text>
  </g>

  <!-- 第二層到第三層的箭頭 -->
  <line x1="300" y1="285" x2="300" y2="315" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowGreen)" stroke-dasharray="6,3"/>

  <!-- ==================== 第三層：結果 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="60" y="320" width="480" height="65" rx="12" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/>
  </g>
  <text x="300" y="342" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#10B981">③ 計算結果</text>

  <!-- 結果視覺化 -->
  <g transform="translate(230, 350)">
    <!-- 十位和個位分隔線 -->
    <line x1="45" y1="0" x2="85" y2="0" stroke="#374151" stroke-width="1.5"/>

    <!-- 計算過程 -->
    <!-- 個位：12 - 7 = 5 -->
    <text x="70" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#10B981">5</text>
    <!-- 十位：4 - 2 = 2 -->
    <text x="30" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="26" font-weight="bold" fill="#10B981">2</text>
  </g>

  <!-- 結果說明框 -->
  <g transform="translate(380, 338)">
    <rect x="0" y="0" width="130" height="35" rx="8" fill="#D1FAE5" stroke="#10B981" stroke-width="1"/>
    <text x="65" y="15" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#065F46">✅ 個位：12−7=5</text>
    <text x="65" y="28" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#065F46">✅ 十位：4−2=2</text>
  </g>

  <!-- 底部提示 -->
  <text x="300" y="393" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#9CA3AF">💡 口訣：個位不夠減，向十位借1，變成10加個位</text>
</svg>