<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F97316;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradHeader" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1"/>
      <stop offset="50%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    
    <!-- 箭頭 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowGray" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#94A3B8"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="12" fill="#F8FAFC"/>
  
  <!-- 頂部裝飾條 -->
  <rect x="0" y="0" width="600" height="6" fill="url(#gradHeader)" rx="3"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B">🎯 P6 呈分試策略（SSPA）</text>
  
  <!-- 分隔線 -->
  <line x1="60" y1="50" x2="540" y2="50" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- ============ 時間分配區塊 ============ -->
  <text x="30" y="80" font-family="Microsoft YaHei, sans-serif" font-size="15" font-weight="bold" fill="#334155">⏱ 時間分配</text>

  <!-- 選擇題 10min -->
  <rect x="30" y="92" width="160" height="52" rx="10" fill="url(#gradPurple)" filter="url(#shadow)" opacity="0.95"/>
  <text x="110" y="116" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF">選擇題</text>
  <text x="110" y="134" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#E0E7FF">10 分鐘</text>

  <!-- 箭頭 1 -->
  <line x1="192" y1="118" x2="218" y2="118" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrowBlue)"/>

  <!-- 計算題 20min -->
  <rect x="222" y="92" width="160" height="52" rx="10" fill="url(#gradOrange)" filter="url(#shadow)" opacity="0.95"/>
  <text x="302" y="116" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF">計算題</text>
  <text x="302" y="134" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#FEF3C7">20 分鐘</text>

  <!-- 箭頭 2 -->
  <line x1="384" y1="118" x2="410" y2="118" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrowOrange)"/>

  <!-- 應用題 30min -->
  <rect x="414" y="92" width="160" height="52" rx="10" fill="url(#gradGreen)" filter="url(#shadow)" opacity="0.95"/>
  <text x="494" y="116" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF">應用題</text>
  <text x="494" y="134" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#D1FAE5">30 分鐘</text>

  <!-- 時間總計 -->
  <rect x="222" y="155" width="160" height="28" rx="14" fill="#E2E8F0" filter="url(#shadowLight)"/>
  <text x="302" y="174" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" font-weight="bold" fill="#475569">總計：60 分鐘</text>

  <!-- ============ 分數目標階梯 ============ -->
  <text x="30" y="215" font-family="Microsoft YaHei, sans-serif" font-size="15" font-weight="bold" fill="#334155">📊 分數目標階梯</text>

  <!-- 階梯 1：基礎 -->
  <rect x="30" y="232" width="540" height="36" rx="8" fill="#F1F5F9" filter="url(#shadowLight)"/>
  <rect x="30" y="232" width="6" height="36" rx="3" fill="#94A3B8"/>
  <text x="50" y="255" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#64748B">第 1 階</text>
  <text x="120" y="255" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#475569">基礎計算 · 簡單應用</text>
  <rect x="420" y="238" width="60" height="24" rx="12" fill="#CBD5E1"/>
  <text x="450" y="255" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" font-weight="bold" fill="#475569">60 分</text>
  <text x="500" y="255" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#94A3B8">目標</text>

  <!-- 箭頭 下 -->
  <line x1="300" y1="270" x2="300" y2="282" stroke="#94A3B8" stroke-width="2" marker-end="url(#arrowGray)"/>

  <!-- 階梯 2：進階 -->
  <rect x="30" y="286" width="540" height="36" rx="8" fill="#FEF3C7" filter="url(#shadowLight)"/>
  <rect x="30" y="286" width="6" height="36" rx="3" fill="#F59E0B"/>
  <text x="50" y="309" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#D97706">第 2 階</text>
  <text x="120" y="309" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#92400E">多步驟運算 · 圖形題</text>
  <rect x="420" y="292" width="60" height="24" rx="12" fill="#FDE68A"/>
  <text x="450" y="309" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" font-weight="bold" fill="#D97706">75 分</text>
  <text x="500" y="309" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#A16207">目標</text>

  <!-- 箭頭 下 -->
  <line x1="300" y1="324" x2="300" y2="336" stroke="#F59E0B" stroke-width="2" marker-end="url(#arrowOrange)"/>

  <!-- 階梯 3：卓越 -->
  <rect x="30" y="340" width="540" height="36" rx="8" fill="#D1FAE5" filter="url(#shadowLight)"/>
  <rect x="30" y="340" width="6" height="36" rx="3" fill="#10B981"/>
  <text x="50" y="363" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#059669">第 3 階</text>
  <text x="120" y="363" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#065F46">綜合應用 · 解難題 · 推理</text>
  <rect x="420" y="346" width="60" height="24" rx="12" fill="#A7F3D0"/>
  <text x="450" y="363" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" font-weight="bold" fill="#059669">90 分</text>
  <text x="500" y="363" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#047857">目標</text>

</svg>