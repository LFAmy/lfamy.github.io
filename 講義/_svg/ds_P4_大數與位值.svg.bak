<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="cardShadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    <filter id="arrowShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1" dy="1" stdDeviation="1" flood-color="#00000044"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="headerGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="50%" stop-color="#7C3AED"/>
      <stop offset="100%" stop-color="#4F46E5"/>
    </linearGradient>
    <linearGradient id="digitGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <linearGradient id="valueGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#EEF2FF"/>
      <stop offset="100%" stop-color="#E0E7FF"/>
    </linearGradient>
    <linearGradient id="sectionGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FEF3C7"/>
      <stop offset="100%" stop-color="#FDE68A"/>
    </linearGradient>
    
    <!-- 箭頭定義 -->
    <marker id="arrowDown" markerWidth="10" markerHeight="8" refX="5" refY="8" orient="auto">
      <path d="M0,0 L5,8 L10,0" fill="#4F46E5" filter="url(#arrowShadow)"/>
    </marker>
    <marker id="arrowUp" markerWidth="10" markerHeight="8" refX="5" refY="0" orient="auto">
      <path d="M0,8 L5,0 L10,8" fill="#10B981" filter="url(#arrowShadow)"/>
    </marker>
    <marker id="arrowRight" markerWidth="8" markerHeight="10" refX="8" refY="5" orient="auto">
      <path d="M0,0 L8,5 L0,10" fill="#F59E0B" filter="url(#arrowShadow)"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="url(#bgGrad)"/>
  
  <!-- 裝飾圓點 -->
  <circle cx="30" cy="30" r="8" fill="#4F46E5" opacity="0.15"/>
  <circle cx="570" cy="30" r="12" fill="#F59E0B" opacity="0.15"/>
  <circle cx="30" cy="370" r="10" fill="#10B981" opacity="0.15"/>
  <circle cx="570" cy="370" r="6" fill="#4F46E5" opacity="0.15"/>

  <!-- 標題 -->
  <rect x="150" y="12" width="300" height="38" rx="19" fill="url(#headerGrad)" filter="url(#shadow)"/>
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="20" font-weight="bold" fill="#FFFFFF">大數與位值</text>

  <!-- 數字顯示區 -->
  <rect x="40" y="62" width="520" height="56" rx="10" fill="#FFFFFF" filter="url(#cardShadow)"/>
  
  <!-- 數字：3 位一節顯示 -->
  <text x="300" y="100" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="36" font-weight="bold" fill="#1F2937" letter-spacing="2">
    8 6 4  ·  3 5 7  ·  9 2 1
  </text>

  <!-- 分節標示線 -->
  <line x1="175" y1="118" x2="175" y2="128" stroke="#F59E0B" stroke-width="2"/>
  <line x1="300" y1="118" x2="300" y2="128" stroke="#F59E0B" stroke-width="2"/>
  <line x1="425" y1="118" x2="425" y2="128" stroke="#F59E0B" stroke-width="2"/>

  <!-- 分節標籤 -->
  <text x="175" y="140" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#F59E0B" font-weight="bold">萬億</text>
  <text x="300" y="140" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#F59E0B" font-weight="bold">億</text>
  <text x="425" y="140" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#F59E0B" font-weight="bold">萬</text>

  <!-- 位值表 -->
  <rect x="40" y="155" width="520" height="200" rx="10" fill="#FFFFFF" filter="url(#cardShadow)"/>
  
  <!-- 表頭 -->
  <rect x="40" y="155" width="520" height="32" rx="10" fill="url(#headerGrad)"/>
  <rect x="40" y="175" width="520" height="12" fill="url(#headerGrad)"/>
  
  <text x="130" y="176" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">位值</text>
  <text x="300" y="176" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">數字</text>
  <text x="470" y="176" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF">數值</text>

  <!-- 分隔線 -->
  <line x1="220" y1="187" x2="220" y2="355" stroke="#E5E7EB" stroke-width="1"/>
  <line x1="380" y1="187" x2="380" y2="355" stroke="#E5E7EB" stroke-width="1"/>

  <!-- 行1：億位 -->
  <rect x="40" y="187" width="520" height="28" fill="#F9FAFB"/>
  <text x="130" y="206" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">億位</text>
  <text x="300" y="206" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">8</text>
  <text x="470" y="206" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">800,000,000</text>

  <!-- 行2：千萬位 -->
  <rect x="40" y="215" width="520" height="28" fill="#FFFFFF"/>
  <text x="130" y="234" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">千萬位</text>
  <text x="300" y="234" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">6</text>
  <text x="470" y="234" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">60,000,000</text>

  <!-- 行3：百萬位 -->
  <rect x="40" y="243" width="520" height="28" fill="#F9FAFB"/>
  <text x="130" y="262" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">百萬位</text>
  <text x="300" y="262" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">4</text>
  <text x="470" y="262" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">4,000,000</text>

  <!-- 行4：十萬位 -->
  <rect x="40" y="271" width="520" height="28" fill="#FFFFFF"/>
  <text x="130" y="290" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">十萬位</text>
  <text x="300" y="290" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">3</text>
  <text x="470" y="290" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">300,000</text>

  <!-- 行5：萬位 -->
  <rect x="40" y="299" width="520" height="28" fill="#F9FAFB"/>
  <text x="130" y="318" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">萬位</text>
  <text x="300" y="318" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">5</text>
  <text x="470" y="318" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">50,000</text>

  <!-- 行6：千位 -->
  <rect x="40" y="327" width="520" height="28" fill="#FFFFFF"/>
  <text x="130" y="346" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">千位</text>
  <text x="300" y="346" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#1F2937" font-weight="bold">7</text>
  <text x="470" y="346" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">7,000</text>

  <!-- 箭頭：從位值指向數字 -->
  <!-- 億位箭頭 -->
  <line x1="180" y1="200" x2="240" y2="200" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>
  <!-- 千萬位箭頭 -->
  <line x1="180" y1="228" x2="240" y2="228" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>
  <!-- 百萬位箭頭 -->
  <line x1="180" y1="256" x2="240" y2="256" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>
  <!-- 十萬位箭頭 -->
  <line x1="180" y1="284" x2="240" y2="284" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>
  <!-- 萬位箭頭 -->
  <line x1="180" y1="312" x2="240" y2="312" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>
  <!-- 千位箭頭 -->
  <line x1="180" y1="340" x2="240" y2="340" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowRight)"/>

  <!-- 箭頭：從數字指向數值 -->
  <line x1="350" y1="200" x2="410" y2="200" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>
  <line x1="350" y1="228" x2="410" y2="228" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>
  <line x1="350" y1="256" x2="410" y2="256" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>
  <line x1="350" y1="284" x2="410" y2="284" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>
  <line x1="350" y1="312" x2="410" y2="312" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>
  <line x1="350" y1="340" x2="410" y2="340" stroke="#10B981" stroke-width="2" marker-end="url(#arrowRight)"/>

  <!-- 底部提示 -->
  <rect x="140" y="368" width="320" height="24" rx="12" fill="#4F46E5" opacity="0.1"/>
  <text x="300" y="384" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#4F46E5">💡 每 3 位一節：從右向左，個、十、百、千、萬、十萬、百萬、千萬、億</text>
</svg>