<svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="mainGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5"/>
      <stop offset="100%" style="stop-color:#818CF8"/>
    </linearGradient>
    <linearGradient id="yellowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B"/>
      <stop offset="100%" style="stop-color:#FCD34D"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981"/>
      <stop offset="100%" style="stop-color:#34D399"/>
    </linearGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EF4444"/>
      <stop offset="100%" style="stop-color:#F87171"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-color="#4F46E5" flood-opacity="0.2"/>
    </filter>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#4F46E5"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="12"/>

  <!-- 主卡片 -->
  <rect x="20" y="20" width="560" height="360" fill="white" rx="16" filter="url(#shadow)"/>

  <!-- 標題區域 -->
  <rect x="40" y="30" width="520" height="60" fill="url(#mainGrad)" rx="10"/>
  <text x="300" y="68" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="white">P5 上學期「數與量」陷阱總結複習</text>

  <!-- 紅綠燈主圖 -->
  <rect x="240" y="100" width="120" height="200" fill="#F3F4F6" rx="10"/>
  <circle cx="300" cy="140" r="25" fill="url(#redGrad)"/>
  <circle cx="300" cy="200" r="25" fill="url(#yellowGrad)"/>
  <circle cx="300" cy="260" r="25" fill="url(#greenGrad)"/>
  <text x="300" y="145" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="white">危險</text>
  <text x="300" y="205" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="white">注意</text>
  <text x="300" y="265" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="white">安全</text>

  <!-- 左側卡片 -->
  <rect x="40" y="110" width="180" height="240" fill="#FEF2F2" rx="10" filter="url(#shadow)"/>
  <text x="130" y="140" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#EF4444">紅燈陷阱（常見錯誤）</text>
  <line x1="80" y1="150" x2="180" y2="150" stroke="#FECACA" stroke-width="2"/>
  <text x="130" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#B91C1C">單位換算忘記進率</text>
  <text x="130" y="195" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#B91C1C">計算過程漏寫單位</text>
  <text x="130" y="215" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#B91C1C">題目要求「約」卻計精確值</text>

  <!-- 右側卡片 -->
  <rect x="380" y="110" width="180" height="240" fill="#ECFDF5" rx="10" filter="url(#shadow)"/>
  <text x="470" y="140" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#10B981">綠燈提示（正確做法）</text>
  <line x1="420" y1="150" x2="520" y2="150" stroke="#A7F3D0" stroke-width="2"/>
  <text x="470" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#065F46">先寫出進率再計算</text>
  <text x="470" y="195" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#065F46">每步檢查單位是否正確</text>
  <text x="470" y="215" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#065F46">按題目要求保留合適位數</text>

  <!-- 箭頭標記 -->
  <line x1="230" y1="230" x2="260" y2="230" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrow)"/>
  <line x1="340" y1="230" x2="370" y2="230" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 底部總結 -->
  <rect x="100" y="360" width="400" height="30" fill="#EFF6FF" rx="8"/>
  <text x="300" y="380" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#4F46E5">記住：看清單位 → 正確進率 → 按步計算 → 檢查答案</text>
</svg>