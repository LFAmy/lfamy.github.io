<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-opacity="0.25"/>
    </filter>
    <filter id="shadowLight" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.2"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EF4444;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DC2626;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2563EB;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#D97706;stop-opacity:1" />
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowRed" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#EF4444"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#3B82F6"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGray" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#6B7280"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#FFFBEB" rx="12"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">🍕 分數基本認識</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#F59E0B" stroke-width="2" opacity="0.5"/>

  <!-- ==================== 1/2 紅色半圓 ==================== -->
  <g transform="translate(100, 120)">
    <circle cx="0" cy="0" r="55" fill="#FEF2F2" stroke="#EF4444" stroke-width="1.5" filter="url(#shadowLight)"/>
    <!-- 半圓 (1/2) -->
    <path d="M0,0 L0,-55 A55,55 0 0,1 0,55 Z" fill="url(#gradRed)" filter="url(#shadow)"/>
    <!-- 分隔線 -->
    <line x1="0" y1="-55" x2="0" y2="55" stroke="#7F1D1D" stroke-width="1.5" opacity="0.4"/>
    <!-- 分數文字 -->
    <text x="0" y="8" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF">1/2</text>
    
    <!-- 分子分母標示 -->
    <line x1="35" y1="-20" x2="75" y2="-40" stroke="#EF4444" stroke-width="1.5" marker-end="url(#arrowRed)" stroke-dasharray="3,2"/>
    <text x="78" y="-44" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#EF4444" font-weight="bold">分子</text>
    
    <line x1="35" y1="20" x2="75" y2="40" stroke="#EF4444" stroke-width="1.5" marker-end="url(#arrowRed)" stroke-dasharray="3,2"/>
    <text x="78" y="56" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#EF4444" font-weight="bold">分母</text>
  </g>

  <!-- ==================== 1/3 藍色扇形 ==================== -->
  <g transform="translate(250, 120)">
    <circle cx="0" cy="0" r="55" fill="#EFF6FF" stroke="#3B82F6" stroke-width="1.5" filter="url(#shadowLight)"/>
    <!-- 1/3 扇形 (120度) -->
    <path d="M0,0 L0,-55 A55,55 0 0,1 47.63,27.5 Z" fill="url(#gradBlue)" filter="url(#shadow)"/>
    <!-- 分隔線 -->
    <line x1="0" y1="0" x2="0" y2="-55" stroke="#1E3A5F" stroke-width="1.5" opacity="0.4"/>
    <line x1="0" y1="0" x2="47.63" y2="27.5" stroke="#1E3A5F" stroke-width="1.5" opacity="0.4"/>
    <!-- 分數文字 -->
    <text x="18" y="-10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">1/3</text>
    
    <!-- 分子分母標示 -->
    <line x1="25" y1="-30" x2="65" y2="-50" stroke="#3B82F6" stroke-width="1.5" marker-end="url(#arrowBlue)" stroke-dasharray="3,2"/>
    <text x="68" y="-54" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#3B82F6" font-weight="bold">分子</text>
    
    <line x1="50" y1="20" x2="80" y2="35" stroke="#3B82F6" stroke-width="1.5" marker-end="url(#arrowBlue)" stroke-dasharray="3,2"/>
    <text x="83" y="50" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#3B82F6" font-weight="bold">分母</text>
  </g>

  <!-- ==================== 2/3 綠色扇形 ==================== -->
  <g transform="translate(400, 120)">
    <circle cx="0" cy="0" r="55" fill="#ECFDF5" stroke="#10B981" stroke-width="1.5" filter="url(#shadowLight)"/>
    <!-- 2/3 扇形 (240度) -->
    <path d="M0,0 L0,-55 A55,55 0 0,1 -47.63,27.5 Z" fill="url(#gradGreen)" filter="url(#shadow)"/>
    <!-- 分隔線 -->
    <line x1="0" y1="0" x2="0" y2="-55" stroke="#064E3B" stroke-width="1.5" opacity="0.4"/>
    <line x1="0" y1="0" x2="-47.63" y2="27.5" stroke="#064E3B" stroke-width="1.5" opacity="0.4"/>
    <line x1="0" y1="0" x2="47.63" y2="27.5" stroke="#064E3B" stroke-width="1.5" opacity="0.4"/>
    <!-- 分數文字 -->
    <text x="-18" y="-10" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">2/3</text>
    
    <!-- 分子分母標示 -->
    <line x1="-25" y1="-30" x2="-65" y2="-50" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)" stroke-dasharray="3,2"/>
    <text x="-95" y="-54" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">分子</text>
    
    <line x1="-50" y1="20" x2="-80" y2="35" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)" stroke-dasharray="3,2"/>
    <text x="-108" y="50" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">分母</text>
  </g>

  <!-- ==================== 1/4 橙色扇形 ==================== -->
  <g transform="translate(500, 120)">
    <circle cx="0" cy="0" r="55" fill="#FFFBEB" stroke="#F59E0B" stroke-width="1.5" filter="url(#shadowLight)"/>
    <!-- 1/4 扇形 (90度) -->
    <path d="M0,0 L0,-55 A55,55 0 0,1 55,0 Z" fill="url(#gradOrange)" filter="url(#shadow)"/>
    <!-- 分隔線 -->
    <line x1="0" y1="0" x2="0" y2="-55" stroke="#78350F" stroke-width="1.5" opacity="0.4"/>
    <line x1="0" y1="0" x2="55" y2="0" stroke="#78350F" stroke-width="1.5" opacity="0.4"/>
    <!-- 分數文字 -->
    <text x="22" y="-8" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF">1/4</text>
    
    <!-- 分子分母標示 -->
    <line x1="30" y1="-25" x2="65" y2="-45" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)" stroke-dasharray="3,2"/>
    <text x="68" y="-49" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#F59E0B" font-weight="bold">分子</text>
    
    <line x1="55" y1="15" x2="80" y2="30" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)" stroke-dasharray="3,2"/>
    <text x="83" y="45" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#F59E0B" font-weight="bold">分母</text>
  </g>

  <!-- ==================== 底部說明 ==================== -->
  <g transform="translate(0, 340)">
    <rect x="50" y="0" width="500" height="45" rx="8" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1" opacity="0.8"/>
    <text x="300" y="28" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#92400E">
      💡 分子 = 選取的部分 ｜ 分母 = 總共等分的份數
    </text>
  </g>

  <!-- 圖例 -->
  <g transform="translate(50, 285)">
    <rect x="0" y="0" width="12" height="12" rx="2" fill="url(#gradRed)"/>
    <text x="16" y="11" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">1/2</text>
    
    <rect x="80" y="0" width="12" height="12" rx="2" fill="url(#gradBlue)"/>
    <text x="96" y="11" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">1/3</text>
    
    <rect x="160" y="0" width="12" height="12" rx="2" fill="url(#gradGreen)"/>
    <text x="176" y="11" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">2/3</text>
    
    <rect x="240" y="0" width="12" height="12" rx="2" fill="url(#gradOrange)"/>
    <text x="256" y="11" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563">1/4</text>
  </g>
</svg>