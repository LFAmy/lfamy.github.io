<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000020"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000015"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradPrimary" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#6366F1"/>
      <stop offset="100%" stop-color="#4F46E5"/>
    </linearGradient>
    <linearGradient id="gradAccent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradSuccess" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="gradHeader" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="12"/>
  
  <!-- 頂部標題欄 -->
  <rect x="0" y="0" width="600" height="52" fill="url(#gradHeader)" rx="12"/>
  <rect x="0" y="30" width="600" height="22" fill="url(#gradHeader)"/>
  <text x="300" y="34" text-anchor="middle" fill="#FFFFFF" font-size="20" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">百分數三步法：部分 ÷ 整體 × 100%</text>

  <!-- ========== 第一步：部分 ÷ 整體 ========== -->
  <rect x="30" y="72" width="170" height="90" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <rect x="30" y="72" width="170" height="34" rx="12" fill="url(#gradPrimary)"/>
  <rect x="30" y="96" width="170" height="10" fill="url(#gradPrimary)"/>
  
  <text x="115" y="94" text-anchor="middle" fill="#FFFFFF" font-size="15" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">① 找出部分和整體</text>
  
  <text x="50" y="125" fill="#4F46E5" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">部分 = 折扣金額</text>
  <text x="50" y="148" fill="#4F46E5" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">整體 = 原價</text>

  <!-- 箭頭 1→2 -->
  <line x1="200" y1="117" x2="248" y2="117" stroke="#4F46E5" stroke-width="2.5" marker-end="url(#arrowBlue)"/>

  <!-- ========== 第二步：÷ 計算 ========== -->
  <rect x="260" y="72" width="170" height="90" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <rect x="260" y="72" width="170" height="34" rx="12" fill="url(#gradAccent)"/>
  <rect x="260" y="96" width="170" height="10" fill="url(#gradAccent)"/>
  
  <text x="345" y="94" text-anchor="middle" fill="#FFFFFF" font-size="15" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">② 部分 ÷ 整體</text>
  
  <text x="280" y="125" fill="#F59E0B" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">折扣金額 ÷ 原價</text>
  <text x="280" y="148" fill="#6B7280" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">= 小數</text>

  <!-- 箭頭 2→3 -->
  <line x1="430" y1="117" x2="478" y2="117" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrowOrange)"/>

  <!-- ========== 第三步：× 100% ========== -->
  <rect x="490" y="72" width="90" height="90" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <rect x="490" y="72" width="90" height="34" rx="12" fill="url(#gradSuccess)"/>
  <rect x="490" y="96" width="90" height="10" fill="url(#gradSuccess)"/>
  
  <text x="535" y="94" text-anchor="middle" fill="#FFFFFF" font-size="15" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">③ ×100%</text>
  
  <text x="505" y="125" fill="#10B981" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">小數×100%</text>
  <text x="505" y="148" fill="#10B981" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">= 百分數</text>

  <!-- ========== 示例區：折扣 ========== -->
  <rect x="30" y="182" width="270" height="200" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <rect x="30" y="182" width="270" height="36" rx="12" fill="url(#gradPrimary)"/>
  <rect x="30" y="210" width="270" height="8" fill="url(#gradPrimary)"/>
  
  <text x="165" y="206" text-anchor="middle" fill="#FFFFFF" font-size="16" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">🎯 折扣示例</text>

  <text x="50" y="240" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">書包原價 <tspan fill="#4F46E5" font-weight="bold">$250</tspan>，</text>
  <text x="50" y="260" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">折扣 <tspan fill="#4F46E5" font-weight="bold">$50</tspan>，求折扣百分數？</text>

  <line x1="50" y1="272" x2="280" y2="272" stroke="#E5E7EB" stroke-width="1"/>
  
  <text x="50" y="293" fill="#4F46E5" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">步驟：</text>
  <text x="50" y="315" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">① 部分=$50，整體=$250</text>
  <text x="50" y="337" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">② $50 ÷ $250 = 0.2</text>
  <text x="50" y="359" fill="#10B981" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">③ 0.2 × 100% = 20% 🎉</text>

  <!-- ========== 示例區：利息 ========== -->
  <rect x="320" y="182" width="260" height="200" rx="12" fill="#FFFFFF" filter="url(#shadow)"/>
  <rect x="320" y="182" width="260" height="36" rx="12" fill="url(#gradAccent)"/>
  <rect x="320" y="210" width="260" height="8" fill="url(#gradAccent)"/>
  
  <text x="450" y="206" text-anchor="middle" fill="#FFFFFF" font-size="16" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">💰 利息示例</text>

  <text x="340" y="240" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">存款 <tspan fill="#F59E0B" font-weight="bold">$2000</tspan>，</text>
  <text x="340" y="260" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">利息 <tspan fill="#F59E0B" font-weight="bold">$60</tspan>，求年利率？</text>

  <line x1="340" y1="272" x2="560" y2="272" stroke="#E5E7EB" stroke-width="1"/>
  
  <text x="340" y="293" fill="#F59E0B" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">步驟：</text>
  <text x="340" y="315" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">① 部分=$60，整體=$2000</text>
  <text x="340" y="337" fill="#374151" font-size="13" font-family="Microsoft YaHei, SimHei, sans-serif">② $60 ÷ $2000 = 0.03</text>
  <text x="340" y="359" fill="#10B981" font-size="14" font-weight="bold" font-family="Microsoft YaHei, SimHei, sans-serif">③ 0.03 × 100% = 3% 🎉</text>

  <!-- ========== 底部口訣 ========== -->
  <rect x="30" y="400" width="540" height="0" rx="8" fill="#EEF2FF"/>
</svg>