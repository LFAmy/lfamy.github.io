<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-opacity="0.25"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-opacity="0.15"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradTop" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <linearGradient id="gradClock" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradTimeline" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="50%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    
    <!-- 箭頭定義 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="#F8FAFC"/>
  
  <!-- 頂部標題欄 -->
  <rect x="0" y="0" width="600" height="56" rx="16" fill="url(#gradTop)" filter="url(#shadow)"/>
  <rect x="0" y="30" width="600" height="26" fill="url(#gradTop)"/>
  <text x="300" y="36" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="bold" fill="#FFFFFF">⏰ 時間計算 · 時鐘換算</text>

  <!-- 時鐘區域 -->
  <g transform="translate(120, 220)">
    <!-- 時鐘外框 -->
    <circle cx="0" cy="0" r="72" fill="white" stroke="url(#gradClock)" stroke-width="5" filter="url(#shadow)"/>
    <circle cx="0" cy="0" r="66" fill="#FFFBEB" stroke="#FDE68A" stroke-width="1.5"/>
    
    <!-- 時鐘刻度 -->
    <g stroke="#9CA3AF" stroke-width="1.5">
      <line x1="0" y1="-58" x2="0" y2="-52"/>
      <line x1="0" y1="58" x2="0" y2="52"/>
      <line x1="-58" y1="0" x2="-52" y2="0"/>
      <line x1="58" y1="0" x2="52" y2="0"/>
    </g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(30)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(60)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(120)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(150)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(210)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(240)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(300)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>
    <g stroke="#D1D5DB" stroke-width="1" transform="rotate(330)"><line x1="0" y1="-58" x2="0" y2="-54"/></g>

    <!-- 數字 12,3,6,9 -->
    <text x="0" y="-44" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#4B5563" font-weight="bold">12</text>
    <text x="44" y="5" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#4B5563" font-weight="bold">3</text>
    <text x="0" y="52" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#4B5563" font-weight="bold">6</text>
    <text x="-44" y="5" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#4B5563" font-weight="bold">9</text>

    <!-- 時針 (指向 2:00) -->
    <line x1="0" y1="0" x2="16" y2="-32" stroke="#4F46E5" stroke-width="5" stroke-linecap="round"/>
    <!-- 分針 (指向 12:00) -->
    <line x1="0" y1="0" x2="0" y2="-46" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
    <!-- 中心圓點 -->
    <circle cx="0" cy="0" r="5" fill="#10B981" stroke="white" stroke-width="2"/>
  </g>

  <!-- 換算公式 -->
  <g transform="translate(320, 155)">
    <rect x="0" y="0" width="250" height="52" rx="12" fill="white" stroke="#E5E7EB" stroke-width="1.5" filter="url(#shadowLight)"/>
    <text x="125" y="22" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#4F46E5" font-weight="bold">1 小時 = 60 分鐘</text>
    <text x="125" y="42" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#6B7280">⏳ 60 分鐘 = 1 小時</text>
  </g>

  <!-- 時間線區域 -->
  <g transform="translate(30, 320)">
    <!-- 時間線背景條 -->
    <rect x="0" y="0" width="540" height="56" rx="14" fill="white" stroke="#E5E7EB" stroke-width="1.5" filter="url(#shadowLight)"/>
    
    <!-- 時間線本身 -->
    <line x1="40" y1="28" x2="500" y2="28" stroke="url(#gradTimeline)" stroke-width="5" stroke-linecap="round"/>
    
    <!-- 開始圓點 -->
    <circle cx="40" cy="28" r="10" fill="#4F46E5" stroke="white" stroke-width="3" filter="url(#shadowLight)"/>
    <text x="40" y="52" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#4F46E5" font-weight="bold">開始</text>
    <text x="40" y="-8" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">2:00</text>

    <!-- 經過箭頭 -->
    <line x1="60" y1="28" x2="230" y2="28" stroke="#F59E0B" stroke-width="3" stroke-dasharray="6,4" marker-end="url(#arrowOrange)"/>
    <text x="145" y="16" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#F59E0B" font-weight="bold">經過 30 分鐘</text>

    <!-- 結束圓點 -->
    <circle cx="270" cy="28" r="10" fill="#10B981" stroke="white" stroke-width="3" filter="url(#shadowLight)"/>
    <text x="270" y="52" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">結束</text>
    <text x="270" y="-8" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#10B981" font-weight="bold">2:30</text>

    <!-- 結束箭頭 -->
    <line x1="290" y1="28" x2="460" y2="28" stroke="#10B981" stroke-width="3" stroke-dasharray="6,4" marker-end="url(#arrowGreen)"/>
    <text x="375" y="16" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">經過 45 分鐘</text>

    <!-- 第三個圓點 -->
    <circle cx="500" cy="28" r="10" fill="#4F46E5" stroke="white" stroke-width="3" filter="url(#shadowLight)"/>
    <text x="500" y="52" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="12" fill="#4F46E5" font-weight="bold">結束</text>
    <text x="500" y="-8" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#4F46E5" font-weight="bold">3:15</text>
  </g>

  <!-- 底部提示 -->
  <text x="300" y="388" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#9CA3AF">P3 時間計算 · 1 小時 = 60 分鐘</text>
</svg>