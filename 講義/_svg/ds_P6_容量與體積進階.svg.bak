<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 350" width="700" height="350">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#166534" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#166534" flood-opacity="0.10"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrowGreen" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto" markerUnits="strokeWidth">
      <polygon points="0 0, 10 3.5, 0 7" fill="#16A34A"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto" markerUnits="strokeWidth">
      <polygon points="0 0, 10 3.5, 0 7" fill="#2563EB"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto" markerUnits="strokeWidth">
      <polygon points="0 0, 10 3.5, 0 7" fill="#EA580C"/>
    </marker>
    <marker id="arrowRed" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto" markerUnits="strokeWidth">
      <polygon points="0 0, 10 3.5, 0 7" fill="#DC2626"/>
    </marker>
    
    <!-- 漸變色 -->
    <linearGradient id="bgGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#DCFCE7"/>
      <stop offset="100%" stop-color="#BBF7D0"/>
    </linearGradient>
    <linearGradient id="bgGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#DBEAFE"/>
      <stop offset="100%" stop-color="#BFDBFE"/>
    </linearGradient>
    <linearGradient id="bgGrad3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFF7ED"/>
      <stop offset="100%" stop-color="#FFEDD5"/>
    </linearGradient>
    
    <!-- 水漸變 -->
    <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#60A5FA" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#2563EB" stop-opacity="0.4"/>
    </linearGradient>
    
    <!-- 石頭漸變 -->
    <linearGradient id="stoneGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#9CA3AF"/>
      <stop offset="100%" stop-color="#6B7280"/>
    </linearGradient>
    
    <!-- 截面漸變 -->
    <linearGradient id="sectionGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#D97706" stop-opacity="0.5"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="700" height="350" fill="#F0FDF4" rx="12"/>
  
  <!-- 標題 -->
  <text x="350" y="28" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#166534">📐 容量與體積進階 — 三合一對比圖</text>

  <!-- ============================================ -->
  <!-- 左區：排水法 -->
  <!-- ============================================ -->
  <g transform="translate(15, 40)">
    <!-- 區域背景 -->
    <rect x="0" y="0" width="218" height="295" rx="10" fill="url(#bgGrad1)" filter="url(#shadow)"/>
    
    <!-- 標題 -->
    <text x="109" y="25" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#15803D">💧 排水法</text>
    
    <!-- 量杯杯身 -->
    <path d="M70 50 L70 230 Q70 245 85 245 L135 245 Q150 245 150 230 L150 50 Z" fill="none" stroke="#16A34A" stroke-width="2.5"/>
    
    <!-- 量杯刻度 -->
    <line x1="65" y1="80" x2="75" y2="80" stroke="#16A34A" stroke-width="1.5"/>
    <text x="62" y="84" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#15803D">200</text>
    <line x1="65" y1="120" x2="75" y2="120" stroke="#16A34A" stroke-width="1.5"/>
    <text x="62" y="124" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#15803D">150</text>
    <line x1="65" y1="160" x2="75" y2="160" stroke="#16A34A" stroke-width="1.5"/>
    <text x="62" y="164" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#15803D">100</text>
    <line x1="65" y1="200" x2="75" y2="200" stroke="#16A34A" stroke-width="1.5"/>
    <text x="62" y="204" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#15803D">50</text>
    
    <!-- 水位（初始水位 120） -->
    <rect x="72" y="120" width="76" height="110" fill="url(#waterGrad)" rx="2"/>
    
    <!-- 石頭（放入後水位上升至 80） -->
    <ellipse cx="110" cy="175" rx="22" ry="16" fill="url(#stoneGrad)" stroke="#4B5563" stroke-width="1.5"/>
    <text x="110" y="178" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#fff" font-weight="bold">石</text>
    
    <!-- 水位上升箭頭 -->
    <line x1="160" y1="120" x2="160" y2="82" stroke="#DC2626" stroke-width="2" marker-end="url(#arrowRed)"/>
    <text x="163" y="105" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#DC2626" font-weight="bold">↑</text>
    
    <!-- 水位標籤 -->
    <text x="165" y="118" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#2563EB">初水位</text>
    <text x="165" y="80" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#2563EB">後水位</text>
    
    <!-- 公式 -->
    <rect x="30" y="255" width="160" height="30" rx="6" fill="#166534" opacity="0.9"/>
    <text x="110" y="274" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#fff" font-weight="bold">V物 = 後水位 − 初水位</text>
  </g>

  <!-- ============================================ -->
  <!-- 中區：截面法 -->
  <!-- ============================================ -->
  <g transform="translate(241, 40)">
    <!-- 區域背景 -->
    <rect x="0" y="0" width="218" height="295" rx="10" fill="url(#bgGrad2)" filter="url(#shadow)"/>
    
    <!-- 標題 -->
    <text x="109" y="25" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#1D4ED8">📊 截面法</text>
    
    <!-- 不規則柱體 -->
    <path d="M60 50 L60 200 Q60 220 75 220 L145 220 Q160 220 160 200 L160 50 Z" fill="#EFF6FF" stroke="#2563EB" stroke-width="2.5"/>
    
    <!-- 不規則截面（斜切面） -->
    <path d="M60 130 Q85 110 110 120 Q135 130 160 115" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-dasharray="5,3"/>
    
    <!-- 截面填充 -->
    <path d="M60 130 Q85 110 110 120 Q135 130 160 115 L160 220 Q145 220 145 220 L75 220 Q60 220 60 200 Z" fill="url(#sectionGrad)" opacity="0.5"/>
    
    <!-- 截面標籤箭頭 -->
    <line x1="110" y1="120" x2="110" y2="85" stroke="#EA580C" stroke-width="1.5" marker-end="url(#arrowOrange)"/>
    <text x="112" y="100" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#EA580C">截面</text>
    
    <!-- 高度箭頭 -->
    <line x1="50" y1="55" x2="50" y2="215" stroke="#16A34A" stroke-width="1.5" marker-end="url(#arrowGreen)"/>
    <line x1="50" y1="55" x2="50" y2="215" stroke="#16A34A" stroke-width="1.5" marker-start="url(#arrowGreen)"/>
    <text x="42" y="140" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#15803D" font-weight="bold">高</text>
    
    <!-- 底面積標示 -->
    <rect x="75" y="222" width="70" height="3" fill="#2563EB" opacity="0.5" rx="1"/>
    <text x="110" y="237" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#2563EB">底面積 A</text>
    
    <!-- 公式 -->
    <rect x="30" y="255" width="160" height="30" rx="6" fill="#1D4ED8" opacity="0.9"/>
    <text x="110" y="274" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#fff" font-weight="bold">V = 截面積 × 高</text>
  </g>

  <!-- ============================================ -->
  <!-- 右區：單位換算階梯 -->
  <!-- ============================================ -->
  <g transform="translate(467, 40)">
    <!-- 區域背景 -->
    <rect x="0" y="0" width="218" height="295" rx="10" fill="url(#bgGrad3)" filter="url(#shadow)"/>
    
    <!-- 標題 -->
    <text x="109" y="25" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#9A3412">📏 單位換算階梯</text>
    
    <!-- 階梯 1: cm³ -->
    <rect x="55" y="50" width="110" height="40" rx="8" fill="#F97316" filter="url(#shadowLight)"/>
    <text x="110" y="68" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#fff">cm³</text>
    <text x="110" y="82" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#FFF7ED">立方厘米</text>
    
    <!-- 向下箭頭 1 -->
    <line x1="110" y1="90" x2="110" y2="108" stroke="#EA580C" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <text x="120" y="102" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#EA580C" font-weight="bold">×1</text>
    
    <!-- 階梯 2: mL -->
    <rect x="55" y="108" width="110" height="40" rx="8" fill="#F59E0B" filter="url(#shadowLight)"/>
    <text x="110" y="126" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#fff">mL</text>
    <text x="110" y="140" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#FFF7ED">毫升</text>
    
    <!-- 向下箭頭 2 -->
    <line x1="110" y1="148" x2="110" y2="166" stroke="#EA580C" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <text x="120" y="160" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#EA580C" font-weight="bold">×1000</text>
    
    <!-- 階梯 3: L -->
    <rect x="55" y="166" width="110" height="40" rx="8" fill="#D97706" filter="url(#shadowLight)"/>
    <text x="110" y="184" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#fff">L</text>
    <text x="110" y="198" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#FFF7ED">公升</text>
    
    <!-- 向下箭頭 3 -->
    <line x1="110" y1="206" x2="110" y2="224" stroke="#EA580C" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <text x="120" y="218" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#EA580C" font-weight="bold">×1000</text>
    
    <!-- 階梯 4: m³ -->
    <rect x="55" y="224" width="110" height="40" rx="8" fill="#B45309" filter="url(#shadowLight)"/>
    <text x="110" y="242" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#fff">m³</text>
    <text x="110" y="256" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#FFF7ED">立方米</text>
    
    <!-- 備註 -->
    <text x="109" y="282" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#9A3412">1 cm³ = 1 mL</text>
  </g>

</svg>