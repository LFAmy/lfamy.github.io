<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000033"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000022"/>
    </filter>
    <!-- 漸變色 -->
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#EEF2FF"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
    </linearGradient>
    <!-- 箭頭 -->
    <marker id="arrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="600" height="400" rx="16" fill="url(#gradBg)"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B" filter="url(#shadowLight)">✏️ 乘法應用題：鉛筆的總數</text>

  <!-- 分隔線 -->
  <line x1="40" y1="52" x2="560" y2="52" stroke="#4F46E5" stroke-width="2" opacity="0.3"/>

  <!-- 題目區 -->
  <rect x="30" y="62" width="540" height="44" rx="10" fill="white" opacity="0.85" filter="url(#shadowLight)"/>
  <text x="300" y="82" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="16" fill="#334155">
    每盒有 <tspan fill="#4F46E5" font-weight="bold">12</tspan> 支鉛筆，買了 <tspan fill="#F59E0B" font-weight="bold">8</tspan> 盒，一共有多少支鉛筆？
  </text>
  <text x="300" y="100" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" fill="#64748B">算式：12 × 8 = 96（支）</text>

  <!-- 陣列視覺化：12×8 分組陣列 -->
  <!-- 8行，每行12支鉛筆 -->
  <g transform="translate(30, 120)">
    <!-- 行標籤：盒1~盒8 -->
    <g font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#64748B">
      <text x="0" y="18" text-anchor="end">盒1</text>
      <text x="0" y="48" text-anchor="end">盒2</text>
      <text x="0" y="78" text-anchor="end">盒3</text>
      <text x="0" y="108" text-anchor="end">盒4</text>
      <text x="0" y="138" text-anchor="end">盒5</text>
      <text x="0" y="168" text-anchor="end">盒6</text>
      <text x="0" y="198" text-anchor="end">盒7</text>
      <text x="0" y="228" text-anchor="end">盒8</text>
    </g>

    <!-- 鉛筆圖示 - 每行12支，共8行 -->
    <g>
      <!-- 第1行 -->
      <g transform="translate(10, 0)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
      </g>
      <!-- 第2行 -->
      <g transform="translate(10, 30)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
      </g>
      <!-- 第3行 -->
      <g transform="translate(10, 60)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
      </g>
      <!-- 第4行 -->
      <g transform="translate(10, 90)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
      </g>
      <!-- 第5行 -->
      <g transform="translate(10, 120)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
      </g>
      <!-- 第6行 -->
      <g transform="translate(10, 150)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
      </g>
      <!-- 第7行 -->
      <g transform="translate(10, 180)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
      </g>
      <!-- 第8行 -->
      <g transform="translate(10, 210)">
        <rect x="0" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="10" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="20" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="30" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="40" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="50" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="60" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="70" y="4" width="6" height="22" rx="2" fill="url(#grad2)" opacity="0.9"/>
        <rect x="80" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="90" y="4" width="6" height="22" rx="2" fill="url(#grad3)" opacity="0.9"/>
        <rect x="100" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
        <rect x="110" y="4" width="6" height="22" rx="2" fill="url(#grad1)" opacity="0.9"/>
      </g>
    </g>

    <!-- 每盒分組框線（虛線） -->
    <g stroke="#94A3B8" stroke-width="1" stroke-dasharray="3,3" fill="none">
      <rect x="8" y="2" width="114" height="26" rx="3"/>
      <rect x="8" y="32" width="114" height="26" rx="3"/>
      <rect x="8" y="62" width="114" height="26" rx="3"/>
      <rect x="8" y="92" width="114" height="26" rx="3"/>
      <rect x="8" y="122" width="114" height="26" rx="3"/>
      <rect x="8" y="152" width="114" height="26" rx="3"/>
      <rect x="8" y="182" width="114" height="26" rx="3"/>
      <rect x="8" y="212" width="114" height="26" rx="3"/>
    </g>

    <!-- 頂部標籤：每盒12支 -->
    <g transform="translate(10, -12)">
      <text x="57" y="0" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" fill="#4F46E5" font-weight="bold">每盒12支</text>
    </g>

    <!-- 右側箭頭與標籤：8盒 -->
    <line x1="130" y1="120" x2="160" y2="120" stroke="#F59E0B" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <text x="165" y="124" font-family="Microsoft YaHei, sans-serif" font-size="13" fill="#F59E0B" font-weight="bold">8盒</text>
  </g>

  <!-- 底部答案卡 -->
  <rect x="140" y="355" width="320" height="36" rx="18" fill="url(#grad1)" filter="url(#shadow)" opacity="0.95"/>
  <text x="300" y="378" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="17" fill="white" font-weight="bold">
    答案：12 × 8 = 96 支鉛筆 ✅
  </text>

  <!-- 裝飾小圖標 -->
  <g transform="translate(540, 70)" opacity="0.4">
    <text font-size="28">✏️</text>
  </g>
  <g transform="translate(30, 350)" opacity="0.3">
    <text font-size="22">📦</text>
  </g>
</svg>