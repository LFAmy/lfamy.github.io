<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <!-- 天空漸變 -->
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#87CEEB"/>
      <stop offset="100%" stop-color="#E0F0FF"/>
    </linearGradient>
    <!-- 草地漸變 -->
    <linearGradient id="grassGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#7EC850"/>
      <stop offset="100%" stop-color="#5DAE3A"/>
    </linearGradient>
    <!-- 滑梯漸變 -->
    <linearGradient id="slideGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FF8C42"/>
      <stop offset="100%" stop-color="#E07020"/>
    </linearGradient>
    <!-- 滑道漸變 -->
    <linearGradient id="slideTrackGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFB066"/>
      <stop offset="100%" stop-color="#FF8C42"/>
    </linearGradient>
    <!-- 鞦韆支架漸變 -->
    <linearGradient id="swingGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#D4A574"/>
      <stop offset="100%" stop-color="#C49A6C"/>
    </linearGradient>
    <!-- 太陽漸變 -->
    <radialGradient id="sunGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFF176"/>
      <stop offset="60%" stop-color="#FFD54F"/>
      <stop offset="100%" stop-color="#FFB300"/>
    </radialGradient>
    <!-- 雲朵漸變 -->
    <radialGradient id="cloudGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#E8E8E8"/>
    </radialGradient>
    <!-- 小朋友臉頰 -->
    <radialGradient id="blushGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFB0B0" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#FFB0B0" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- 天空背景 -->
  <rect x="0" y="0" width="800" height="400" fill="url(#skyGrad)"/>

  <!-- 太陽 -->
  <circle cx="680" cy="60" r="45" fill="url(#sunGrad)"/>
  <!-- 太陽光線 -->
  <g stroke="#FFD54F" stroke-width="3" stroke-linecap="round" opacity="0.7">
    <line x1="680" y1="5" x2="680" y2="0"/>
    <line x1="680" y1="115" x2="680" y2="120"/>
    <line x1="625" y1="60" x2="620" y2="60"/>
    <line x1="735" y1="60" x2="740" y2="60"/>
    <line x1="641" y1="21" x2="637" y2="17"/>
    <line x1="719" y1="99" x2="723" y2="103"/>
    <line x1="719" y1="21" x2="723" y2="17"/>
    <line x1="641" y1="99" x2="637" y2="103"/>
  </g>

  <!-- 雲朵1 -->
  <g opacity="0.9">
    <ellipse cx="150" cy="55" rx="50" ry="25" fill="url(#cloudGrad)"/>
    <ellipse cx="190" cy="45" rx="40" ry="22" fill="url(#cloudGrad)"/>
    <ellipse cx="120" cy="50" rx="35" ry="20" fill="url(#cloudGrad)"/>
    <ellipse cx="155" cy="40" rx="30" ry="18" fill="#FFFFFF"/>
  </g>

  <!-- 雲朵2 -->
  <g opacity="0.8">
    <ellipse cx="450" cy="35" rx="40" ry="20" fill="url(#cloudGrad)"/>
    <ellipse cx="480" cy="28" rx="35" ry="18" fill="url(#cloudGrad)"/>
    <ellipse cx="420" cy="32" rx="30" ry="16" fill="url(#cloudGrad)"/>
    <ellipse cx="450" cy="25" rx="25" ry="14" fill="#FFFFFF"/>
  </g>

  <!-- 遠山 -->
  <ellipse cx="200" cy="190" rx="180" ry="60" fill="#A8D88A" opacity="0.5"/>
  <ellipse cx="550" cy="195" rx="200" ry="55" fill="#B5E095" opacity="0.4"/>

  <!-- 草地 -->
  <rect x="0" y="190" width="800" height="210" fill="url(#grassGrad)"/>
  <!-- 草地紋理 -->
  <g stroke="#6BBF45" stroke-width="1.5" opacity="0.4">
    <path d="M50,220 Q52,210 55,220" fill="none"/>
    <path d="M120,240 Q122,230 125,240" fill="none"/>
    <path d="M200,225 Q202,215 205,225" fill="none"/>
    <path d="M320,235 Q322,225 325,235" fill="none"/>
    <path d="M450,220 Q452,210 455,220" fill="none"/>
    <path d="M550,245 Q552,235 555,245" fill="none"/>
    <path d="M650,230 Q652,220 655,230" fill="none"/>
    <path d="M720,250 Q722,240 725,250" fill="none"/>
  </g>

  <!-- 地面 -->
  <rect x="0" y="280" width="800" height="120" fill="#5DAE3A" opacity="0.6"/>

  <!-- === 滑梯 === -->
  <!-- 滑梯平台 -->
  <rect x="230" y="150" width="60" height="10" rx="4" fill="#E07020"/>
  <!-- 滑梯支柱 -->
  <rect x="240" y="160" width="8" height="130" rx="3" fill="#D4A574"/>
  <rect x="275" y="160" width="8" height="130" rx="3" fill="#D4A574"/>
  <!-- 滑梯橫桿 -->
  <rect x="240" y="170" width="43" height="4" rx="2" fill="#C49A6C"/>
  <rect x="240" y="200" width="43" height="4" rx="2" fill="#C49A6C"/>
  <rect x="240" y="230" width="43" height="4" rx="2" fill="#C49A6C"/>
  <!-- 樓梯 -->
  <rect x="248" y="175" width="4" height="115" rx="2" fill="#C49A6C"/>
  <rect x="268" y="175" width="4" height="115" rx="2" fill="#C49A6C"/>
  <rect x="248" y="190" width="24" height="4" rx="2" fill="#D4A574"/>
  <rect x="248" y="215" width="24" height="4" rx="2" fill="#D4A574"/>
  <rect x="248" y="240" width="24" height="4" rx="2" fill="#D4A574"/>
  <rect x="248" y="265" width="24" height="4" rx="2" fill="#D4A574"/>
  <!-- 滑道 -->
  <path d="M290,155 Q340,200 350,290" stroke="url(#slideTrackGrad)" stroke-width="18" fill="none" stroke-linecap="round"/>
  <path d="M290,155 Q340,200 350,290" stroke="#FFD4A0" stroke-width="12" fill="none" stroke-linecap="round" opacity="0.5"/>
  <!-- 滑道邊緣 -->
  <path d="M290,155 Q340,200 350,290" stroke="#E07020" stroke-width="20" fill="none" stroke-linecap="round" opacity="0.2"/>

  <!-- === 鞦韆 === -->
  <!-- 鞦韆支架 -->
  <line x1="520" y1="120" x2="490" y2="290" stroke="url(#swingGrad)" stroke-width="8" stroke-linecap="round"/>
  <line x1="600" y1="120" x2="630" y2="290" stroke="url(#swingGrad)" stroke-width="8" stroke-linecap="round"/>
  <!-- 鞦韆橫樑 -->
  <line x1="518" y1="120" x2="602" y2="120" stroke="#D4A574" stroke-width="8" stroke-linecap="round"/>
  <!-- 鞦韆繩子 -->
  <line x1="540" y1="125" x2="535" y2="230" stroke="#C49A6C" stroke-width="3"/>
  <line x1="565" y1="125" x2="570" y2="230" stroke="#C49A6C" stroke-width="3"/>
  <!-- 鞦韆座椅 -->
  <rect x="530" y="228" width="40" height="8" rx="4" fill="#D4A574"/>

  <!-- === 量度距離標記 === -->
  <!-- 地面標尺 -->
  <g stroke="#FF6B6B" stroke-width="2" opacity="0.7">
    <line x1="100" y1="295" x2="100" y2="285"/>
    <line x1="150" y1="295" x2="150" y2="285"/>
    <line x1="200" y1="295" x2="200" y2="285"/>
    <line x1="250" y1="295" x2="250" y2="285"/>
    <line x1="300" y1="295" x2="300" y2="285"/>
    <line x1="350" y1="295" x2="350" y2="285"/>
    <line x1="400" y1="295" x2="400" y2="285"/>
    <line x1="450" y1="295" x2="450" y2="285"/>
    <line x1="500" y1="295" x2="500" y2="285"/>
    <line x1="550" y1="295" x2="550" y2="285"/>
    <line x1="600" y1="295" x2="600" y2="285"/>
    <line x1="650" y1="295" x2="650" y2="285"/>
  </g>
  <!-- 長標記 -->
  <g stroke="#FF6B6B" stroke-width="3" opacity="0.7">
    <line x1="100" y1="300" x2="100" y2="280"/>
    <line x1="200" y1="300" x2="200" y2="280"/>
    <line x1="300" y1="300" x2="300" y2="280"/>
    <line x1="400" y1="300" x2="400" y2="280"/>
    <line x1="500" y1="300" x2="500" y2="280"/>
    <line x1="600" y1="300" x2="600" y2="280"/>
    <line x1="700" y1="300" x2="700" y2="280"/>
  </g>
  <!-- 地面線 -->
  <line x1="80" y1="300" x2="720" y2="300" stroke="#FF6B6B" stroke-width="2" stroke-dasharray="5,5" opacity="0.5"/>

  <!-- === 小朋友1：滑梯上的小孩 === -->
  <g transform="translate(260, 130)">
    <!-- 身體 -->
    <rect x="-10" y="0" width="20" height="22" rx="8" fill="#FF6B6B"/>
    <!-- 頭 -->
    <circle cx="0" cy="-8" r="12" fill="#FFDAB9"/>
    <!-- 頭髮 -->
    <path d="M-12,-10 Q-12,-22 0,-22 Q12,-22 12,-10" fill="#4A3728"/>
    <!-- 眼睛 -->
    <circle cx="-4" cy="-9" r="2" fill="#333"/>
    <circle cx="4" cy="-9" r="2" fill="#333"/>
    <!-- 嘴巴 -->
    <path d="M-3,-5 Q0,-2 3,-5" stroke="#333" stroke-width="1" fill="none"/>
    <!-- 臉頰 -->
    <circle cx="-7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <circle cx="7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <!-- 手臂 -->
    <line x1="-10" y1="5" x2="-18" y2="12" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <line x1="10" y1="5" x2="18" y2="12" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <!-- 腿 -->
    <line x1="-5" y1="22" x2="-8" y2="32" stroke="#4A7CBF" stroke-width="4" stroke-linecap="round"/>
    <line x1="5" y1="22" x2="8" y2="32" stroke="#4A7CBF" stroke-width="4" stroke-linecap="round"/>
    <!-- 鞋子 -->
    <ellipse cx="-9" cy="33" rx="4" ry="2" fill="#FF6B6B"/>
    <ellipse cx="9" cy="33" rx="4" ry="2" fill="#FF6B6B"/>
  </g>

  <!-- === 小朋友2：鞦韆上的小孩 === -->
  <g transform="translate(550, 200)">
    <!-- 身體 -->
    <rect x="-10" y="0" width="20" height="22" rx="8" fill="#4FC3F7"/>
    <!-- 頭 -->
    <circle cx="0" cy="-8" r="12" fill="#FFDAB9"/>
    <!-- 頭髮 -->
    <path d="M-12,-10 Q-12,-24 0,-24 Q12,-24 12,-10" fill="#8B4513"/>
    <!-- 馬尾 -->
    <circle cx="12" cy="-18" r="5" fill="#8B4513"/>
    <!-- 眼睛 -->
    <circle cx="-4" cy="-9" r="2" fill="#333"/>
    <circle cx="4" cy="-9" r="2" fill="#333"/>
    <!-- 嘴巴 -->
    <path d="M-3,-4 Q0,-1 3,-4" stroke="#333" stroke-width="1" fill="none"/>
    <!-- 臉頰 -->
    <circle cx="-7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <circle cx="7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <!-- 手臂 -->
    <line x1="-10" y1="5" x2="-16" y2="14" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <line x1="10" y1="5" x2="16" y2="14" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <!-- 腿 -->
    <line x1="-5" y1="22" x2="-10" y2="32" stroke="#FF8C42" stroke-width="4" stroke-linecap="round"/>
    <line x1="5" y1="22" x2="10" y2="32" stroke="#FF8C42" stroke-width="4" stroke-linecap="round"/>
    <!-- 鞋子 -->
    <ellipse cx="-11" cy="33" rx="4" ry="2" fill="#4FC3F7"/>
    <ellipse cx="11" cy="33" rx="4" ry="2" fill="#4FC3F7"/>
  </g>

  <!-- === 小朋友3：站在地面上的小孩 === -->
  <g transform="translate(380, 260)">
    <!-- 身體 -->
    <rect x="-10" y="0" width="20" height="22" rx="8" fill="#FFD54F"/>
    <!-- 頭 -->
    <circle cx="0" cy="-8" r="12" fill="#FFDAB9"/>
    <!-- 頭髮 -->
    <path d="M-12,-10 Q-12,-22 0,-22 Q12,-22 12,-10" fill="#2C1810"/>
    <!-- 帽子 -->
    <ellipse cx="0" cy="-18" rx="14" ry="4" fill="#FF6B6B"/>
    <rect x="-10" y="-22" width="20" height="6" rx="3" fill="#FF6B6B"/>
    <!-- 眼睛 -->
    <circle cx="-4" cy="-9" r="2" fill="#333"/>
    <circle cx="4" cy="-9" r="2" fill="#333"/>
    <!-- 嘴巴 -->
    <path d="M-3,-5 Q0,-2 3,-5" stroke="#333" stroke-width="1" fill="none"/>
    <!-- 臉頰 -->
    <circle cx="-7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <circle cx="7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <!-- 手臂 -->
    <line x1="-10" y1="5" x2="-18" y2="10" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <line x1="10" y1="5" x2="18" y2="10" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <!-- 腿 -->
    <line x1="-5" y1="22" x2="-7" y2="32" stroke="#4A7CBF" stroke-width="4" stroke-linecap="round"/>
    <line x1="5" y1="22" x2="7" y2="32" stroke="#4A7CBF" stroke-width="4" stroke-linecap="round"/>
    <!-- 鞋子 -->
    <ellipse cx="-8" cy="33" rx="4" ry="2" fill="#FFD54F"/>
    <ellipse cx="8" cy="33" rx="4" ry="2" fill="#FFD54F"/>
  </g>

  <!-- === 小朋友4：跑動中的小孩 === -->
  <g transform="translate(650, 258)">
    <!-- 身體 -->
    <rect x="-10" y="0" width="20" height="22" rx="8" fill="#AB47BC"/>
    <!-- 頭 -->
    <circle cx="0" cy="-8" r="12" fill="#FFDAB9"/>
    <!-- 頭髮 -->
    <path d="M-12,-10 Q-12,-23 0,-23 Q12,-23 12,-10" fill="#FF8C42"/>
    <!-- 眼睛 -->
    <circle cx="-4" cy="-9" r="2" fill="#333"/>
    <circle cx="4" cy="-9" r="2" fill="#333"/>
    <!-- 嘴巴 -->
    <path d="M-3,-4 Q0,-1 3,-4" stroke="#333" stroke-width="1" fill="none"/>
    <!-- 臉頰 -->
    <circle cx="-7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <circle cx="7" cy="-6" r="3" fill="url(#blushGrad)"/>
    <!-- 手臂（擺動） -->
    <line x1="-10" y1="5" x2="-20" y2="0" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <line x1="10" y1="5" x2="20" y2="12" stroke="#FFDAB9" stroke-width="4" stroke-linecap="round"/>
    <!-- 腿（跑動姿勢） -->
    <line x1="-5" y1="22" x2="-12" y2="32" stroke="#FF8C42" stroke-width="4" stroke-linecap="round"/>
    <line x1="5" y1="22" x2="14" y2="30" stroke="#FF8C42" stroke-width="4" stroke-linecap="round"/>
    <!-- 鞋子 -->
    <ellipse cx="-13" cy="33" rx="4" ry="2" fill="#AB47BC"/>
    <ellipse cx="15" cy="31" rx="4" ry="2" fill="#AB47BC"/>
  </g>

  <!-- === 裝飾：小花朵 === -->
  <g transform="translate(80, 270)">
    <circle cx="0" cy="0" r="4" fill="#FF6B6B"/>
    <circle cx="0" cy="0" r="2" fill="#FFD54F"/>
    <line x1="0" y1="4" x2="0" y2="12" stroke="#5DAE3A" stroke-width="2"/>
  </g>
  <g transform="translate(420, 275)">
    <circle cx="0" cy="0" r="4" fill="#FF8C42"/>
    <circle cx="0" cy="0" r="2" fill="#FFD54F"/>
    <line x1="0" y1="4" x2="0" y2="12" stroke="#5DAE3A" stroke-width="2"/>
  </g>
  <g transform="translate(700, 268)">
    <circle cx="0" cy="0" r="4" fill="#E040FB"/>
    <circle cx="0" cy="0" r="2" fill="#FFD54F"/>
    <line x1="0" y1="4" x2="0" y2="12" stroke="#5DAE3A" stroke-width="2"/>
  </g>
  <g transform="translate(160, 278)">
    <circle cx="0" cy="0" r="3" fill="#4FC3F7"/>
    <circle cx="0" cy="0" r="1.5" fill="#FFD54F"/>
    <line x1="0" y1="3" x2="0" y2="10" stroke="#5DAE3A" stroke-width="1.5"/>
  </g>

  <!-- 小樹 -->
  <g transform="translate(60, 200)">
    <rect x="-4" y="0" width="8" height="30" rx="3" fill="#8B6914"/>
    <ellipse cx="0" cy="-10" rx="20" ry="18" fill="#66BB6A"/>
    <ellipse cx="-8" cy="-5" rx="12" ry="12" fill="#81C784"/>
    <ellipse cx="8" cy="-5" rx="12" ry="12" fill="#81C784"/>
  </g>

  <g transform="translate(750, 210)">
    <rect x="-3" y="0" width="6" height="25" rx="3" fill="#8B6914"/>
    <ellipse cx="0" cy="-8" rx="16" ry="14" fill="#66BB6A"/>
    <ellipse cx="-6" cy="-4" rx="10" ry="10" fill="#81C784"/>
    <ellipse cx="6" cy="-4" rx="10" ry="10" fill="#81C784"/>
  </g>

  <!-- 小鳥 -->
  <g transform="translate(300, 60)">
    <path d="M0,0 Q5,-5 10,0 Q15,-5 20,0 Q15,3 10,5 Q5,3 0,0Z" fill="#FF6B6B" opacity="0.7"/>
  </g>
  <g transform="translate(500, 70)">
    <path d="M0,0 Q5,-5 10,0 Q15,-5 20,0 Q15,3 10,5 Q5,3 0,0Z" fill="#4FC3F7" opacity="0.7"/>
  </g>

  <!-- 球 -->
  <circle cx="470" cy="278" r="8" fill="#FF6B6B" opacity="0.8"/>
  <path d="M464,274 Q470,270 476,274" stroke="#FF4444" stroke-width="1" fill="none" opacity="0.5"/>
</svg>