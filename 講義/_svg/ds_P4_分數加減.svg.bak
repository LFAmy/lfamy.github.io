<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000018"/>
    </filter>
    <filter id="shadowText" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="1" dy="1" stdDeviation="1" flood-color="#00000030"/>
    </filter>

    <!-- 箭頭標記 -->
    <marker id="arrowRed" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#EF4444"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#3B82F6"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#10B981"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGray" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#9CA3AF"/>
    </marker>

    <!-- 漸變色 -->
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F87171"/>
      <stop offset="100%" stop-color="#EF4444"/>
    </linearGradient>
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60A5FA"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFF7D6"/>
      <stop offset="100%" stop-color="#FFFBEB"/>
    </linearGradient>

    <!-- 圓餅圖裁剪路徑 -->
    <clipPath id="pieClip1"><circle cx="120" cy="180" r="70"/></clipPath>
    <clipPath id="pieClip2"><circle cx="300" cy="180" r="70"/></clipPath>
    <clipPath id="pieClip3"><circle cx="480" cy="180" r="70"/></clipPath>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#gradBg)" rx="16"/>

  <!-- 標題 -->
  <text x="300" y="40" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937" filter="url(#shadowText)">📐 同分母分數加法</text>
  <line x1="180" y1="52" x2="420" y2="52" stroke="#F59E0B" stroke-width="2" opacity="0.5"/>

  <!-- ==================== 左邊：1/4 ==================== -->
  <g filter="url(#shadow)">
    <!-- 圓餅底盤 -->
    <circle cx="120" cy="180" r="72" fill="#FEF3C7" stroke="#FCD34D" stroke-width="2"/>
    <!-- 1/4 紅色扇形 -->
    <path d="M120,180 L120,110 A70,70 0 0,1 190,180 Z" fill="url(#gradRed)" stroke="#DC2626" stroke-width="1.5"/>
    <!-- 分隔線 -->
    <line x1="120" y1="110" x2="120" y2="250" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
    <line x1="50" y1="180" x2="190" y2="180" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
  </g>
  <!-- 分數標籤 -->
  <text x="120" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#EF4444" filter="url(#shadowText)">1/4</text>

  <!-- ==================== 中間：2/4 ==================== -->
  <g filter="url(#shadow)">
    <circle cx="300" cy="180" r="72" fill="#FEF3C7" stroke="#FCD34D" stroke-width="2"/>
    <!-- 2/4 藍色扇形 -->
    <path d="M300,180 L300,110 A70,70 0 0,1 370,180 Z" fill="url(#gradBlue)" stroke="#2563EB" stroke-width="1.5"/>
    <path d="M300,180 L370,180 A70,70 0 0,1 300,250 Z" fill="url(#gradBlue)" stroke="#2563EB" stroke-width="1.5"/>
    <!-- 分隔線 -->
    <line x1="300" y1="110" x2="300" y2="250" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
    <line x1="230" y1="180" x2="370" y2="180" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
  </g>
  <text x="300" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#3B82F6" filter="url(#shadowText)">2/4</text>

  <!-- ==================== 右邊：3/4 ==================== -->
  <g filter="url(#shadow)">
    <circle cx="480" cy="180" r="72" fill="#FEF3C7" stroke="#FCD34D" stroke-width="2"/>
    <!-- 3/4 綠色扇形 -->
    <path d="M480,180 L480,110 A70,70 0 0,1 550,180 Z" fill="url(#gradGreen)" stroke="#059669" stroke-width="1.5"/>
    <path d="M480,180 L550,180 A70,70 0 0,1 480,250 Z" fill="url(#gradGreen)" stroke="#059669" stroke-width="1.5"/>
    <path d="M480,180 L480,250 A70,70 0 0,1 410,180 Z" fill="url(#gradGreen)" stroke="#059669" stroke-width="1.5"/>
    <!-- 分隔線 -->
    <line x1="480" y1="110" x2="480" y2="250" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
    <line x1="410" y1="180" x2="550" y2="180" stroke="#D1D5DB" stroke-width="1.5" stroke-dasharray="4,3"/>
  </g>
  <text x="480" y="285" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#10B981" filter="url(#shadowText)">3/4</text>

  <!-- ==================== 運算符號 ==================== -->
  <!-- 加號 -->
  <text x="210" y="185" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="32" font-weight="bold" fill="#F59E0B" filter="url(#shadowText)">+</text>
  <!-- 等號 -->
  <text x="390" y="185" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="32" font-weight="bold" fill="#F59E0B" filter="url(#shadowText)">=</text>

  <!-- ==================== 箭頭連接（顯示過程） ==================== -->
  <!-- 上方箭頭：1/4 → 3/4 -->
  <path d="M155,130 C200,95 250,95 295,130" fill="none" stroke="#EF4444" stroke-width="2.5" stroke-dasharray="6,4" marker-end="url(#arrowRed)" opacity="0.7"/>
  <text x="225" y="105" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#EF4444" opacity="0.8">加上</text>

  <!-- 上方箭頭：2/4 → 3/4 -->
  <path d="M335,130 C380,95 425,95 465,130" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-dasharray="6,4" marker-end="url(#arrowBlue)" opacity="0.7"/>
  <text x="400" y="105" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#3B82F6" opacity="0.8">加上</text>

  <!-- 下方箭頭：1/4 + 2/4 → 3/4 -->
  <path d="M120,255 C120,320 300,320 300,255" fill="none" stroke="#F59E0B" stroke-width="2" stroke-dasharray="5,4" marker-end="url(#arrowOrange)" opacity="0.5"/>

  <!-- ==================== 底部說明 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="120" y="320" width="360" height="50" rx="12" fill="white" stroke="#FCD34D" stroke-width="1.5" opacity="0.9"/>
    <text x="300" y="340" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4B5563">1/4 + 2/4 = 3/4</text>
    <text x="300" y="358" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#6B7280">分母不變，分子相加：1 + 2 = 3</text>
  </g>

  <!-- 裝飾小點 -->
  <circle cx="40" cy="360" r="4" fill="#F59E0B" opacity="0.3"/>
  <circle cx="560" cy="360" r="4" fill="#F59E0B" opacity="0.3"/>
  <circle cx="40" cy="40" r="4" fill="#F59E0B" opacity="0.3"/>
  <circle cx="560" cy="40" r="4" fill="#F59E0B" opacity="0.3"/>
</svg>