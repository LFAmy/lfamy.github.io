<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400">
  <defs>
    <!-- 背景漸變 -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFF8E1;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FFECB3;stop-opacity:1"/>
    </linearGradient>
    <!-- 地板漸變 -->
    <linearGradient id="floorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#E8D5B7;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#D4B896;stop-opacity:1"/>
    </linearGradient>
    <!-- 牆壁漸變 -->
    <linearGradient id="wallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFF3E0;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FFE0B2;stop-opacity:1"/>
    </linearGradient>
    <!-- 桌子漸變 -->
    <linearGradient id="tableGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#D7A86E;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#C4945A;stop-opacity:1"/>
    </linearGradient>
    <!-- 量杯漸變 -->
    <linearGradient id="cupGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#E3F2FD;stop-opacity:0.8"/>
      <stop offset="100%" style="stop-color:#BBDEFB;stop-opacity:0.8"/>
    </linearGradient>
    <!-- 磅秤漸變 -->
    <linearGradient id="scaleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#90A4AE;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#78909C;stop-opacity:1"/>
    </linearGradient>
    <!-- 食譜漸變 -->
    <linearGradient id="recipeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFF9C4;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FFF176;stop-opacity:1"/>
    </linearGradient>
    <!-- 烤箱漸變 -->
    <linearGradient id="ovenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#8D6E63;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#6D4C41;stop-opacity:1"/>
    </linearGradient>
    <!-- 碗漸變 -->
    <radialGradient id="bowlGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#E0E0E0;stop-opacity:1"/>
    </radialGradient>
    <!-- 麵糊漸變 -->
    <radialGradient id="batterGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#FFF176;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#FFD54F;stop-opacity:1"/>
    </radialGradient>
    <!-- 窗戶漸變 -->
    <linearGradient id="windowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#B3E5FC;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#81D4FA;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect x="0" y="0" width="800" height="400" fill="url(#bgGrad)"/>

  <!-- 牆壁 -->
  <rect x="0" y="0" width="800" height="280" fill="url(#wallGrad)"/>

  <!-- 地板 -->
  <rect x="0" y="280" width="800" height="120" fill="url(#floorGrad)"/>
  <!-- 地板線條 -->
  <line x1="0" y1="310" x2="800" y2="310" stroke="#C4A882" stroke-width="1" opacity="0.5"/>
  <line x1="0" y1="340" x2="800" y2="340" stroke="#C4A882" stroke-width="1" opacity="0.5"/>
  <line x1="0" y1="370" x2="800" y2="370" stroke="#C4A882" stroke-width="1" opacity="0.5"/>

  <!-- 窗戶 -->
  <rect x="50" y="60" width="120" height="140" rx="8" fill="url(#windowGrad)" stroke="#BCAAA4" stroke-width="4"/>
  <line x1="110" y1="60" x2="110" y2="200" stroke="#BCAAA4" stroke-width="3"/>
  <line x1="50" y1="130" x2="170" y2="130" stroke="#BCAAA4" stroke-width="3"/>
  <!-- 窗簾 -->
  <path d="M40 55 Q55 100 45 150" stroke="#EF9A9A" stroke-width="6" fill="none" stroke-linecap="round"/>
  <path d="M180 55 Q165 100 175 150" stroke="#EF9A9A" stroke-width="6" fill="none" stroke-linecap="round"/>
  <!-- 窗簾頭 -->
  <rect x="38" y="52" width="144" height="12" rx="6" fill="#E57373"/>

  <!-- 吊櫃 -->
  <rect x="620" y="50" width="150" height="130" rx="8" fill="#A1887F" stroke="#8D6E63" stroke-width="3"/>
  <rect x="628" y="58" width="65" height="114" rx="4" fill="#BCA68F" stroke="#8D6E63" stroke-width="2"/>
  <rect x="699" y="58" width="65" height="114" rx="4" fill="#BCA68F" stroke="#8D6E63" stroke-width="2"/>
  <!-- 櫃門把手 -->
  <circle cx="660" cy="115" r="4" fill="#8D6E63"/>
  <circle cx="731" cy="115" r="4" fill="#8D6E63"/>

  <!-- 廚房桌子 -->
  <rect x="200" y="230" width="400" height="20" rx="5" fill="url(#tableGrad)" stroke="#B8864E" stroke-width="2"/>
  <!-- 桌腳 -->
  <rect x="210" y="250" width="12" height="60" rx="3" fill="#C4945A"/>
  <rect x="578" y="250" width="12" height="60" rx="3" fill="#C4945A"/>

  <!-- 烤箱（背景） -->
  <rect x="580" y="180" width="100" height="90" rx="6" fill="url(#ovenGrad)" stroke="#5D4037" stroke-width="3"/>
  <rect x="590" y="190" width="80" height="45" rx="4" fill="#1A1A1A"/>
  <!-- 烤箱內部發光 -->
  <rect x="594" y="194" width="72" height="37" rx="3" fill="#FF6F00" opacity="0.4"/>
  <!-- 烤箱門把手 -->
  <rect x="615" y="238" width="30" height="6" rx="3" fill="#FF8A65"/>
  <!-- 烤箱旋鈕 -->
  <circle cx="610" cy="260" r="5" fill="#FF8A65"/>
  <circle cx="630" cy="260" r="5" fill="#FF8A65"/>
  <circle cx="650" cy="260" r="5" fill="#FF8A65"/>

  <!-- 食譜（放在桌上，左側） -->
  <rect x="220" y="195" width="70" height="50" rx="4" fill="url(#recipeGrad)" stroke="#F9A825" stroke-width="2" transform="rotate(-5, 255, 220)"/>
  <rect x="225" y="200" width="60" height="3" rx="1.5" fill="#F57F17" opacity="0.6" transform="rotate(-5, 255, 220)"/>
  <rect x="225" y="208" width="50" height="3" rx="1.5" fill="#F57F17" opacity="0.6" transform="rotate(-5, 255, 220)"/>
  <rect x="225" y="216" width="55" height="3" rx="1.5" fill="#F57F17" opacity="0.6" transform="rotate(-5, 255, 220)"/>
  <rect x="225" y="224" width="40" height="3" rx="1.5" fill="#F57F17" opacity="0.6" transform="rotate(-5, 255, 220)"/>
  <!-- 食譜上的分數 1/2 -->
  <text x="240" y="232" font-size="12" fill="#E65100" font-weight="bold" transform="rotate(-5, 255, 220)">½</text>

  <!-- 量杯（放在桌上） -->
  <path d="M310 210 L315 245 L345 245 L350 210 Z" fill="url(#cupGrad)" stroke="#64B5F6" stroke-width="2"/>
  <ellipse cx="330" cy="210" rx="20" ry="5" fill="url(#cupGrad)" stroke="#64B5F6" stroke-width="2"/>
  <!-- 量杯刻度 -->
  <line x1="318" y1="225" x2="328" y2="225" stroke="#1976D2" stroke-width="1.5"/>
  <line x1="318" y1="232" x2="328" y2="232" stroke="#1976D2" stroke-width="1.5"/>
  <!-- 量杯中的液體 -->
  <ellipse cx="330" cy="220" rx="16" ry="4" fill="#FF8A65" opacity="0.7"/>
  <path d="M314 220 Q330 230 346 220" fill="#FF8A65" opacity="0.5"/>
  <!-- 量杯把手 -->
  <path d="M350 218 Q362 218 362 230 Q362 242 350 242" fill="none" stroke="#64B5F6" stroke-width="2.5" stroke-linecap="round"/>

  <!-- 磅秤（放在桌上） -->
  <ellipse cx="430" cy="245" rx="30" ry="8" fill="#78909C"/>
  <rect x="415" y="220" width="30" height="25" rx="3" fill="url(#scaleGrad)" stroke="#546E7A" stroke-width="2"/>
  <!-- 磅秤圓盤 -->
  <circle cx="430" cy="235" r="15" fill="#ECEFF1" stroke="#546E7A" stroke-width="1.5"/>
  <!-- 磅秤指針 -->
  <line x1="430" y1="235" x2="430" y2="223" stroke="#E53935" stroke-width="2" stroke-linecap="round"/>
  <circle cx="430" cy="235" r="2.5" fill="#E53935"/>
  <!-- 磅秤刻度 -->
  <line x1="418" y1="233" x2="421" y2="233" stroke="#546E7A" stroke-width="1"/>
  <line x1="418" y1="237" x2="421" y2="237" stroke="#546E7A" stroke-width="1"/>
  <line x1="439" y1="233" x2="442" y2="233" stroke="#546E7A" stroke-width="1"/>
  <line x1="439" y1="237" x2="442" y2="237" stroke="#546E7A" stroke-width="1"/>
  <!-- 磅秤上的分數 -->
  <text x="425" y="228" font-size="8" fill="#E53935" font-weight="bold">½</text>

  <!-- 攪拌碗（放在桌上） -->
  <ellipse cx="500" cy="230" rx="28" ry="10" fill="url(#bowlGrad)" stroke="#BDBDBD" stroke-width="2"/>
  <path d="M472 230 Q472 255 500 260 Q528 255 528 230" fill="url(#bowlGrad)" stroke="#BDBDBD" stroke-width="2"/>
  <!-- 碗中的麵糊 -->
  <ellipse cx="500" cy="232" rx="22" ry="7" fill="url(#batterGrad)"/>
  <!-- 攪拌棒 -->
  <line x1="490" y1="215" x2="510" y2="235" stroke="#8D6E63" stroke-width="3" stroke-linecap="round"/>
  <ellipse cx="512" cy="237" rx="4" ry="6" fill="#A1887F" transform="rotate(30, 512, 237)"/>

  <!-- 雞蛋（在桌上） -->
  <ellipse cx="545" cy="238" rx="6" ry="8" fill="#FFF9C4" stroke="#F9A825" stroke-width="1" transform="rotate(-15, 545, 238)"/>
  <ellipse cx="558" cy="240" rx="6" ry="8" fill="#FFF9C4" stroke="#F9A825" stroke-width="1" transform="rotate(10, 558, 240)"/>

  <!-- 麵粉袋（在桌上） -->
  <rect x="555" y="215" width="25" height="30" rx="3" fill="#E8E0D0" stroke="#BCAAA4" stroke-width="1.5"/>
  <text x="560" y="233" font-size="8" fill="#8D6E63">麵粉</text>

  <!-- 媽媽角色 -->
  <g transform="translate(280, 140)">
    <!-- 身體（圍裙） -->
    <rect x="-25" y="30" width="50" height="65" rx="12" fill="#FF8A80"/>
    <!-- 圍裙帶子 -->
    <path d="M-25 50 Q-35 55 -35 65" stroke="#FF5252" stroke-width="3" fill="none"/>
    <path d="M25 50 Q35 55 35 65" stroke="#FF5252" stroke-width="3" fill="none"/>
    <!-- 圍裙口袋 -->
    <rect x="-10" y="55" width="20" height="15" rx="4" fill="#FF5252"/>
    <!-- 手臂（左，拿攪拌棒） -->
    <path d="M-25 40 Q-50 35 -55 50 Q-58 58 -50 60" stroke="#FFCCBC" stroke-width="10" fill="none" stroke-linecap="round"/>
    <!-- 手臂（右） -->
    <path d="M25 40 Q45 30 50 40" stroke="#FFCCBC" stroke-width="10" fill="none" stroke-linecap="round"/>
    <!-- 頭 -->
    <circle cx="0" cy="10" r="22" fill="#FFCCBC"/>
    <!-- 頭髮 -->
    <path d="M-22 5 Q-22 -15 -10 -20 Q0 -24 10 -20 Q22 -15 22 5" fill="#5D4037"/>
    <path d="M-22 5 Q-25 10 -24 15" stroke="#5D4037" stroke-width="5" fill="none" stroke-linecap="round"/>
    <path d="M22 5 Q25 10 24 15" stroke="#5D4037" stroke-width="5" fill="none" stroke-linecap="round"/>
    <!-- 馬尾 -->
    <path d="M15 -15 Q25 -25 20 -10 Q28 -20 22 -5" stroke="#5D4037" stroke-width="6" fill="none" stroke-linecap="round"/>
    <!-- 眼睛 -->
    <circle cx="-7" cy="8" r="3" fill="#3E2723"/>
    <circle cx="7" cy="8" r="3" fill="#3E2723"/>
    <!-- 眼睛高光 -->
    <circle cx="-6" cy="7" r="1" fill="white"/>
    <circle cx="8" cy="7" r="1" fill="white"/>
    <!-- 微笑 -->
    <path d="M-6 15 Q0 22 6 15" stroke="#3E2723" stroke-width="2" fill="none" stroke-linecap="round"/>
    <!-- 腮紅 -->
    <ellipse cx="-13" cy="14" rx="4" ry="2.5" fill="#FF8A80" opacity="0.5"/>
    <ellipse cx="13" cy="14" rx="4" ry="2.5" fill="#FF8A80" opacity="0.5"/>
  </g>

  <!-- 小朋友角色 -->
  <g transform="translate(420, 160)">
    <!-- 身體 -->
    <rect x="-20" y="20" width="40" height="50" rx="10" fill="#FF8A65"/>
    <!-- 衣服圖案 -->
    <circle cx="-5" cy="35" r="3" fill="#FFE082"/>
    <circle cx="5" cy="35" r="3" fill="#FFE082"/>
    <circle cx="0" cy="45" r="3" fill="#FFE082"/>
    <!-- 手臂（左，指向食譜） -->
    <path d="M-20 30 Q-35 25 -40 15" stroke="#FFCCBC" stroke-width="8" fill="none" stroke-linecap="round"/>
    <!-- 手臂（右） -->
    <path d="M20 30 Q35 28 38 35" stroke="#FFCCBC" stroke-width="8" fill="none" stroke-linecap="round"/>
    <!-- 頭 -->
    <circle cx="0" cy="5" r="18" fill="#FFCCBC"/>
    <!-- 頭髮 -->
    <path d="M-18 0 Q-18 -18 0 -20 Q18 -18 18 0" fill="#4E342E"/>
    <path d="M-18 0 Q-20 5 -18 10" stroke="#4E342E" stroke-width="4" fill="none" stroke-linecap="round"/>
    <path d="M18 0 Q20 5 18 10" stroke="#4E342E" stroke-width="4" fill="none" stroke-linecap="round"/>
    <!-- 瀏海 -->
    <path d="M-10 -15 Q-5 -20 0 -15 Q5 -20 10 -15" fill="#4E342E"/>
    <!-- 眼睛（大而可愛） -->
    <circle cx="-6" cy="3" r="4" fill="#3E2723"/>
    <circle cx="6" cy="3" r="4" fill="#3E2723"/>
    <!-- 眼睛高光 -->
    <circle cx="-5" cy="2" r="1.5" fill="white"/>
    <circle cx="7" cy="2" r="1.5" fill="white"/>
    <!-- 微笑 -->
    <path d="M-4 10 Q0 16 4 10" stroke="#3E2723" stroke-width="2" fill="none" stroke-linecap="round"/>
    <!-- 腮紅 -->
    <ellipse cx="-11" cy="9" rx="3.5" ry="2" fill="#FF8A80" opacity="0.5"/>
    <ellipse cx="11" cy="9" rx="3.5" ry="2" fill="#FF8A80" opacity="0.5"/>
  </g>

  <!-- 頭頂愛心（小朋友上方） -->
  <path d="M440 135 Q443 128 448 133 Q453 128 456 135 Q456 142 448 148 Q440 142 440 135Z" fill="#E57373" opacity="0.8"/>

  <!-- 餐具架（牆上） -->
  <rect x="350" y="80" width="80" height="10" rx="3" fill="#BCAAA4"/>
  <!-- 掛鉤 -->
  <circle cx="370" cy="85" r="3" fill="#8D6E63"/>
  <circle cx="400" cy="85" r="3" fill="#8D6E63"/>
  <circle cx="430" cy="85" r="3" fill="#8D6E63"/>
  <!-- 掛著的鏟子 -->
  <line x1="370" y1="88" x2="370" y2="110" stroke="#8D6E63" stroke-width="2"/>
  <ellipse cx="370" cy="115" rx="6" ry="8" fill="#90A4AE"/>
  <!-- 掛著的打蛋器 -->
  <line x1="400" y1="88" x2="400" y2="108" stroke="#8D6E63" stroke-width="2"/>
  <path d="M394 108 Q400 118 406 108" stroke="#90A4AE" stroke-width="2" fill="none"/>
  <line x1="396" y1="110" x2="404" y2="110" stroke="#90A4AE" stroke-width="1.5"/>

  <!-- 牆上裝飾畫 -->
  <rect x="460" y="70" width="60" height="50" rx="5" fill="#FFF9C4" stroke="#BCAAA4" stroke-width="2"/>
  <circle cx="490" cy="95" r="12" fill="#FF8A65"/>
  <path d="M478 95 Q490 80 502 95" fill="#66BB6A"/>

  <!-- 地上小貓 -->
  <g transform="translate(150, 310)">
    <ellipse cx="0" cy="10" rx="15" ry="12" fill="#FFCCBC"/>
    <circle cx="0" cy="-2" r="10" fill="#FFCCBC"/>
    <!-- 耳朵 -->
    <path d="M-8 -10 L-5 -20 L-1 -10" fill="#FFCCBC" stroke="#FFAB91" stroke-width="1"/>
    <path d="M8 -10 L5 -20 L1 -10" fill="#FFCCBC" stroke="#FFAB91" stroke-width="1"/>
    <!-- 眼睛 -->
    <circle cx="-4" cy="-4" r="2" fill="#3E2723"/>
    <circle cx="4" cy="-4" r="2" fill="#3E2723"/>
    <!-- 鼻子 -->
    <circle cx="0" cy="-1" r="1.5" fill="#FF8A80"/>
    <!-- 鬍鬚 -->
    <line x1="-12" y1="-2" x2="-5" y2="-1" stroke="#BCAAA4" stroke-width="0.8"/>
    <line x1="-12" y1="0" x2="-5" y2="0" stroke="#BCAAA4" stroke-width="0.8"/>
    <line x1="12" y1="-2" x2="5" y2="-1" stroke="#BCAAA4" stroke-width="0.8"/>
    <line x1="12" y1="0" x2="5" y2="0" stroke="#BCAAA4" stroke-width="0.8"/>
    <!-- 尾巴 -->
    <path d="M15 15 Q25 10 22 0" stroke="#FFCCBC" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>

  <!-- 牆上時鐘 -->
  <circle cx="700" cy="130" r="20" fill="#FFF9C4" stroke="#8D6E63" stroke-width="3"/>
  <circle cx="700" cy="130" r="2" fill="#8D6E63"/>
  <line x1="700" y1="130" x2="700" y2="117" stroke="#8D6E63" stroke-width="2" stroke-linecap="round"/>
  <line x1="700" y1="130" x2="710" y2="130" stroke="#8D6E63" stroke-width="1.5" stroke-linecap="round"/>

  <!-- 調味罐（桌上） -->
  <rect x="240" y="218" width="10" height="15" rx="2" fill="#E8E0D0" stroke="#BCAAA4" stroke-width="1"/>
  <rect x="255" y="218" width="10" height="15" rx="2" fill="#E8E0D0" stroke="#BCAAA4" stroke-width="1"/>

  <!-- 糖罐（桌上） -->
  <rect x="320" y="195" width="18" height="22" rx="4" fill="#FFF9C4" stroke="#F9A825" stroke-width="1.5"/>
  <rect x="323" y="192" width="12" height="5" rx="2" fill="#F9A825"/>

  <!-- 小裝飾：星星（小朋友周圍） -->
  <text x="460" y="150" font-size="12" fill="#FFD54F">✦</text>
  <text x="380" y="165" font-size="8" fill="#FFD54F">✦</text>
  <text x="470" y="180" font-size="10" fill="#FFD54F">✦</text>
</svg>