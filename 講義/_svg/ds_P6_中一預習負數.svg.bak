<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    
    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#F97316"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="16"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">📐 中一預習：負數加減法</text>
  <line x1="140" y1="50" x2="460" y2="50" stroke="#4F46E5" stroke-width="2" opacity="0.3"/>

  <!-- ==================== 第一部分：數線 ==================== -->
  <g transform="translate(50, 90)">
    <!-- 數線主軸 -->
    <line x1="0" y1="30" x2="500" y2="30" stroke="#374151" stroke-width="2.5" stroke-linecap="round"/>
    
    <!-- 刻度與數字 -->
    <g font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4B5563" text-anchor="middle">
      <!-- 負數刻度（藍色） -->
      <g fill="#4F46E5" font-weight="bold">
        <line x1="0" y1="22" x2="0" y2="38" stroke="#4F46E5" stroke-width="2"/>
        <text x="0" y="52">-10</text>
        <line x1="50" y1="22" x2="50" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="50" y="52">-9</text>
        <line x1="100" y1="22" x2="100" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="100" y="52">-8</text>
        <line x1="150" y1="22" x2="150" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="150" y="52">-7</text>
        <line x1="200" y1="22" x2="200" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="200" y="52">-6</text>
        <line x1="250" y1="22" x2="250" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="250" y="52">-5</text>
        <line x1="300" y1="22" x2="300" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="300" y="52">-4</text>
        <line x1="350" y1="22" x2="350" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="350" y="52">-3</text>
        <line x1="400" y1="22" x2="400" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="400" y="52">-2</text>
        <line x1="450" y1="22" x2="450" y2="38" stroke="#4F46E5" stroke-width="1.5"/>
        <text x="450" y="52">-1</text>
      </g>
      
      <!-- 0（中性） -->
      <line x1="500" y1="22" x2="500" y2="38" stroke="#374151" stroke-width="2.5"/>
      <text x="500" y="52" fill="#374151" font-weight="bold">0</text>
      
      <!-- 正數刻度（橙色） -->
      <g fill="#F59E0B" font-weight="bold">
        <line x1="550" y1="22" x2="550" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="550" y="52">+1</text>
        <line x1="600" y1="22" x2="600" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="600" y="52">+2</text>
        <line x1="650" y1="22" x2="650" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="650" y="52">+3</text>
        <line x1="700" y1="22" x2="700" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="700" y="52">+4</text>
        <line x1="750" y1="22" x2="750" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="750" y="52">+5</text>
        <line x1="800" y1="22" x2="800" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="800" y="52">+6</text>
        <line x1="850" y1="22" x2="850" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="850" y="52">+7</text>
        <line x1="900" y1="22" x2="900" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="900" y="52">+8</text>
        <line x1="950" y1="22" x2="950" y2="38" stroke="#F59E0B" stroke-width="1.5"/>
        <text x="950" y="52">+9</text>
        <line x1="1000" y1="22" x2="1000" y2="38" stroke="#F59E0B" stroke-width="2"/>
        <text x="1000" y="52">+10</text>
      </g>
    </g>

    <!-- 數線標籤：負數區 / 正數區 -->
    <text x="180" y="72" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4F46E5" opacity="0.7">負數區</text>
    <text x="780" y="72" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#F59E0B" opacity="0.7">正數區</text>
  </g>

  <!-- ==================== 第二部分：例題一 (-3) + 5 = 2 ==================== -->
  <g transform="translate(30, 180)">
    <!-- 卡片背景 -->
    <rect x="0" y="0" width="260" height="100" rx="12" fill="white" filter="url(#shadowLight)"/>
    
    <!-- 標題 -->
    <text x="130" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#1F2937">例題一</text>
    
    <!-- 算式 -->
    <text x="130" y="48" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#1F2937">
      (-3) + 5 = 2
    </text>
    
    <!-- 數線示意（小） -->
    <g transform="translate(10, 58)">
      <line x1="0" y1="12" x2="240" y2="12" stroke="#D1D5DB" stroke-width="1.5"/>
      
      <!-- 刻度：-3 到 2 -->
      <g font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" text-anchor="middle" fill="#6B7280">
        <text x="0" y="28">-3</text>
        <text x="48" y="28">-2</text>
        <text x="96" y="28">-1</text>
        <text x="144" y="28">0</text>
        <text x="192" y="28">+1</text>
        <text x="240" y="28">+2</text>
      </g>
      
      <!-- 起點 -3（藍色圓點） -->
      <circle cx="0" cy="12" r="5" fill="#4F46E5"/>
      
      <!-- 箭頭 +5（橙色） -->
      <line x1="0" y1="12" x2="240" y2="12" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrowOrange)"/>
      
      <!-- 終點 +2（綠色圓點） -->
      <circle cx="240" cy="12" r="5" fill="#10B981"/>
      
      <!-- 標籤 -->
      <text x="120" y="-6" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#F59E0B">+5</text>
      <text x="0" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#4F46E5">起點</text>
      <text x="240" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#10B981">終點</text>
    </g>
  </g>

  <!-- ==================== 第三部分：例題二 (-3) - 2 = (-5) ==================== -->
  <g transform="translate(310, 180)">
    <!-- 卡片背景 -->
    <rect x="0" y="0" width="260" height="100" rx="12" fill="white" filter="url(#shadowLight)"/>
    
    <!-- 標題 -->
    <text x="130" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#1F2937">例題二</text>
    
    <!-- 算式 -->
    <text x="130" y="48" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="20" font-weight="bold" fill="#1F2937">
      (-3) - 2 = (-5)
    </text>
    
    <!-- 數線示意（小） -->
    <g transform="translate(10, 58)">
      <line x1="0" y1="12" x2="240" y2="12" stroke="#D1D5DB" stroke-width="1.5"/>
      
      <!-- 刻度：-5 到 0 -->
      <g font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" text-anchor="middle" fill="#6B7280">
        <text x="0" y="28">-5</text>
        <text x="48" y="28">-4</text>
        <text x="96" y="28">-3</text>
        <text x="144" y="28">-2</text>
        <text x="192" y="28">-1</text>
        <text x="240" y="28">0</text>
      </g>
      
      <!-- 起點 -3（藍色圓點） -->
      <circle cx="96" cy="12" r="5" fill="#4F46E5"/>
      
      <!-- 箭頭 -2（向左，綠色） -->
      <line x1="96" y1="12" x2="0" y2="12" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowGreen)"/>
      
      <!-- 終點 -5（橙色圓點） -->
      <circle cx="0" cy="12" r="5" fill="#F59E0B"/>
      
      <!-- 標籤 -->
      <text x="48" y="-6" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#10B981">-2</text>
      <text x="96" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#4F46E5">起點</text>
      <text x="0" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="8" fill="#F59E0B">終點</text>
    </g>
  </g>

  <!-- ==================== 第四部分：重點總結 ==================== -->
  <g transform="translate(50, 305)">
    <rect x="0" y="0" width="500" height="75" rx="12" fill="white" filter="url(#shadow)"/>
    
    <!-- 標題 -->
    <text x="250" y="22" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#1F2937">📌 重點總結</text>
    
    <!-- 規則 -->
    <text x="30" y="46" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#4F46E5" font-weight="bold">① 加正數 → 向右移</text>
    <text x="200" y="46" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#10B981" font-weight="bold">② 減正數 → 向左移</text>
    <text x="370" y="46" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#F59E0B" font-weight="bold">③ 負數可視為向左移動</text>
    
    <text x="30" y="65" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">(-3) + 5 = 2</text>
    <text x="200" y="65" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">(-3) - 2 = (-5)</text>
    <text x="370" y="65" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">數線幫助理解方向</text>
  </g>
</svg>