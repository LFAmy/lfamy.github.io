<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    <filter id="shadowInner" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#00000015"/>
    </filter>

    <!-- 漸變色 -->
    <linearGradient id="gradClock" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
    <linearGradient id="gradPrimary" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366F1"/>
      <stop offset="100%" stop-color="#4F46E5"/>
    </linearGradient>
    <linearGradient id="gradAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradSuccess" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="gradCard" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F9FAFB"/>
    </linearGradient>

    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" rx="16" fill="#F9FAFB"/>

  <!-- 標題 -->
  <text x="300" y="36" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">🕐 時間與時刻</text>

  <!-- ============ 左側：時鐘 ============ -->
  <g transform="translate(155, 220)">
    <!-- 時鐘外框 -->
    <circle cx="0" cy="0" r="110" fill="url(#gradClock)" stroke="#E5E7EB" stroke-width="2" filter="url(#shadow)"/>
    <circle cx="0" cy="0" r="104" fill="none" stroke="#E5E7EB" stroke-width="1"/>

    <!-- 刻度 - 小時 -->
    <g stroke="#374151" stroke-width="2.5">
      <line x1="0" y1="-95" x2="0" y2="-80"/>
      <line x1="0" y1="95" x2="0" y2="80"/>
      <line x1="-95" y1="0" x2="-80" y2="0"/>
      <line x1="95" y1="0" x2="80" y2="0"/>
    </g>
    <!-- 刻度 - 其他小時 -->
    <g stroke="#9CA3AF" stroke-width="1.5">
      <line x1="47.5" y1="-82.3" x2="40" y2="-69.3"/>
      <line x1="82.3" y1="-47.5" x2="69.3" y2="-40"/>
      <line x1="82.3" y1="47.5" x2="69.3" y2="40"/>
      <line x1="47.5" y1="82.3" x2="40" y2="69.3"/>
      <line x1="-47.5" y1="-82.3" x2="-40" y2="-69.3"/>
      <line x1="-82.3" y1="-47.5" x2="-69.3" y2="-40"/>
      <line x1="-82.3" y1="47.5" x2="-69.3" y2="40"/>
      <line x1="-47.5" y1="82.3" x2="-40" y2="69.3"/>
    </g>

    <!-- 數字 12, 3, 6, 9 -->
    <text x="0" y="-88" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#1F2937">12</text>
    <text x="88" y="5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#1F2937">3</text>
    <text x="0" y="98" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#1F2937">6</text>
    <text x="-88" y="5" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#1F2937">9</text>

    <!-- 數字 1,2,4,5,7,8,10,11 -->
    <g font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#6B7280" text-anchor="middle">
      <text x="42" y="-72">1</text>
      <text x="72" y="-42">2</text>
      <text x="72" y="48">4</text>
      <text x="42" y="78">5</text>
      <text x="-42" y="-72">11</text>
      <text x="-72" y="-42">10</text>
      <text x="-72" y="48">8</text>
      <text x="-42" y="78">7</text>
    </g>

    <!-- 時針 (指向 3:00) -->
    <g transform="rotate(90)">
      <polygon points="-5,10 0,-65 5,10" fill="url(#gradPrimary)" filter="url(#shadowLight)"/>
    </g>

    <!-- 分針 (指向 12:00) -->
    <polygon points="-3,12 0,-90 3,12" fill="url(#gradAccent)" filter="url(#shadowLight)"/>

    <!-- 中心圓點 -->
    <circle cx="0" cy="0" r="6" fill="#4F46E5"/>
    <circle cx="0" cy="0" r="3" fill="#FFFFFF"/>

    <!-- 時間標籤 -->
    <text x="0" y="130" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#4F46E5" font-weight="bold">3:00</text>
  </g>

  <!-- ============ 右側：時間加減法視覺化 ============ -->
  <g transform="translate(420, 80)">
    <!-- 卡片背景 -->
    <rect x="-115" y="-20" width="230" height="280" rx="12" fill="url(#gradCard)" stroke="#E5E7EB" stroke-width="1" filter="url(#shadow)"/>

    <!-- 標題 -->
    <text x="0" y="8" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#1F2937">時間加減法</text>

    <!-- 分隔線 -->
    <line x1="-90" y1="20" x2="90" y2="20" stroke="#E5E7EB" stroke-width="1"/>

    <!-- 加法示例 -->
    <text x="-90" y="48" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">加法 +</text>

    <!-- 時間條 1: 2:00 -->
    <rect x="-90" y="58" width="60" height="24" rx="6" fill="#D1FAE5" stroke="#10B981" stroke-width="1.5"/>
    <text x="-60" y="74" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#065F46" font-weight="bold">2:00</text>

    <!-- 加號 -->
    <text x="-20" y="74" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#10B981" font-weight="bold">+</text>

    <!-- 時間條 2: 1:30 -->
    <rect x="-5" y="58" width="60" height="24" rx="6" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5"/>
    <text x="25" y="74" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#92400E" font-weight="bold">1:30</text>

    <!-- 等號 -->
    <text x="65" y="74" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#10B981" font-weight="bold">=</text>

    <!-- 結果 -->
    <rect x="80" y="58" width="60" height="24" rx="6" fill="#D1FAE5" stroke="#10B981" stroke-width="2"/>
    <text x="110" y="74" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#065F46" font-weight="bold">3:30</text>

    <!-- 箭頭說明 -->
    <line x1="-60" y1="90" x2="25" y2="90" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)" stroke-dasharray="3,3"/>
    <text x="-18" y="104" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#10B981">加 1小時30分</text>

    <!-- 分隔線 -->
    <line x1="-90" y1="118" x2="90" y2="118" stroke="#E5E7EB" stroke-width="1"/>

    <!-- 減法示例 -->
    <text x="-90" y="146" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">減法 −</text>

    <!-- 時間條 1: 5:45 -->
    <rect x="-90" y="156" width="60" height="24" rx="6" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5"/>
    <text x="-60" y="172" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#92400E" font-weight="bold">5:45</text>

    <!-- 減號 -->
    <text x="-20" y="172" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#F59E0B" font-weight="bold">−</text>

    <!-- 時間條 2: 2:15 -->
    <rect x="-5" y="156" width="60" height="24" rx="6" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5"/>
    <text x="25" y="172" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#92400E" font-weight="bold">2:15</text>

    <!-- 等號 -->
    <text x="65" y="172" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#F59E0B" font-weight="bold">=</text>

    <!-- 結果 -->
    <rect x="80" y="156" width="60" height="24" rx="6" fill="#FEF3C7" stroke="#F59E0B" stroke-width="2"/>
    <text x="110" y="172" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#92400E" font-weight="bold">3:30</text>

    <!-- 箭頭說明 -->
    <line x1="-60" y1="188" x2="25" y2="188" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)" stroke-dasharray="3,3"/>
    <text x="-18" y="202" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#F59E0B">減 2小時15分</text>

    <!-- 分隔線 -->
    <line x1="-90" y1="216" x2="90" y2="216" stroke="#E5E7EB" stroke-width="1"/>

    <!-- 提示框 -->
    <rect x="-85" y="226" width="170" height="28" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
    <text x="0" y="244" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4F46E5">💡 時 + 時，分 + 分，滿60分進1時</text>
  </g>

  <!-- ============ 底部：時針分針關係 ============ -->
  <g transform="translate(300, 340)">
    <!-- 卡片背景 -->
    <rect x="-280" y="-30" width="560" height="55" rx="10" fill="url(#gradCard)" stroke="#E5E7EB" stroke-width="1" filter="url(#shadowLight)"/>

    <!-- 時針關係 -->
    <circle cx="-220" cy="-5" r="10" fill="url(#gradPrimary)" filter="url(#shadowLight)"/>
    <text x="-220" y="-1" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#FFFFFF" font-weight="bold">時</text>
    <text x="-195" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#374151">時針走1大格 = 1小時</text>

    <line x1="-140" y1="-5" x2="-120" y2="-5" stroke="#D1D5DB" stroke-width="1"/>

    <!-- 分針關係 -->
    <circle cx="-100" cy="-5" r="10" fill="url(#gradAccent)" filter="url(#shadowLight)"/>
    <text x="-100" y="-1" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#FFFFFF" font-weight="bold">分</text>
    <text x="-75" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#374151">分針走1小格 = 1分鐘</text>

    <line x1="-20" y1="-5" x2="0" y2="-5" stroke="#D1D5DB" stroke-width="1"/>

    <!-- 關係 -->
    <circle cx="20" cy="-5" r="10" fill="url(#gradPrimary)" filter="url(#shadowLight)"/>
    <text x="20" y="-1" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#FFFFFF" font-weight="bold">時</text>
    <text x="45" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#374151">時針走1大格</text>

    <text x="130" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#F59E0B" font-weight="bold">→</text>

    <text x="150" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#374151">分針走</text>
    <text x="195" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#F59E0B" font-weight="bold">60</text>
    <text x="210" y="-1" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#374151">小格 = 1圈</text>
  </g>

  <!-- 連接時鐘和說明的箭頭 -->
  <line x1="270" y1="170" x2="300" y2="170" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)" stroke-dasharray="4,3"/>
  <text x="285" y="163" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="9" fill="#4F46E5">時鐘</text>
</svg>