<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <!-- 背景漸變 -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFE8C8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FFD4A0;stop-opacity:1" />
    </linearGradient>
    <!-- 地板漸變 -->
    <linearGradient id="floorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F5E0C0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E8D0A8;stop-opacity:1" />
    </linearGradient>
    <!-- 貨架漸變 -->
    <linearGradient id="shelfGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#D4A574;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#B8864E;stop-opacity:1" />
    </linearGradient>
    <!-- 購物車漸變 -->
    <linearGradient id="cartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7CB8E8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5A9BD5;stop-opacity:1" />
    </linearGradient>
    <!-- 收銀機漸變 -->
    <linearGradient id="cashierGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#E8E0D0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#D0C8B0;stop-opacity:1" />
    </linearGradient>
    <!-- 顯示屏漸變 -->
    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#90EE90;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6BCB6B;stop-opacity:1" />
    </linearGradient>
    <!-- 蘋果漸變 -->
    <radialGradient id="appleGrad" cx="40%" cy="40%">
      <stop offset="0%" style="stop-color:#FF6B6B" />
      <stop offset="100%" style="stop-color:#E04040" />
    </radialGradient>
    <!-- 麵包漸變 -->
    <linearGradient id="breadGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F5D090" />
      <stop offset="100%" style="stop-color:#DBA85C" />
    </linearGradient>
    <!-- 牛奶盒漸變 -->
    <linearGradient id="milkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF" />
      <stop offset="100%" style="stop-color:#E8E8F0" />
    </linearGradient>
    <!-- 香蕉漸變 -->
    <linearGradient id="bananaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFE44D" />
      <stop offset="100%" style="stop-color:#F0C830" />
    </linearGradient>
    <!-- 收銀員漸變 -->
    <linearGradient id="cashierPersonGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD0A0" />
      <stop offset="100%" style="stop-color:#F0B880" />
    </linearGradient>
    <!-- 貨架陰影 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#B08050" flood-opacity="0.3"/>
    </filter>
    <filter id="softShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000030"/>
    </filter>
  </defs>

  <!-- 背景牆 -->
  <rect x="0" y="0" width="800" height="400" fill="url(#bgGrad)" rx="10"/>

  <!-- 地板 -->
  <rect x="0" y="300" width="800" height="100" fill="url(#floorGrad)" rx="0"/>
  <!-- 地板線條 -->
  <line x1="0" y1="320" x2="800" y2="320" stroke="#D4C0A0" stroke-width="1" opacity="0.5"/>
  <line x1="0" y1="340" x2="800" y2="340" stroke="#D4C0A0" stroke-width="1" opacity="0.5"/>
  <line x1="0" y1="360" x2="800" y2="360" stroke="#D4C0A0" stroke-width="1" opacity="0.5"/>
  <line x1="0" y1="380" x2="800" y2="380" stroke="#D4C0A0" stroke-width="1" opacity="0.5"/>

  <!-- 牆面裝飾線 -->
  <rect x="0" y="295" width="800" height="8" fill="#D4A574" rx="2" opacity="0.6"/>

  <!-- ======== 左側貨架 ======== -->
  <g filter="url(#shadow)">
    <!-- 貨架主體 -->
    <rect x="30" y="60" width="180" height="240" fill="url(#shelfGrad)" rx="8"/>
    <!-- 貨架層板 -->
    <rect x="30" y="60" width="180" height="8" fill="#C89860" rx="4"/>
    <rect x="30" y="140" width="180" height="8" fill="#C89860" rx="4"/>
    <rect x="30" y="220" width="180" height="8" fill="#C89860" rx="4"/>
    <!-- 貨架側板 -->
    <rect x="30" y="60" width="10" height="240" fill="#B08050" rx="3"/>
    <rect x="200" y="60" width="10" height="240" fill="#B08050" rx="3"/>

    <!-- 上層貨架 - 蘋果 -->
    <circle cx="75" cy="110" r="18" fill="url(#appleGrad)" filter="url(#softShadow)"/>
    <circle cx="75" cy="108" r="3" fill="#4A8C3F"/>
    <circle cx="110" cy="108" r="18" fill="url(#appleGrad)" filter="url(#softShadow)"/>
    <circle cx="110" cy="106" r="3" fill="#4A8C3F"/>
    <circle cx="145" cy="112" r="18" fill="url(#appleGrad)" filter="url(#softShadow)"/>
    <circle cx="145" cy="110" r="3" fill="#4A8C3F"/>
    <circle cx="180" cy="108" r="18" fill="url(#appleGrad)" filter="url(#softShadow)"/>
    <circle cx="180" cy="106" r="3" fill="#4A8C3F"/>

    <!-- 中層貨架 - 麵包 -->
    <rect x="55" y="165" width="45" height="35" rx="10" fill="url(#breadGrad)" filter="url(#softShadow)"/>
    <rect x="55" y="170" width="45" height="5" rx="2" fill="#E8C070"/>
    <rect x="110" y="165" width="45" height="35" rx="10" fill="url(#breadGrad)" filter="url(#softShadow)"/>
    <rect x="110" y="170" width="45" height="5" rx="2" fill="#E8C070"/>
    <rect x="165" y="168" width="40" height="30" rx="10" fill="url(#breadGrad)" filter="url(#softShadow)"/>
    <rect x="165" y="173" width="40" height="5" rx="2" fill="#E8C070"/>

    <!-- 下層貨架 - 牛奶盒 -->
    <rect x="55" y="245" width="30" height="40" rx="4" fill="url(#milkGrad)" filter="url(#softShadow)"/>
    <rect x="55" y="245" width="30" height="8" rx="2" fill="#D04040"/>
    <rect x="95" y="245" width="30" height="40" rx="4" fill="url(#milkGrad)" filter="url(#softShadow)"/>
    <rect x="95" y="245" width="30" height="8" rx="2" fill="#4080D0"/>
    <rect x="135" y="245" width="30" height="40" rx="4" fill="url(#milkGrad)" filter="url(#softShadow)"/>
    <rect x="135" y="245" width="30" height="8" rx="2" fill="#40D040"/>
    <rect x="175" y="248" width="25" height="35" rx="4" fill="url(#milkGrad)" filter="url(#softShadow)"/>
    <rect x="175" y="248" width="25" height="8" rx="2" fill="#D0A040"/>
  </g>

  <!-- ======== 右側貨架 ======== -->
  <g filter="url(#shadow)">
    <rect x="590" y="60" width="180" height="240" fill="url(#shelfGrad)" rx="8"/>
    <rect x="590" y="60" width="180" height="8" fill="#C89860" rx="4"/>
    <rect x="590" y="140" width="180" height="8" fill="#C89860" rx="4"/>
    <rect x="590" y="220" width="180" height="8" fill="#C89860" rx="4"/>
    <rect x="590" y="60" width="10" height="240" fill="#B08050" rx="3"/>
    <rect x="760" y="60" width="10" height="240" fill="#B08050" rx="3"/>

    <!-- 上層貨架 - 香蕉 -->
    <g filter="url(#softShadow)">
      <ellipse cx="640" cy="108" rx="22" ry="10" fill="url(#bananaGrad)" transform="rotate(-15,640,108)"/>
      <ellipse cx="680" cy="105" rx="22" ry="10" fill="url(#bananaGrad)" transform="rotate(5,680,105)"/>
      <ellipse cx="720" cy="110" rx="22" ry="10" fill="url(#bananaGrad)" transform="rotate(-10,720,110)"/>
    </g>

    <!-- 中層貨架 - 餅乾盒 -->
    <rect x="610" y="160" width="35" height="30" rx="5" fill="#F0A0A0" filter="url(#softShadow)"/>
    <rect x="610" y="160" width="35" height="6" rx="2" fill="#D08080"/>
    <rect x="655" y="160" width="35" height="30" rx="5" fill="#A0D0F0" filter="url(#softShadow)"/>
    <rect x="655" y="160" width="35" height="6" rx="2" fill="#80B0D0"/>
    <rect x="700" y="160" width="35" height="30" rx="5" fill="#F0D0A0" filter="url(#softShadow)"/>
    <rect x="700" y="160" width="35" height="6" rx="2" fill="#D0B080"/>

    <!-- 下層貨架 - 飲料罐 -->
    <rect x="610" y="240" width="25" height="45" rx="8" fill="#E06060" filter="url(#softShadow)"/>
    <rect x="610" y="240" width="25" height="8" rx="4" fill="#C04040"/>
    <rect x="645" y="240" width="25" height="45" rx="8" fill="#60A0E0" filter="url(#softShadow)"/>
    <rect x="645" y="240" width="25" height="8" rx="4" fill="#4080C0"/>
    <rect x="680" y="240" width="25" height="45" rx="8" fill="#60E060" filter="url(#softShadow)"/>
    <rect x="680" y="240" width="25" height="8" rx="4" fill="#40C040"/>
    <rect x="715" y="240" width="25" height="45" rx="8" fill="#E0E060" filter="url(#softShadow)"/>
    <rect x="715" y="240" width="25" height="8" rx="4" fill="#C0C040"/>
  </g>

  <!-- ======== 購物車 ======== -->
  <g filter="url(#shadow)">
    <!-- 車輪 -->
    <circle cx="380" cy="340" r="12" fill="#555" stroke="#333" stroke-width="2"/>
    <circle cx="380" cy="340" r="4" fill="#888"/>
    <circle cx="440" cy="340" r="12" fill="#555" stroke="#333" stroke-width="2"/>
    <circle cx="440" cy="340" r="4" fill="#888"/>
    
    <!-- 車籃 -->
    <path d="M350,260 L350,310 L470,310 L470,260 Z" fill="url(#cartGrad)" stroke="#4A8AB5" stroke-width="2" rx="5"/>
    <rect x="350" y="260" width="120" height="50" fill="url(#cartGrad)" stroke="#4A8AB5" stroke-width="2" rx="5"/>
    
    <!-- 車籃網格 -->
    <line x1="370" y1="260" x2="370" y2="310" stroke="#6AAAD5" stroke-width="1" opacity="0.5"/>
    <line x1="390" y1="260" x2="390" y2="310" stroke="#6AAAD5" stroke-width="1" opacity="0.5"/>
    <line x1="410" y1="260" x2="410" y2="310" stroke="#6AAAD5" stroke-width="1" opacity="0.5"/>
    <line x1="430" y1="260" x2="430" y2="310" stroke="#6AAAD5" stroke-width="1" opacity="0.5"/>
    <line x1="450" y1="260" x2="450" y2="310" stroke="#6AAAD5" stroke-width="1" opacity="0.5"/>
    
    <!-- 把手 -->
    <path d="M355,260 Q355,240 370,240 L450,240 Q465,240 465,260" fill="none" stroke="#4A8AB5" stroke-width="4" stroke-linecap="round"/>

    <!-- 購物車內的食物 -->
    <!-- 麵包 -->
    <rect x="365" y="268" width="30" height="20" rx="8" fill="url(#breadGrad)" stroke="#DBA85C" stroke-width="1"/>
    <!-- 蘋果 -->
    <circle cx="420" cy="278" r="12" fill="url(#appleGrad)"/>
    <circle cx="420" cy="276" r="2" fill="#4A8C3F"/>
    <!-- 香蕉 -->
    <ellipse cx="445" cy="280" rx="14" ry="7" fill="url(#bananaGrad)" transform="rotate(10,445,280)"/>
    <!-- 牛奶盒 -->
    <rect x="385" y="272" width="18" height="24" rx="3" fill="url(#milkGrad)" stroke="#CCC" stroke-width="0.5"/>
    <rect x="385" y="272" width="18" height="5" rx="2" fill="#D04040"/>
    <!-- 餅乾 -->
    <rect x="405" y="275" width="15" height="12" rx="3" fill="#F0A0A0"/>
  </g>

  <!-- ======== 收銀機 ======== -->
  <g filter="url(#shadow)">
    <!-- 收銀機底座 -->
    <rect x="520" y="260" width="100" height="60" rx="8" fill="url(#cashierGrad)" stroke="#B0A890" stroke-width="2"/>
    
    <!-- 收銀機顯示屏 -->
    <rect x="530" y="220" width="80" height="50" rx="6" fill="url(#screenGrad)" stroke="#5AAA5A" stroke-width="2"/>
    
    <!-- 顯示屏金額數字 - 用條表示 -->
    <rect x="540" y="232" width="60" height="8" rx="3" fill="#3A8A3A" opacity="0.7"/>
    <rect x="540" y="245" width="45" height="8" rx="3" fill="#3A8A3A" opacity="0.7"/>
    <rect x="540" y="258" width="55" height="8" rx="3" fill="#3A8A3A" opacity="0.7"/>
    
    <!-- 收銀機按鍵 -->
    <circle cx="540" cy="290" r="5" fill="#E06060"/>
    <circle cx="555" cy="290" r="5" fill="#60E060"/>
    <circle cx="570" cy="290" r="5" fill="#6060E0"/>
    <rect x="580" y="285" width="25" height="12" rx="3" fill="#D0C8B0" stroke="#B0A890" stroke-width="1"/>
    
    <!-- 收銀機頂部裝飾 -->
    <rect x="525" y="255" width="90" height="8" rx="3" fill="#C0B8A0"/>
  </g>

  <!-- ======== 收銀員 ======== -->
  <g>
    <!-- 身體 -->
    <rect x="505" y="175" width="40" height="60" rx="12" fill="#E07070" stroke="#C05050" stroke-width="2"/>
    
    <!-- 頭部 -->
    <circle cx="525" cy="160" r="25" fill="url(#cashierPersonGrad)" stroke="#E0A870" stroke-width="2"/>
    
    <!-- 頭髮 -->
    <path d="M500,155 Q500,130 525,128 Q550,130 550,155" fill="#8B5E3C" stroke="#6B3E1C" stroke-width="1"/>
    <path d="M500,155 Q498,145 502,140" fill="none" stroke="#8B5E3C" stroke-width="3" stroke-linecap="round"/>
    
    <!-- 眼睛 -->
    <circle cx="516" cy="158" r="4" fill="#333"/>
    <circle cx="534" cy="158" r="4" fill="#333"/>
    <circle cx="517" cy="157" r="1.5" fill="#FFF"/>
    <circle cx="535" cy="157" r="1.5" fill="#FFF"/>
    
    <!-- 微笑 -->
    <path d="M515,168 Q525,176 535,168" fill="none" stroke="#C07050" stroke-width="2" stroke-linecap="round"/>
    
    <!-- 腮紅 -->
    <ellipse cx="510" cy="168" rx="5" ry="3" fill="#FFA0A0" opacity="0.5"/>
    <ellipse cx="540" cy="168" rx="5" ry="3" fill="#FFA0A0" opacity="0.5"/>
    
    <!-- 手臂 -->
    <path d="M505,200 Q490,210 495,225" fill="none" stroke="#F0B880" stroke-width="6" stroke-linecap="round"/>
    <path d="M545,200 Q560,210 555,225" fill="none" stroke="#F0B880" stroke-width="6" stroke-linecap="round"/>
    
    <!-- 圍裙 -->
    <rect x="508" y="200" width="34" height="30" rx="5" fill="#FFF" stroke="#DDD" stroke-width="1" opacity="0.8"/>
    
    <!-- 帽子 -->
    <rect x="505" y="133" width="40" height="10" rx="5" fill="#FFF" stroke="#DDD" stroke-width="1"/>
    <rect x="510" y="125" width="30" height="12" rx="6" fill="#FFF" stroke="#DDD" stroke-width="1"/>
  </g>

  <!-- ======== 裝飾元素 ======== -->
  <!-- 價格標籤 - 左貨架 -->
  <rect x="65" y="125" width="30" height="12" rx="3" fill="#FFF" stroke="#DDD" stroke-width="1" opacity="0.9"/>
  <rect x="125" y="125" width="30" height="12" rx="3" fill="#FFF" stroke="#DDD" stroke-width="1" opacity="0.9"/>
  
  <!-- 價格標籤 - 右貨架 -->
  <rect x="625" y="125" width="30" height="12" rx="3" fill="#FFF" stroke="#DDD" stroke-width="1" opacity="0.9"/>
  <rect x="695" y="125" width="30" height="12" rx="3" fill="#FFF" stroke="#DDD" stroke-width="1" opacity="0.9"/>

  <!-- 貨架上的價格牌 -->
  <rect x="60" y="195" width="25" height="10" rx="2" fill="#FFE44D" stroke="#E0C030" stroke-width="1"/>
  <rect x="130" y="195" width="25" height="10" rx="2" fill="#FFE44D" stroke="#E0C030" stroke-width="1"/>
  <rect x="620" y="195" width="25" height="10" rx="2" fill="#FFE44D" stroke="#E0C030" stroke-width="1"/>
  <rect x="700" y="195" width="25" height="10" rx="2" fill="#FFE44D" stroke="#E0C030" stroke-width="1"/>

  <!-- 天花板裝飾 - 燈 -->
  <rect x="370" y="10" width="60" height="15" rx="5" fill="#FFF0D0" stroke="#E0D0B0" stroke-width="1"/>
  <rect x="380" y="5" width="40" height="8" rx="3" fill="#E0D0B0"/>
  <line x1="390" y1="5" x2="390" y2="0" stroke="#D0C0A0" stroke-width="2"/>
  <line x1="410" y1="5" x2="410" y2="0" stroke="#D0C0A0" stroke-width="2"/>
  <!-- 燈光效果 -->
  <ellipse cx="400" cy="25" rx="30" ry="8" fill="#FFF8E0" opacity="0.3"/>

  <!-- 牆上裝飾 - 小時鐘 -->
  <circle cx="400" cy="40" r="15" fill="#FFF" stroke="#D0A070" stroke-width="2"/>
  <circle cx="400" cy="40" r="2" fill="#D0A070"/>
  <line x1="400" y1="40" x2="400" y2="32" stroke="#D0A070" stroke-width="2" stroke-linecap="round"/>
  <line x1="400" y1="40" x2="406" y2="40" stroke="#D0A070" stroke-width="2" stroke-linecap="round"/>

  <!-- 購物籃旁的小標籤 -->
  <rect x="360" y="315" width="20" height="8" rx="2" fill="#FFE44D" opacity="0.7"/>

  <!-- 收銀機旁的購物袋 -->
  <path d="M490,275 L485,310 L515,310 L510,275 Z" fill="#E8D0A8" stroke="#D0B890" stroke-width="1.5" rx="3"/>
  <path d="M490,275 Q500,265 510,275" fill="none" stroke="#D0B890" stroke-width="2"/>

  <!-- 地板上的小點綴 -->
  <circle cx="150" cy="350" r="3" fill="#D4C0A0" opacity="0.3"/>
  <circle cx="300" cy="360" r="2" fill="#D4C0A0" opacity="0.3"/>
  <circle cx="500" cy="345" r="3" fill="#D4C0A0" opacity="0.3"/>
  <circle cx="650" cy="355" r="2" fill="#D4C0A0" opacity="0.3"/>

</svg>