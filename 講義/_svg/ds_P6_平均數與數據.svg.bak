<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.1"/>
    </filter>
    <filter id="shadowText" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="1" stdDeviation="1" flood-color="#000" flood-opacity="0.2"/>
    </filter>

    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>

    <!-- 漸變色 -->
    <linearGradient id="gradBar1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#818CF8"/>
    </linearGradient>
    <linearGradient id="gradBar2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FCD34D"/>
    </linearGradient>
    <linearGradient id="gradBar3" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#6EE7B7"/>
    </linearGradient>
    <linearGradient id="gradBar4" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#8B5CF6"/>
      <stop offset="100%" stop-color="#C4B5FD"/>
    </linearGradient>
    <linearGradient id="gradBar5" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#EC4899"/>
      <stop offset="100%" stop-color="#F9A8D4"/>
    </linearGradient>
    <linearGradient id="gradBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F9FAFB"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#gradBg)" rx="12"/>
  <rect x="1" y="1" width="598" height="398" fill="none" stroke="#E5E7EB" stroke-width="1" rx="12"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B" filter="url(#shadowText)">
    📊 平均數與數據分布
  </text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2" opacity="0.4"/>

  <!-- 圖表區域 -->
  <g transform="translate(60, 65)">
    <!-- Y軸 -->
    <line x1="40" y1="10" x2="40" y2="250" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
    <!-- X軸 -->
    <line x1="40" y1="250" x2="500" y2="250" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arrowBlue)"/>

    <!-- Y軸刻度線與標籤 -->
    <line x1="35" y1="50" x2="40" y2="50" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="54" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">10</text>
    <line x1="35" y1="90" x2="40" y2="90" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="94" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">8</text>
    <line x1="35" y1="130" x2="40" y2="130" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="134" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">6</text>
    <line x1="35" y1="170" x2="40" y2="170" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="174" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">4</text>
    <line x1="35" y1="210" x2="40" y2="210" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="214" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">2</text>
    <line x1="35" y1="250" x2="40" y2="250" stroke="#94A3B8" stroke-width="1"/>
    <text x="32" y="254" text-anchor="end" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">0</text>

    <!-- Y軸標題 -->
    <text x="18" y="130" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" fill="#64748B" transform="rotate(-90, 18, 130)">人數</text>

    <!-- 長條圖 - 數據：小明7, 小華9, 小美5, 小強8, 小麗6 -->
    <!-- 長條1：小明 7 (高度 = 250 - 7*20 = 110) -->
    <rect x="65" y="110" width="50" height="140" rx="4" fill="url(#gradBar1)" filter="url(#shadow)" opacity="0.9"/>
    <text x="90" y="102" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#4F46E5">7</text>
    <text x="90" y="272" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#475569">小明</text>

    <!-- 長條2：小華 9 (高度 = 250 - 9*20 = 70) -->
    <rect x="145" y="70" width="50" height="180" rx="4" fill="url(#gradBar2)" filter="url(#shadow)" opacity="0.9"/>
    <text x="170" y="62" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">9</text>
    <text x="170" y="272" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#475569">小華</text>

    <!-- 長條3：小美 5 (高度 = 250 - 5*20 = 150) -->
    <rect x="225" y="150" width="50" height="100" rx="4" fill="url(#gradBar3)" filter="url(#shadow)" opacity="0.9"/>
    <text x="250" y="142" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">5</text>
    <text x="250" y="272" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#475569">小美</text>

    <!-- 長條4：小強 8 (高度 = 250 - 8*20 = 90) -->
    <rect x="305" y="90" width="50" height="160" rx="4" fill="url(#gradBar4)" filter="url(#shadow)" opacity="0.9"/>
    <text x="330" y="82" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#8B5CF6">8</text>
    <text x="330" y="272" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#475569">小強</text>

    <!-- 長條5：小麗 6 (高度 = 250 - 6*20 = 130) -->
    <rect x="385" y="130" width="50" height="120" rx="4" fill="url(#gradBar5)" filter="url(#shadow)" opacity="0.9"/>
    <text x="410" y="122" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#EC4899">6</text>
    <text x="410" y="272" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#475569">小麗</text>

    <!-- 平均線 - 平均數 = (7+9+5+8+6)/5 = 35/5 = 7 -->
    <!-- 平均線高度 = 250 - 7*20 = 110 -->
    <line x1="55" y1="110" x2="450" y2="110" stroke="#EF4444" stroke-width="2.5" stroke-dasharray="8,4" marker-end="url(#arrowGreen)"/>
    
    <!-- 平均線標籤 -->
    <rect x="440" y="96" width="50" height="24" rx="12" fill="#EF4444" opacity="0.9" filter="url(#shadowLight)"/>
    <text x="465" y="113" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#FFFFFF">平均 7</text>

    <!-- 平均數計算式 -->
    <rect x="55" y="290" width="430" height="50" rx="8" fill="#F1F5F9" stroke="#E2E8F0" stroke-width="1"/>
    <text x="270" y="312" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#334155">
      平均數 = (7 + 9 + 5 + 8 + 6) ÷ 5 = 35 ÷ 5 = 
      <tspan font-weight="bold" fill="#EF4444">7</tspan>
    </text>

    <!-- 數據分布箭頭說明 -->
    <line x1="90" y1="290" x2="90" y2="260" stroke="#4F46E5" stroke-width="1" stroke-dasharray="3,3" opacity="0.5"/>
    <line x1="410" y1="290" x2="410" y2="250" stroke="#EC4899" stroke-width="1" stroke-dasharray="3,3" opacity="0.5"/>
  </g>

  <!-- 圖例 -->
  <g transform="translate(60, 365)">
    <rect x="0" y="0" width="12" height="12" rx="2" fill="url(#gradBar1)"/>
    <text x="16" y="10" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#64748B">數據值</text>
    <line x1="80" y1="6" x2="110" y2="6" stroke="#EF4444" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="114" y="10" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#64748B">平均線</text>
    <circle cx="180" cy="6" r="5" fill="#4F46E5" opacity="0.3"/>
    <text x="190" y="10" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#64748B">集中趨勢</text>
  </g>
</svg>