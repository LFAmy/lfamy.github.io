<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#00000030"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000020"/>
    </filter>
    
    <!-- 漸變色 -->
    <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EF4444;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#DC2626;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#2563EB;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#D97706;stop-opacity:1"/>
    </linearGradient>
    
    <!-- 箭頭標記 -->
    <marker id="arrowRight" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#6B7280"/>
    </marker>
    <marker id="arrowDown" markerWidth="8" markerHeight="10" refX="4" refY="9" orient="auto">
      <path d="M0,0 L8,0 L4,10 Z" fill="#6B7280"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#FFFBEB" rx="12"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">分數乘法：2/3 × 4</text>
  
  <!-- 分隔線 -->
  <line x1="50" y1="52" x2="550" y2="52" stroke="#E5E7EB" stroke-width="1.5"/>

  <!-- 4個長條模型 -->
  <!-- 長條 1 (紅色) - 2/3 -->
  <g filter="url(#shadow)">
    <rect x="50" y="75" width="100" height="35" rx="6" fill="#FEE2E2" stroke="#FECACA" stroke-width="1"/>
    <rect x="50" y="75" width="66.7" height="35" rx="6" fill="url(#gradRed)" opacity="0.85"/>
    <rect x="116.7" y="75" width="33.3" height="35" fill="#FEE2E2" opacity="0.5"/>
    <text x="83" y="97" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#FFFFFF" font-weight="bold">2/3</text>
  </g>

  <!-- 長條 2 (藍色) - 2/3 -->
  <g filter="url(#shadow)">
    <rect x="50" y="125" width="100" height="35" rx="6" fill="#DBEAFE" stroke="#BFDBFE" stroke-width="1"/>
    <rect x="50" y="125" width="66.7" height="35" rx="6" fill="url(#gradBlue)" opacity="0.85"/>
    <rect x="116.7" y="125" width="33.3" height="35" fill="#DBEAFE" opacity="0.5"/>
    <text x="83" y="147" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#FFFFFF" font-weight="bold">2/3</text>
  </g>

  <!-- 長條 3 (綠色) - 2/3 -->
  <g filter="url(#shadow)">
    <rect x="50" y="175" width="100" height="35" rx="6" fill="#D1FAE5" stroke="#A7F3D0" stroke-width="1"/>
    <rect x="50" y="175" width="66.7" height="35" rx="6" fill="url(#gradGreen)" opacity="0.85"/>
    <rect x="116.7" y="175" width="33.3" height="35" fill="#D1FAE5" opacity="0.5"/>
    <text x="83" y="197" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#FFFFFF" font-weight="bold">2/3</text>
  </g>

  <!-- 長條 4 (橙色) - 2/3 -->
  <g filter="url(#shadow)">
    <rect x="50" y="225" width="100" height="35" rx="6" fill="#FEF3C7" stroke="#FDE68A" stroke-width="1"/>
    <rect x="50" y="225" width="66.7" height="35" rx="6" fill="url(#gradOrange)" opacity="0.85"/>
    <rect x="116.7" y="225" width="33.3" height="35" fill="#FEF3C7" opacity="0.5"/>
    <text x="83" y="247" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#FFFFFF" font-weight="bold">2/3</text>
  </g>

  <!-- 加號標記 -->
  <text x="40" y="105" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#6B7280" font-weight="bold">+</text>
  <text x="40" y="155" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#6B7280" font-weight="bold">+</text>
  <text x="40" y="205" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#6B7280" font-weight="bold">+</text>

  <!-- 等號箭頭 -->
  <line x1="175" y1="200" x2="225" y2="200" stroke="#6B7280" stroke-width="2.5" marker-end="url(#arrowRight)"/>

  <!-- 結果長條 - 8/3 = 2又2/3 -->
  <g filter="url(#shadow)">
    <!-- 整個結果長條 -->
    <rect x="240" y="120" width="200" height="90" rx="8" fill="#F3F4F6" stroke="#D1D5DB" stroke-width="1.5"/>
    
    <!-- 第1個完整單位 (紅色) -->
    <rect x="240" y="120" width="75" height="90" rx="8" fill="url(#gradRed)" opacity="0.8"/>
    <!-- 第2個完整單位 (藍色) -->
    <rect x="315" y="120" width="75" height="90" rx="8" fill="url(#gradBlue)" opacity="0.8"/>
    <!-- 第3個部分單位 2/3 (綠色) -->
    <rect x="390" y="120" width="50" height="90" rx="8" fill="url(#gradGreen)" opacity="0.8"/>
    <!-- 空白部分 -->
    <rect x="440" y="120" width="25" height="90" fill="#F3F4F6" opacity="0.5"/>
    
    <!-- 標籤 -->
    <text x="277" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="#FFFFFF" font-weight="bold">1</text>
    <text x="352" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="#FFFFFF" font-weight="bold">1</text>
    <text x="415" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#FFFFFF" font-weight="bold">2/3</text>
  </g>

  <!-- 結果文字 -->
  <text x="340" y="250" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" fill="#1F2937" font-weight="bold">
    總和 = 8/3 = 2 
    <tspan baseline-shift="super" font-size="14">2</tspan>
    /
    <tspan baseline-shift="sub" font-size="14">3</tspan>
  </text>

  <!-- 計算過程 -->
  <g filter="url(#shadowLight)">
    <rect x="50" y="280" width="500" height="100" rx="10" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.5"/>
  </g>
  
  <text x="70" y="310" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" fill="#374151" font-weight="bold">計算過程：</text>
  
  <text x="70" y="340" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" fill="#4B5563">
    <tspan fill="#EF4444" font-weight="bold">2/3</tspan>
    <tspan> × 4 = </tspan>
    <tspan fill="#EF4444" font-weight="bold">2</tspan>
    <tspan> × 4 ÷ 3 = 8 ÷ 3 = </tspan>
    <tspan fill="#10B981" font-weight="bold">2</tspan>
    <tspan fill="#10B981" font-size="13" baseline-shift="super">2</tspan>
    <tspan fill="#10B981" font-size="13">/</tspan>
    <tspan fill="#10B981" font-size="13" baseline-shift="sub">3</tspan>
  </text>
  
  <text x="70" y="368" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" fill="#6B7280">
    4個 
    <tspan fill="#EF4444" font-weight="bold">2/3</tspan>
    <tspan> 相加 = </tspan>
    <tspan fill="#3B82F6" font-weight="bold">2/3 + 2/3 + 2/3 + 2/3</tspan>
    <tspan> = 8/3 = 2</tspan>
    <tspan font-size="12" baseline-shift="super">2</tspan>
    <tspan>/</tspan>
    <tspan font-size="12" baseline-shift="sub">3</tspan>
  </text>

  <!-- 裝飾小點 -->
  <circle cx="560" cy="85" r="4" fill="#EF4444" opacity="0.4"/>
  <circle cx="570" cy="85" r="4" fill="#3B82F6" opacity="0.4"/>
  <circle cx="560" cy="95" r="4" fill="#10B981" opacity="0.4"/>
  <circle cx="570" cy="95" r="4" fill="#F59E0B" opacity="0.4"/>
</svg>