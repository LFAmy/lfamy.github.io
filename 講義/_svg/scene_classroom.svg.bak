<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <!-- 背景漸變 -->
    <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFF5E6"/>
      <stop offset="100%" stop-color="#FFE8CC"/>
    </linearGradient>
    <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#E8C9A0"/>
      <stop offset="100%" stop-color="#D4B080"/>
    </linearGradient>
    <!-- 黑板漸變 -->
    <linearGradient id="boardGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#2D5A3D"/>
      <stop offset="100%" stop-color="#1E3D28"/>
    </linearGradient>
    <!-- 天空漸變 -->
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#87CEEB"/>
      <stop offset="100%" stop-color="#B0E0FF"/>
    </linearGradient>
    <!-- 桌面漸變 -->
    <linearGradient id="deskGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#D4A056"/>
      <stop offset="100%" stop-color="#B8863E"/>
    </linearGradient>
    <!-- 窗簾漸變 -->
    <linearGradient id="curtainGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#FF9E9E"/>
      <stop offset="100%" stop-color="#FFB5B5"/>
    </linearGradient>
  </defs>

  <!-- 牆壁 -->
  <rect x="0" y="0" width="800" height="320" fill="url(#wallGrad)" rx="0"/>

  <!-- 地板 -->
  <rect x="0" y="320" width="800" height="80" fill="url(#floorGrad)" rx="0"/>
  <!-- 地板線條 -->
  <line x1="0" y1="340" x2="800" y2="340" stroke="#C9A060" stroke-width="1" opacity="0.4"/>
  <line x1="0" y1="360" x2="800" y2="360" stroke="#C9A060" stroke-width="1" opacity="0.3"/>
  <line x1="0" y1="380" x2="800" y2="380" stroke="#C9A060" stroke-width="1" opacity="0.2"/>

  <!-- 窗戶外框 -->
  <rect x="520" y="50" width="200" height="200" rx="8" fill="none" stroke="#B8863E" stroke-width="6"/>
  <!-- 窗戶玻璃 -->
  <rect x="523" y="53" width="194" height="194" rx="6" fill="url(#skyGrad)"/>
  <!-- 窗戶十字框 -->
  <line x1="620" y1="53" x2="620" y2="247" stroke="#B8863E" stroke-width="4"/>
  <line x1="523" y1="150" x2="717" y2="150" stroke="#B8863E" stroke-width="4"/>

  <!-- 窗戶外建築物 -->
  <rect x="530" y="160" width="40" height="80" rx="2" fill="#E8A0A0" opacity="0.7"/>
  <rect x="575" y="140" width="35" height="100" rx="2" fill="#A0C4E8" opacity="0.7"/>
  <rect x="615" y="170" width="30" height="70" rx="2" fill="#E8D0A0" opacity="0.7"/>
  <rect x="650" y="130" width="45" height="110" rx="2" fill="#C8A8E8" opacity="0.7"/>
  <rect x="700" y="155" width="15" height="85" rx="2" fill="#A8E8C8" opacity="0.7"/>

  <!-- 建築物窗戶 -->
  <rect x="536" y="168" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="550" y="168" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="536" y="185" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="550" y="185" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>

  <rect x="581" y="148" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="596" y="148" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="581" y="165" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="596" y="165" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>

  <rect x="656" y="138" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="672" y="138" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="656" y="155" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>
  <rect x="672" y="155" width="8" height="8" rx="1" fill="#FFE8A0" opacity="0.8"/>

  <!-- 太陽 -->
  <circle cx="680" cy="80" r="20" fill="#FFE066" opacity="0.8"/>
  <circle cx="680" cy="80" r="16" fill="#FFD700"/>

  <!-- 雲朵 -->
  <ellipse cx="570" cy="85" rx="25" ry="12" fill="white" opacity="0.8"/>
  <ellipse cx="590" cy="80" rx="20" ry="10" fill="white" opacity="0.8"/>
  <ellipse cx="555" cy="82" rx="15" ry="9" fill="white" opacity="0.8"/>

  <!-- 窗簾 -->
  <rect x="518" y="48" width="12" height="200" rx="6" fill="url(#curtainGrad)" opacity="0.7"/>
  <rect x="710" y="48" width="12" height="200" rx="6" fill="url(#curtainGrad)" opacity="0.7"/>
  <!-- 窗簾掛桿 -->
  <rect x="510" y="48" width="220" height="6" rx="3" fill="#B8863E"/>

  <!-- 黑板 -->
  <rect x="30" y="40" width="340" height="200" rx="10" fill="url(#boardGrad)"/>
  <!-- 黑板邊框 -->
  <rect x="26" y="36" width="348" height="208" rx="12" fill="none" stroke="#B8863E" stroke-width="5"/>

  <!-- 數學公式 - 加法 -->
  <text x="80" y="100" font-family="Arial" font-size="28" fill="white" font-weight="bold">3 + 5 = 8</text>
  <!-- 數學公式 - 減法 -->
  <text x="80" y="145" font-family="Arial" font-size="28" fill="white" font-weight="bold">12 − 7 = 5</text>
  <!-- 數學公式 - 乘法 -->
  <text x="80" y="190" font-family="Arial" font-size="28" fill="white" font-weight="bold">4 × 6 = 24</text>

  <!-- 黑板上的圖形 -->
  <circle cx="280" cy="100" r="25" fill="none" stroke="#FFE066" stroke-width="3"/>
  <rect x="255" y="130" width="50" height="40" rx="3" fill="none" stroke="#FF9E9E" stroke-width="3"/>
  <polygon points="280,165 260,200 300,200" fill="none" stroke="#A0E0A0" stroke-width="3"/>

  <!-- 老師講桌 -->
  <rect x="130" y="250" width="160" height="70" rx="8" fill="url(#deskGrad)"/>
  <rect x="130" y="250" width="160" height="10" rx="4" fill="#C99A4E"/>
  <!-- 桌腳 -->
  <rect x="138" y="310" width="8" height="20" rx="2" fill="#A07030"/>
  <rect x="274" y="310" width="8" height="20" rx="2" fill="#A07030"/>

  <!-- 課本在桌上 -->
  <rect x="160" y="265" width="45" height="32" rx="3" fill="#FFB080" transform="rotate(-8, 182, 281)"/>
  <rect x="165" y="268" width="35" height="26" rx="2" fill="#FFD0A0" transform="rotate(-8, 182, 281)"/>
  <rect x="210" y="260" width="40" height="30" rx="3" fill="#80B0FF" transform="rotate(5, 230, 275)"/>
  <rect x="214" y="263" width="32" height="24" rx="2" fill="#A0C8FF" transform="rotate(5, 230, 275)"/>

  <!-- 鉛筆 -->
  <rect x="255" y="275" width="4" height="30" rx="1" fill="#FFD700" transform="rotate(-20, 257, 290)"/>
  <polygon points="255,275 259,275 257,268" fill="#FF9E9E" transform="rotate(-20, 257, 290)"/>

  <!-- 橡皮擦 -->
  <rect x="240" y="295" width="18" height="10" rx="3" fill="#FFB5B5"/>
  <rect x="240" y="295" width="18" height="4" rx="2" fill="#FFD0D0"/>

  <!-- 學生書桌 - 左 -->
  <rect x="20" y="280" width="100" height="55" rx="6" fill="url(#deskGrad)"/>
  <rect x="20" y="280" width="100" height="8" rx="3" fill="#C99A4E"/>
  <rect x="26" y="328" width="6" height="15" rx="2" fill="#A07030"/>
  <rect x="108" y="328" width="6" height="15" rx="2" fill="#A07030"/>

  <!-- 學生書桌 - 右 -->
  <rect x="370" y="280" width="100" height="55" rx="6" fill="url(#deskGrad)"/>
  <rect x="370" y="280" width="100" height="8" rx="3" fill="#C99A4E"/>
  <rect x="376" y="328" width="6" height="15" rx="2" fill="#A07030"/>
  <rect x="458" y="328" width="6" height="15" rx="2" fill="#A07030"/>

  <!-- 學生課本 -->
  <rect x="35" y="292" width="35" height="25" rx="2" fill="#80D080" transform="rotate(-5, 52, 304)"/>
  <rect x="38" y="295" width="28" height="19" rx="1" fill="#A0E8A0" transform="rotate(-5, 52, 304)"/>

  <rect x="385" y="290" width="35" height="25" rx="2" fill="#FFB080" transform="rotate(3, 402, 302)"/>
  <rect x="388" y="293" width="28" height="19" rx="1" fill="#FFD0A0" transform="rotate(3, 402, 302)"/>

  <!-- 彩色鉛筆 -->
  <rect x="75" y="300" width="3" height="20" rx="1" fill="#FF6B6B" transform="rotate(15, 76, 310)"/>
  <rect x="80" y="298" width="3" height="20" rx="1" fill="#4ECDC4" transform="rotate(10, 81, 308)"/>
  <rect x="85" y="296" width="3" height="20" rx="1" fill="#FFE066" transform="rotate(5, 86, 306)"/>

  <rect x="420" y="298" width="3" height="20" rx="1" fill="#A0C4FF" transform="rotate(-10, 421, 308)"/>
  <rect x="425" y="300" width="3" height="20" rx="1" fill="#FF9E9E" transform="rotate(-5, 426, 310)"/>

  <!-- 小裝飾 - 時鐘 -->
  <circle cx="400" cy="70" r="22" fill="white" stroke="#B8863E" stroke-width="3"/>
  <circle cx="400" cy="70" r="2" fill="#B8863E"/>
  <line x1="400" y1="70" x2="400" y2="58" stroke="#B8863E" stroke-width="2.5"/>
  <line x1="400" y1="70" x2="410" y2="70" stroke="#B8863E" stroke-width="2"/>
  <!-- 時鐘刻度 -->
  <line x1="400" y1="50" x2="400" y2="53" stroke="#B8863E" stroke-width="1.5"/>
  <line x1="400" y1="87" x2="400" y2="90" stroke="#B8863E" stroke-width="1.5"/>
  <line x1="380" y1="70" x2="383" y2="70" stroke="#B8863E" stroke-width="1.5"/>
  <line x1="417" y1="70" x2="420" y2="70" stroke="#B8863E" stroke-width="1.5"/>

  <!-- 小裝飾 - 植物 -->
  <rect x="465" y="240" width="20" height="25" rx="3" fill="#D48050"/>
  <circle cx="475" cy="235" r="12" fill="#60C060"/>
  <circle cx="468" cy="228" r="8" fill="#70D070"/>
  <circle cx="482" cy="230" r="9" fill="#50B050"/>

  <!-- 小裝飾 - 櫃子 -->
  <rect x="740" y="220" width="40" height="100" rx="5" fill="#C9A060"/>
  <rect x="745" y="225" width="30" height="40" rx="3" fill="#D4B080"/>
  <rect x="745" y="270" width="30" height="40" rx="3" fill="#D4B080"/>
  <circle cx="770" cy="245" r="2" fill="#A07030"/>
  <circle cx="770" cy="290" r="2" fill="#A07030"/>

  <!-- 地板上的影子 -->
  <ellipse cx="210" cy="335" rx="80" ry="5" fill="#C09050" opacity="0.3"/>
  <ellipse cx="70" cy="340" rx="50" ry="3" fill="#C09050" opacity="0.25"/>
  <ellipse cx="420" cy="340" rx="50" ry="3" fill="#C09050" opacity="0.25"/>

  <!-- 小裝飾 - 門 -->
  <rect x="8" y="160" width="3" height="160" rx="1" fill="#B8863E" opacity="0.5"/>

  <!-- 黑板上方裝飾 -->
  <rect x="30" y="32" width="340" height="6" rx="3" fill="#D4A056"/>

  <!-- 小細節 - 紙飛機 -->
  <polygon points="490,120 500,115 495,125" fill="#FFE066" opacity="0.6" transform="rotate(15, 495, 120)"/>

</svg>