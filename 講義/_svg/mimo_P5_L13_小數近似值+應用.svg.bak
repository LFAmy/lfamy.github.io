<svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.15" />
    </filter>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#6B7280" />
    </marker>
    <marker id="arrowhead-blue" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4F46E5" />
    </marker>
    <marker id="arrowhead-amber" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#F59E0B" />
    </marker>
    <marker id="arrowhead-emerald" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#10B981" />
    </marker>
    <linearGradient id="grad-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="grad-amber" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="grad-emerald" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- 背景 -->
  <rect width="600" height="400" rx="12" fill="#F9FAFB" />

  <!-- 标题栏 -->
  <rect x="20" y="20" width="560" height="50" rx="10" fill="url(#grad-blue)" filter="url(#shadow)" />
  <text x="300" y="52" font-size="22" font-weight="bold" fill="white" text-anchor="middle">小數的近似值：四捨五入、上捨入與下捨入</text>

  <!-- 主示例卡片 -->
  <rect x="20" y="80" width="560" height="70" rx="10" fill="white" filter="url(#shadow)" />
  <text x="40" y="110" font-size="15" fill="#4F46E5" font-weight="bold">示例：</text>
  <text x="110" y="110" font-size="20" fill="#1F2937" font-weight="bold">2.3456</text>
  <text x="220" y="110" font-size="15" fill="#6B7280">≈ (近似值)</text>
  <line x1="340" y1="95" x2="340" y2="140" stroke="#E5E7EB" stroke-width="1" />
  <text x="360" y="110" font-size="14" fill="#4F46E5">四捨五入至百分位 →</text>
  <text x="520" y="110" font-size="18" fill="#4F46E5" font-weight="bold">2.35</text>
  <text x="110" y="140" font-size="13" fill="#6B7280">（先找到目標位：百分位是「4」，看下一位「5」）</text>

  <!-- 流程图 -->
  <!-- 四舍五入 -->
  <rect x="20" y="160" width="180" height="220" rx="10" fill="white" filter="url(#shadow)" />
  <rect x="20" y="160" width="180" height="40" rx="10" fill="url(#grad-blue)" />
  <text x="110" y="185" font-size="16" font-weight="bold" fill="white" text-anchor="middle">四捨五入</text>
  <text x="40" y="215" font-size="12" fill="#374151">1. 找到目標位數</text>
  <text x="40" y="235" font-size="12" fill="#374151">2. 觀察下一位數字</text>
  <text x="50" y="255" font-size="12" fill="#4F46E5">→ 0-4：捨去</text>
  <text x="50" y="275" font-size="12" fill="#4F46E5">→ 5-9：進一</text>
  <text x="40" y="305" font-size="13" font-weight="bold" fill="#4F46E5">例如：2.3456</text>
  <text x="40" y="325" font-size="13" fill="#4F46E5">百分位「4」→ 下一位「5」</text>
  <text x="40" y="345" font-size="13" fill="#4F46E5">→ 進一得 2.35</text>
  <!-- 箭头 -->
  <line x1="110" y1="370" x2="110" y2="390" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowhead-blue)" />
  <text x="110" y="398" font-size="12" fill="#4F46E5" text-anchor="middle">最常用</text>

  <!-- 上舍入 -->
  <rect x="210" y="160" width="180" height="220" rx="10" fill="white" filter="url(#shadow)" />
  <rect x="210" y="160" width="180" height="40" rx="10" fill="url(#grad-amber)" />
  <text x="300" y="185" font-size="16" font-weight="bold" fill="white" text-anchor="middle">上捨入 (進一法)</text>
  <text x="230" y="215" font-size="12" fill="#374151">1. 找到目標位數</text>
  <text x="230" y="235" font-size="12" fill="#374151">2. 無論下一位是幾</text>
  <text x="240" y="255" font-size="12" fill="#F59E0B">→ 目標位都加1</text>
  <text x="230" y="285" font-size="13" font-weight="bold" fill="#F59E0B">例如：2.3416</text>
  <text x="230" y="305" font-size="13" fill="#F59E0B">百分位「4」→ 不論下一位</text>
  <text x="230" y="325" font-size="13" fill="#F59E0B">→ 進一得 2.35</text>
  <text x="230" y="355" font-size="12" fill="#6B7280">常用於“至少需要”</text>

  <!-- 下舍入 -->
  <rect x="400" y="160" width="180" height="220" rx="10" fill="white" filter="url(#shadow)" />
  <rect x="400" y="160" width="180" height="40" rx="10" fill="url(#grad-emerald)" />
  <text x="490" y="185" font-size="16" font-weight="bold" fill="white" text-anchor="middle">下捨入 (去尾法)</text>
  <text x="420" y="215" font-size="12" fill="#374151">1. 找到目標位數</text>
  <text x="420" y="235" font-size="12" fill="#374151">2. 無論下一位是幾</text>
  <text x="430" y="255" font-size="12" fill="#10B981">→ 直接捨去後面</text>
  <text x="420" y="285" font-size="13" font-weight="bold" fill="#10B981">例如：2.3496</text>
  <text x="420" y="305" font-size="13" fill="#10B981">百分位「4」→ 不論下一位</text>
  <text x="420" y="325" font-size="13" fill="#10B981">→ 直接得 2.34</text>
  <text x="420" y="355" font-size="12" fill="#6B7280">常用於“最多能”</text>

  <!-- 关键点卡片 -->
  <rect x="20" y="390" width="560" height="10" rx="0" fill="#E5E7EB" />
</svg>