<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#1E293B" flood-opacity="0.15"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#1E293B" flood-opacity="0.10"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrow" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="10" markerHeight="10" orient="auto">
      <path d="M0,0 L12,6 L0,12 L3,6 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowDown" viewBox="0 0 12 12" refX="6" refY="10" markerWidth="10" markerHeight="10" orient="auto">
      <path d="M0,0 L12,0 L6,12 Z" fill="#F59E0B"/>
    </marker>
    
    <!-- 漸變色 -->
    <linearGradient id="bgGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F9FAFB"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
    <linearGradient id="cardGrad1" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="cardGrad2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="cardGrad3" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="titleGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="url(#bgGrad)" rx="12"/>
  
  <!-- 頂部裝飾線 -->
  <rect x="0" y="0" width="600" height="6" fill="url(#titleGrad)" rx="3"/>

  <!-- 標題 -->
  <text x="300" y="42" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1E293B" filter="url(#shadowLight)">📐 解含括號方程</text>
  <text x="300" y="62" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#64748B">P6 方程進階 · 分步解題流程</text>

  <!-- ====== 步驟 1 ====== -->
  <g filter="url(#shadow)">
    <rect x="40" y="90" width="160" height="100" rx="14" fill="white" stroke="#4F46E5" stroke-width="2.5"/>
    <rect x="40" y="90" width="160" height="36" rx="14" fill="url(#cardGrad1)"/>
    <rect x="40" y="112" width="160" height="14" fill="url(#cardGrad1)"/>
  </g>
  <text x="120" y="112" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">步驟 1</text>
  <text x="120" y="148" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#1E293B">2(x + 3) = 14</text>
  <text x="120" y="174" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">✏️ 兩邊同時 ÷2</text>

  <!-- 箭頭 1 → 2 -->
  <line x1="200" y1="140" x2="255" y2="140" stroke="#4F46E5" stroke-width="3" marker-end="url(#arrow)"/>
  
  <!-- 箭頭上方標註 -->
  <text x="228" y="130" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4F46E5" font-weight="bold">÷2</text>

  <!-- ====== 步驟 2 ====== -->
  <g filter="url(#shadow)">
    <rect x="265" y="90" width="160" height="100" rx="14" fill="white" stroke="#F59E0B" stroke-width="2.5"/>
    <rect x="265" y="90" width="160" height="36" rx="14" fill="url(#cardGrad2)"/>
    <rect x="265" y="112" width="160" height="14" fill="url(#cardGrad2)"/>
  </g>
  <text x="345" y="112" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">步驟 2</text>
  <text x="345" y="148" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#1E293B">x + 3 = 7</text>
  <text x="345" y="174" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#64748B">✏️ 兩邊同時 −3</text>

  <!-- 箭頭 2 → 3 -->
  <line x1="425" y1="140" x2="480" y2="140" stroke="#F59E0B" stroke-width="3" marker-end="url(#arrow)"/>
  
  <!-- 箭頭上方標註 -->
  <text x="453" y="130" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#F59E0B" font-weight="bold">−3</text>

  <!-- ====== 步驟 3 ====== -->
  <g filter="url(#shadow)">
    <rect x="490" y="90" width="100" height="100" rx="14" fill="white" stroke="#10B981" stroke-width="2.5"/>
    <rect x="490" y="90" width="100" height="36" rx="14" fill="url(#cardGrad3)"/>
    <rect x="490" y="112" width="100" height="14" fill="url(#cardGrad3)"/>
  </g>
  <text x="540" y="112" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="white">步驟 3</text>
  <text x="540" y="148" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="18" font-weight="bold" fill="#1E293B">x = 4</text>
  <text x="540" y="174" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#10B981" font-weight="bold">✅ 完成</text>

  <!-- ====== 解題提示區 ====== -->
  <g filter="url(#shadowLight)">
    <rect x="40" y="220" width="520" height="155" rx="14" fill="white" stroke="#E2E8F0" stroke-width="1.5"/>
  </g>
  
  <!-- 提示標題 -->
  <rect x="40" y="220" width="520" height="36" rx="14" fill="#F1F5F9"/>
  <rect x="40" y="242" width="520" height="14" fill="#F1F5F9"/>
  <text x="300" y="244" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="15" font-weight="bold" fill="#334155">💡 解題要點</text>

  <!-- 要點 1 -->
  <circle cx="70" cy="278" r="5" fill="#4F46E5"/>
  <text x="85" y="283" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#334155">
    <tspan font-weight="bold" fill="#4F46E5">去括號：</tspan>
    <tspan>先將括號外的數除以兩邊，去掉括號</tspan>
  </text>

  <!-- 要點 2 -->
  <circle cx="70" cy="308" r="5" fill="#F59E0B"/>
  <text x="85" y="313" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#334155">
    <tspan font-weight="bold" fill="#F59E0B">移項：</tspan>
    <tspan>將常數項移到等號另一邊，變號運算</tspan>
  </text>

  <!-- 要點 3 -->
  <circle cx="70" cy="338" r="5" fill="#10B981"/>
  <text x="85" y="343" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#334155">
    <tspan font-weight="bold" fill="#10B981">驗算：</tspan>
    <tspan>將 x=4 代回原式 2(4+3)=2×7=14 ✓</tspan>
  </text>

  <!-- 裝飾小圖標 - 右下方 -->
  <text x="530" y="355" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#CBD5E1">P6 方程進階</text>
</svg>