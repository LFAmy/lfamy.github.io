<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-color="#00000022"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#00000018"/>
    </filter>
    
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <path d="M0,0 L8,3 L0,6 Z" fill="#10B981"/>
    </marker>
    
    <!-- 漸變色 -->
    <linearGradient id="gradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#4F46E5;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FBBF24;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34D399;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="gradPurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#A78BFA;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="12"/>
  
  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">📐 基本圖形 — 角和邊</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2" opacity="0.4"/>

  <!-- ==================== 三角形 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="25" y="65" width="260" height="145" rx="10" fill="white" stroke="#E5E7EB" stroke-width="1"/>
    <!-- 三角形 -->
    <polygon points="155,95 85,185 225,185" fill="url(#gradBlue)" opacity="0.85" stroke="#4F46E5" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- 角標記 - 頂角 -->
    <path d="M145,120 L135,110 L155,110" fill="none" stroke="#F59E0B" stroke-width="2" marker-end="url(#arrowOrange)"/>
    <text x="138" y="103" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 左角 -->
    <path d="M100,170 L95,160 L110,165" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="78" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 右角 -->
    <path d="M210,170 L215,160 L200,165" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="232" y="175" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 邊標記 - 底邊 -->
    <line x1="155" y1="198" x2="155" y2="210" stroke="#10B981" stroke-width="2" marker-end="url(#arrowGreen)"/>
    <line x1="155" y1="210" x2="155" y2="198" stroke="#10B981" stroke-width="2"/>
    <text x="155" y="225" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 邊標記 - 左邊 -->
    <line x1="120" y1="140" x2="110" y2="148" stroke="#10B981" stroke-width="2"/>
    <text x="100" y="138" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 邊標記 - 右邊 -->
    <line x1="190" y1="140" x2="200" y2="148" stroke="#10B981" stroke-width="2"/>
    <text x="210" y="138" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 圖形名稱 -->
    <text x="155" y="80" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#4F46E5">三角形</text>
    <!-- 說明 -->
    <text x="155" y="245" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">3 條邊 · 3 個角</text>
  </g>

  <!-- ==================== 正方形 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="315" y="65" width="260" height="145" rx="10" fill="white" stroke="#E5E7EB" stroke-width="1"/>
    <!-- 正方形 -->
    <rect x="370" y="95" width="80" height="80" rx="2" fill="url(#gradOrange)" opacity="0.85" stroke="#F59E0B" stroke-width="2.5"/>
    <!-- 角標記 - 左上 -->
    <path d="M378,103 L378,110 L385,110" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="362" y="100" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 右上 -->
    <path d="M442,103 L442,110 L435,110" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="458" y="100" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 左下 -->
    <path d="M378,167 L378,160 L385,160" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="362" y="178" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 右下 -->
    <path d="M442,167 L442,160 L435,160" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="458" y="178" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 邊標記 - 上邊 -->
    <line x1="410" y1="88" x2="410" y2="78" stroke="#10B981" stroke-width="2" marker-end="url(#arrowGreen)"/>
    <line x1="410" y1="78" x2="410" y2="88" stroke="#10B981" stroke-width="2"/>
    <text x="410" y="72" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 邊標記 - 右邊 -->
    <line x1="458" y1="135" x2="468" y2="135" stroke="#10B981" stroke-width="2"/>
    <text x="478" y="139" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 邊標記 - 下邊 -->
    <line x1="410" y1="182" x2="410" y2="192" stroke="#10B981" stroke-width="2"/>
    <text x="410" y="205" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 邊標記 - 左邊 -->
    <line x1="362" y1="135" x2="352" y2="135" stroke="#10B981" stroke-width="2"/>
    <text x="342" y="139" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">邊</text>
    <!-- 圖形名稱 -->
    <text x="445" y="80" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#F59E0B">正方形</text>
    <!-- 說明 -->
    <text x="445" y="245" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">4 條邊 · 4 個直角</text>
  </g>

  <!-- ==================== 長方形 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="25" y="265" width="260" height="120" rx="10" fill="white" stroke="#E5E7EB" stroke-width="1"/>
    <!-- 長方形 -->
    <rect x="55" y="290" width="120" height="65" rx="2" fill="url(#gradGreen)" opacity="0.85" stroke="#10B981" stroke-width="2.5"/>
    <!-- 角標記 - 左上 -->
    <path d="M63,298 L63,305 L70,305" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="48" y="296" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 右上 -->
    <path d="M167,298 L167,305 L160,305" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="182" y="296" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 角標記 - 左下 -->
    <path d="M63,347 L63,340 L70,340" fill="none" stroke="#F59E0B" stroke-width="2"/>
    <text x="48" y="358" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#F59E0B">角</text>
    <!-- 邊標記 - 長邊 -->
    <line x1="115" y1="283" x2="115" y2="273" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowBlue)"/>
    <line x1="115" y1="273" x2="115" y2="283" stroke="#4F46E5" stroke-width="2"/>
    <text x="115" y="267" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#4F46E5">長邊</text>
    <!-- 邊標記 - 短邊 -->
    <line x1="182" y1="322" x2="192" y2="322" stroke="#4F46E5" stroke-width="2"/>
    <text x="200" y="326" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#4F46E5">短邊</text>
    <!-- 圖形名稱 -->
    <text x="155" y="280" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#10B981">長方形</text>
    <!-- 說明 -->
    <text x="155" y="375" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">4 條邊 · 4 個直角 · 對邊等長</text>
  </g>

  <!-- ==================== 圓形 ==================== -->
  <g filter="url(#shadowLight)">
    <rect x="315" y="265" width="260" height="120" rx="10" fill="white" stroke="#E5E7EB" stroke-width="1"/>
    <!-- 圓形 -->
    <circle cx="410" cy="325" r="40" fill="url(#gradPurple)" opacity="0.85" stroke="#8B5CF6" stroke-width="2.5"/>
    <!-- 圓心 -->
    <circle cx="410" cy="325" r="3" fill="#F59E0B"/>
    <text x="410" y="315" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" font-weight="bold" fill="#F59E0B">圓心</text>
    <!-- 半徑標記 -->
    <line x1="410" y1="325" x2="445" y2="300" stroke="#4F46E5" stroke-width="2" marker-end="url(#arrowBlue)"/>
    <text x="438" y="298" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" font-weight="bold" fill="#4F46E5">半徑</text>
    <!-- 圓周標記 -->
    <path d="M455,340 A10,10 0 0,0 460,335" fill="none" stroke="#10B981" stroke-width="2"/>
    <text x="468" y="348" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" font-weight="bold" fill="#10B981">圓周</text>
    <!-- 圖形名稱 -->
    <text x="445" y="280" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="16" font-weight="bold" fill="#8B5CF6">圓形</text>
    <!-- 說明 -->
    <text x="445" y="375" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#6B7280">沒有角 · 沒有邊 · 有圓周</text>
  </g>

  <!-- 底部提示 -->
  <text x="300" y="398" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#9CA3AF">P3 數學 · 圖形與角 · 認識基本圖形的特徵</text>
</svg>