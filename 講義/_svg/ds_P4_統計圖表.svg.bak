<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="3" flood-opacity="0.25"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.15"/>
    </filter>

    <!-- 漸變色 -->
    <linearGradient id="gradBar" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C73E6"/>
    </linearGradient>
    <linearGradient id="gradLine" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="gradPie1" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradPie2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="gradPie3" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C73E6"/>
    </linearGradient>

    <!-- 箭頭 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" rx="12" fill="#F8FAFC"/>

  <!-- 標題 -->
  <text x="300" y="32" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="20" font-weight="bold" fill="#1E293B">📊 統計圖表三合一對比</text>

  <!-- ============ 左欄：長條圖 ============ -->
  <g filter="url(#shadowLight)">
    <rect x="15" y="50" width="185" height="155" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1"/>
  </g>
  <text x="107" y="75" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#4F46E5">📊 長條圖</text>

  <!-- 長條圖座標軸 -->
  <line x1="40" y1="180" x2="175" y2="180" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="40" y1="90" x2="40" y2="180" stroke="#CBD5E1" stroke-width="1.5"/>

  <!-- 長條 -->
  <rect x="52" y="130" width="22" height="50" rx="3" fill="url(#gradBar)" filter="url(#shadowLight)"/>
  <rect x="82" y="105" width="22" height="75" rx="3" fill="url(#gradBar)" filter="url(#shadowLight)"/>
  <rect x="112" y="120" width="22" height="60" rx="3" fill="url(#gradBar)" filter="url(#shadowLight)"/>
  <rect x="142" y="95" width="22" height="85" rx="3" fill="url(#gradBar)" filter="url(#shadowLight)"/>

  <!-- 長條標籤 -->
  <text x="63" y="195" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">一</text>
  <text x="93" y="195" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">二</text>
  <text x="123" y="195" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">三</text>
  <text x="153" y="195" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">四</text>

  <!-- 用途說明 -->
  <text x="107" y="218" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">比較各類別數量</text>
  <text x="107" y="232" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">例如：各班人數</text>

  <!-- 箭頭標示 -->
  <line x1="107" y1="240" x2="107" y2="258" stroke="#4F46E5" stroke-width="1.5" marker-end="url(#arrowBlue)" stroke-dasharray="3,2"/>

  <!-- ============ 中欄：折線圖 ============ -->
  <g filter="url(#shadowLight)">
    <rect x="207" y="50" width="185" height="155" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1"/>
  </g>
  <text x="299" y="75" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#F59E0B">📈 折線圖</text>

  <!-- 折線圖座標軸 -->
  <line x1="232" y1="180" x2="367" y2="180" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="232" y1="90" x2="232" y2="180" stroke="#CBD5E1" stroke-width="1.5"/>

  <!-- 折線 -->
  <polyline points="252,150 282,110 312,130 342,95" fill="none" stroke="url(#gradLine)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#shadowLight)"/>

  <!-- 數據點 -->
  <circle cx="252" cy="150" r="4" fill="#F59E0B" filter="url(#shadowLight)"/>
  <circle cx="282" cy="110" r="4" fill="#F59E0B" filter="url(#shadowLight)"/>
  <circle cx="312" cy="130" r="4" fill="#F59E0B" filter="url(#shadowLight)"/>
  <circle cx="342" cy="95" r="4" fill="#F59E0B" filter="url(#shadowLight)"/>

  <!-- 折線標籤 -->
  <text x="252" y="165" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">一</text>
  <text x="282" y="165" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">二</text>
  <text x="312" y="165" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">三</text>
  <text x="342" y="165" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">四</text>

  <!-- 用途說明 -->
  <text x="299" y="218" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">顯示趨勢變化</text>
  <text x="299" y="232" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">例如：每月溫度</text>

  <!-- 箭頭標示 -->
  <line x1="299" y1="240" x2="299" y2="258" stroke="#F59E0B" stroke-width="1.5" marker-end="url(#arrowOrange)" stroke-dasharray="3,2"/>

  <!-- ============ 右欄：圓形圖 ============ -->
  <g filter="url(#shadowLight)">
    <rect x="399" y="50" width="185" height="155" rx="10" fill="white" stroke="#E2E8F0" stroke-width="1"/>
  </g>
  <text x="491" y="75" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="13" font-weight="bold" fill="#10B981">🥧 圓形圖</text>

  <!-- 圓形圖 -->
  <g transform="translate(491,130)">
    <!-- 三個扇形 -->
    <path d="M0,-40 A40,40 0 0,1 34.6,20 L0,0 Z" fill="url(#gradPie1)" filter="url(#shadowLight)"/>
    <path d="M34.6,20 A40,40 0 0,1 -20,34.6 L0,0 Z" fill="url(#gradPie2)" filter="url(#shadowLight)"/>
    <path d="M-20,34.6 A40,40 0 0,1 0,-40 L0,0 Z" fill="url(#gradPie3)" filter="url(#shadowLight)"/>
  </g>

  <!-- 圖例 -->
  <rect x="460" y="175" width="8" height="8" rx="2" fill="url(#gradPie1)"/>
  <text x="472" y="183" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">A組</text>
  <rect x="500" y="175" width="8" height="8" rx="2" fill="url(#gradPie2)"/>
  <text x="512" y="183" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">B組</text>
  <rect x="540" y="175" width="8" height="8" rx="2" fill="url(#gradPie3)"/>
  <text x="552" y="183" font-family="Microsoft YaHei, sans-serif" font-size="8" fill="#64748B">C組</text>

  <!-- 用途說明 -->
  <text x="491" y="218" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">顯示比例分布</text>
  <text x="491" y="232" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">例如：喜好調查</text>

  <!-- 箭頭標示 -->
  <line x1="491" y1="240" x2="491" y2="258" stroke="#10B981" stroke-width="1.5" marker-end="url(#arrowGreen)" stroke-dasharray="3,2"/>

  <!-- ============ 底部總結 ============ -->
  <g filter="url(#shadow)">
    <rect x="30" y="270" width="540" height="115" rx="12" fill="white" stroke="#E2E8F0" stroke-width="1"/>
  </g>

  <text x="300" y="295" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="14" font-weight="bold" fill="#1E293B">💡 何時使用哪種圖表？</text>

  <!-- 三個總結框 -->
  <rect x="50" y="308" width="160" height="60" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <text x="130" y="328" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" font-weight="bold" fill="#4F46E5">長條圖</text>
  <text x="130" y="345" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">比較不同項目的</text>
  <text x="130" y="358" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">數量差異</text>

  <rect x="220" y="308" width="160" height="60" rx="8" fill="#FFFBEB" stroke="#FDE68A" stroke-width="1"/>
  <text x="300" y="328" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" font-weight="bold" fill="#F59E0B">折線圖</text>
  <text x="300" y="345" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">觀察數據隨著</text>
  <text x="300" y="358" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">時間的變化</text>

  <rect x="390" y="308" width="160" height="60" rx="8" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="1"/>
  <text x="470" y="328" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="11" font-weight="bold" fill="#10B981">圓形圖</text>
  <text x="470" y="345" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">顯示各部分</text>
  <text x="470" y="358" text-anchor="middle" font-family="Microsoft YaHei, sans-serif" font-size="9" fill="#475569">占整體的比例</text>

  <!-- 底部裝飾線 -->
  <line x1="180" y1="338" x2="220" y2="338" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="4,3"/>
  <line x1="380" y1="338" x2="390" y2="338" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="4,3"/>
</svg>