<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <!-- 陰影濾鏡 -->
    <filter id="shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#00000025"/>
    </filter>
    <filter id="shadowLight" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="1" dy="2" stdDeviation="3" flood-color="#00000018"/>
    </filter>
    <!-- 箭頭標記 -->
    <marker id="arrowBlue" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#4F46E5"/>
    </marker>
    <marker id="arrowOrange" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#F59E0B"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 L2,4 Z" fill="#10B981"/>
    </marker>
    <!-- 漸變 -->
    <linearGradient id="gradBlue" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#7C73E8"/>
    </linearGradient>
    <linearGradient id="gradOrange" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#FBBF24"/>
    </linearGradient>
    <linearGradient id="gradGreen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="gradRuler" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>
  </defs>

  <!-- 背景 -->
  <rect width="600" height="400" fill="#F9FAFB" rx="12"/>

  <!-- 標題 -->
  <text x="300" y="38" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="22" font-weight="bold" fill="#1F2937">📏 長度與測量 — cm 和 mm 刻度</text>
  <line x1="180" y1="48" x2="420" y2="48" stroke="#4F46E5" stroke-width="2" opacity="0.4"/>

  <!-- ==================== 尺子 ==================== -->
  <g filter="url(#shadow)">
    <!-- 尺子主體 -->
    <rect x="40" y="70" width="520" height="56" rx="6" fill="url(#gradRuler)" stroke="#D1D5DB" stroke-width="1.5"/>
    <!-- 尺子邊框裝飾 -->
    <rect x="40" y="70" width="520" height="56" rx="6" fill="none" stroke="#E5E7EB" stroke-width="0.5"/>

    <!-- cm 刻度（長線）和數字 -->
    <!-- 0~15 cm -->
    <g font-family="Microsoft YaHei, SimHei, sans-serif" font-size="11" fill="#4B5563" text-anchor="middle">
      <text x="72" y="100">0</text>
      <text x="104" y="100">1</text>
      <text x="136" y="100">2</text>
      <text x="168" y="100">3</text>
      <text x="200" y="100">4</text>
      <text x="232" y="100">5</text>
      <text x="264" y="100">6</text>
      <text x="296" y="100">7</text>
      <text x="328" y="100">8</text>
      <text x="360" y="100">9</text>
      <text x="392" y="100">10</text>
      <text x="424" y="100">11</text>
      <text x="456" y="100">12</text>
      <text x="488" y="100">13</text>
      <text x="520" y="100">14</text>
      <text x="552" y="100">15</text>
    </g>

    <!-- 刻度線 -->
    <g stroke="#6B7280" stroke-width="1.2">
      <!-- 每cm長線 -->
      <line x1="72" y1="78" x2="72" y2="108"/>
      <line x1="104" y1="78" x2="104" y2="108"/>
      <line x1="136" y1="78" x2="136" y2="108"/>
      <line x1="168" y1="78" x2="168" y2="108"/>
      <line x1="200" y1="78" x2="200" y2="108"/>
      <line x1="232" y1="78" x2="232" y2="108"/>
      <line x1="264" y1="78" x2="264" y2="108"/>
      <line x1="296" y1="78" x2="296" y2="108"/>
      <line x1="328" y1="78" x2="328" y2="108"/>
      <line x1="360" y1="78" x2="360" y2="108"/>
      <line x1="392" y1="78" x2="392" y2="108"/>
      <line x1="424" y1="78" x2="424" y2="108"/>
      <line x1="456" y1="78" x2="456" y2="108"/>
      <line x1="488" y1="78" x2="488" y2="108"/>
      <line x1="520" y1="78" x2="520" y2="108"/>
      <line x1="552" y1="78" x2="552" y2="108"/>
    </g>

    <!-- mm 刻度（短線） -->
    <g stroke="#9CA3AF" stroke-width="0.8">
      <line x1="78" y1="78" x2="78" y2="95"/>
      <line x1="84" y1="78" x2="84" y2="95"/>
      <line x1="90" y1="78" x2="90" y2="95"/>
      <line x1="96" y1="78" x2="96" y2="95"/>
      <line x1="110" y1="78" x2="110" y2="95"/>
      <line x1="116" y1="78" x2="116" y2="95"/>
      <line x1="122" y1="78" x2="122" y2="95"/>
      <line x1="128" y1="78" x2="128" y2="95"/>
      <line x1="142" y1="78" x2="142" y2="95"/>
      <line x1="148" y1="78" x2="148" y2="95"/>
      <line x1="154" y1="78" x2="154" y2="95"/>
      <line x1="160" y1="78" x2="160" y2="95"/>
      <line x1="174" y1="78" x2="174" y2="95"/>
      <line x1="180" y1="78" x2="180" y2="95"/>
      <line x1="186" y1="78" x2="186" y2="95"/>
      <line x1="192" y1="78" x2="192" y2="95"/>
      <line x1="206" y1="78" x2="206" y2="95"/>
      <line x1="212" y1="78" x2="212" y2="95"/>
      <line x1="218" y1="78" x2="218" y2="95"/>
      <line x1="224" y1="78" x2="224" y2="95"/>
      <line x1="238" y1="78" x2="238" y2="95"/>
      <line x1="244" y1="78" x2="244" y2="95"/>
      <line x1="250" y1="78" x2="250" y2="95"/>
      <line x1="256" y1="78" x2="256" y2="95"/>
      <line x1="270" y1="78" x2="270" y2="95"/>
      <line x1="276" y1="78" x2="276" y2="95"/>
      <line x1="282" y1="78" x2="282" y2="95"/>
      <line x1="288" y1="78" x2="288" y2="95"/>
      <line x1="302" y1="78" x2="302" y2="95"/>
      <line x1="308" y1="78" x2="308" y2="95"/>
      <line x1="314" y1="78" x2="314" y2="95"/>
      <line x1="320" y1="78" x2="320" y2="95"/>
      <line x1="334" y1="78" x2="334" y2="95"/>
      <line x1="340" y1="78" x2="340" y2="95"/>
      <line x1="346" y1="78" x2="346" y2="95"/>
      <line x1="352" y1="78" x2="352" y2="95"/>
      <line x1="366" y1="78" x2="366" y2="95"/>
      <line x1="372" y1="78" x2="372" y2="95"/>
      <line x1="378" y1="78" x2="378" y2="95"/>
      <line x1="384" y1="78" x2="384" y2="95"/>
      <line x1="398" y1="78" x2="398" y2="95"/>
      <line x1="404" y1="78" x2="404" y2="95"/>
      <line x1="410" y1="78" x2="410" y2="95"/>
      <line x1="416" y1="78" x2="416" y2="95"/>
      <line x1="430" y1="78" x2="430" y2="95"/>
      <line x1="436" y1="78" x2="436" y2="95"/>
      <line x1="442" y1="78" x2="442" y2="95"/>
      <line x1="448" y1="78" x2="448" y2="95"/>
      <line x1="462" y1="78" x2="462" y2="95"/>
      <line x1="468" y1="78" x2="468" y2="95"/>
      <line x1="474" y1="78" x2="474" y2="95"/>
      <line x1="480" y1="78" x2="480" y2="95"/>
      <line x1="494" y1="78" x2="494" y2="95"/>
      <line x1="500" y1="78" x2="500" y2="95"/>
      <line x1="506" y1="78" x2="506" y2="95"/>
      <line x1="512" y1="78" x2="512" y2="95"/>
      <line x1="526" y1="78" x2="526" y2="95"/>
      <line x1="532" y1="78" x2="532" y2="95"/>
      <line x1="538" y1="78" x2="538" y2="95"/>
      <line x1="544" y1="78" x2="544" y2="95"/>
    </g>

    <!-- cm 標籤 -->
    <text x="555" y="115" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#9CA3AF" text-anchor="end">cm</text>
  </g>

  <!-- ==================== 測量物品 1：鉛筆 ==================== -->
  <g filter="url(#shadowLight)">
    <!-- 鉛筆本體 -->
    <rect x="72" y="145" width="168" height="18" rx="3" fill="url(#gradOrange)" opacity="0.9"/>
    <!-- 筆尖 -->
    <polygon points="240,145 252,154 240,163" fill="#F59E0B"/>
    <polygon points="252,154 256,154 252,150" fill="#1F2937"/>
    <!-- 橡皮擦 -->
    <rect x="72" y="145" width="16" height="18" rx="2" fill="#EF4444" opacity="0.8"/>
    <!-- 筆身裝飾 -->
    <line x1="92" y1="149" x2="92" y2="159" stroke="#FBBF24" stroke-width="1" opacity="0.5"/>
    <line x1="100" y1="149" x2="100" y2="159" stroke="#FBBF24" stroke-width="1" opacity="0.5"/>
    <line x1="108" y1="149" x2="108" y2="159" stroke="#FBBF24" stroke-width="1" opacity="0.5"/>
  </g>

  <!-- 鉛筆測量標註 -->
  <line x1="72" y1="170" x2="72" y2="195" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="240" y1="170" x2="240" y2="195" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="72" y1="190" x2="240" y2="190" stroke="#4F46E5" stroke-width="2" marker-start="url(#arrowBlue)" marker-end="url(#arrowBlue)"/>
  <rect x="115" y="182" width="82" height="20" rx="10" fill="#4F46E5" opacity="0.9"/>
  <text x="156" y="196" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#FFFFFF">鉛筆 = 8 cm</text>

  <!-- ==================== 測量物品 2：迴紋針 ==================== -->
  <g filter="url(#shadowLight)">
    <!-- 迴紋針 -->
    <path d="M330,150 Q330,140 340,140 L370,140 Q380,140 380,150 Q380,160 370,160 L340,160 Q332,160 332,152 L332,148" 
          fill="none" stroke="#10B981" stroke-width="4" stroke-linecap="round"/>
  </g>

  <!-- 迴紋針測量標註 -->
  <line x1="330" y1="170" x2="330" y2="195" stroke="#10B981" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="380" y1="170" x2="380" y2="195" stroke="#10B981" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="330" y1="190" x2="380" y2="190" stroke="#10B981" stroke-width="2" marker-start="url(#arrowGreen)" marker-end="url(#arrowGreen)"/>
  <rect x="336" y="182" width="68" height="20" rx="10" fill="#10B981" opacity="0.9"/>
  <text x="370" y="196" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#FFFFFF">迴紋針 = 2 cm</text>

  <!-- ==================== 測量物品 3：橡皮擦 ==================== -->
  <g filter="url(#shadowLight)">
    <!-- 橡皮擦 -->
    <rect x="440" y="147" width="96" height="14" rx="3" fill="#4F46E5" opacity="0.85"/>
    <rect x="440" y="147" width="96" height="14" rx="3" fill="none" stroke="#4F46E5" stroke-width="1"/>
    <!-- 橡皮擦包裝紙 -->
    <rect x="440" y="147" width="30" height="14" rx="3" fill="#FFFFFF" opacity="0.3"/>
    <text x="455" y="157" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="7" fill="#FFFFFF" opacity="0.8">橡皮</text>
  </g>

  <!-- 橡皮擦測量標註 -->
  <line x1="440" y1="168" x2="440" y2="195" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="536" y1="168" x2="536" y2="195" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="440" y1="190" x2="536" y2="190" stroke="#F59E0B" stroke-width="2" marker-start="url(#arrowOrange)" marker-end="url(#arrowOrange)"/>
  <rect x="453" y="182" width="70" height="20" rx="10" fill="#F59E0B" opacity="0.9"/>
  <text x="488" y="196" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="12" font-weight="bold" fill="#FFFFFF">橡皮擦 = 3 cm</text>

  <!-- ==================== 底部提示 ==================== -->
  <g transform="translate(0, 240)">
    <rect x="40" y="0" width="520" height="140" rx="10" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1" filter="url(#shadowLight)"/>
    
    <!-- 提示標題 -->
    <rect x="40" y="0" width="520" height="36" rx="10" fill="#4F46E5" opacity="0.08"/>
    <text x="300" y="24" text-anchor="middle" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="14" font-weight="bold" fill="#4F46E5">💡 小提示</text>

    <!-- 提示內容 -->
    <text x="60" y="58" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="13" fill="#374151">
      <tspan x="60" dy="0">• 1 厘米 (cm) = 10 毫米 (mm)</tspan>
      <tspan x="60" dy="22">• 測量時，物品的一端要對準尺子的 0 刻度線</tspan>
      <tspan x="60" dy="22">• 讀取長度時，視線要與刻度線垂直</tspan>
    </text>

    <!-- 長度對比圖示 -->
    <g transform="translate(60, 110)">
      <rect x="0" y="0" width="80" height="10" rx="4" fill="#F59E0B" opacity="0.8"/>
      <text x="0" y="22" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#6B7280">鉛筆 8 cm</text>
    </g>
    <g transform="translate(200, 110)">
      <rect x="0" y="0" width="30" height="10" rx="4" fill="#10B981" opacity="0.8"/>
      <text x="0" y="22" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#6B7280">迴紋針 2 cm</text>
    </g>
    <g transform="translate(340, 110)">
      <rect x="0" y="0" width="45" height="10" rx="4" fill="#4F46E5" opacity="0.8"/>
      <text x="0" y="22" font-family="Microsoft YaHei, SimHei, sans-serif" font-size="10" fill="#6B7280">橡皮擦 3 cm</text>
    </g>
  </g>

  <!-- 裝飾圓點 -->
  <circle cx="30" cy="30" r="4" fill="#4F46E5" opacity="0.15"/>
  <circle cx="570" cy="30" r="4" fill="#F59E0B" opacity="0.15"/>
  <circle cx="30" cy="370" r="4" fill="#10B981" opacity="0.15"/>
  <circle cx="570" cy="370" r="4" fill="#4F46E5" opacity="0.15"/>
</svg>