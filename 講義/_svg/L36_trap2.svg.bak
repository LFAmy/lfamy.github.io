<svg viewBox="0 0 300 180" width="300" height="180" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <rect x="40" y="50" width="180" height="90" fill="#DBEAFE" stroke="#1E40AF" stroke-width="2"/>
  <text x="130" y="100" text-anchor="middle" font-size="10" fill="#1E40AF" font-weight="bold">A：長方形 12×8 = 96cm²</text>
  <polygon points="220,140 300,50 300,140" fill="#FEE2E2" stroke="#DC2626" stroke-width="2"/>
  <text x="260" y="100" text-anchor="middle" font-size="10" fill="#DC2626" font-weight="bold">B：三角形 10×6÷2 = 30cm²</text>
  <text x="260" y="60" text-anchor="middle" font-size="8" fill="#DC2626">底10</text>
  <text x="308" y="100" text-anchor="middle" font-size="8" fill="#DC2626">高6</text>
  <text x="150" y="175" text-anchor="middle" font-size="9" fill="#475569">總面積 = 96+30 = 126cm²  ❌ 陷阱：三角形忘記÷2！</text>
</svg>