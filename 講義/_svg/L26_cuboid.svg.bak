<svg viewBox="0 0 240 200" width="240" height="200" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <polygon points="40,50 160,30 240,50 120,70" fill="#DBEAFE" stroke="#1E40AF" stroke-width="2"/>
  <polygon points="40,50 40,150 160,170 160,70" fill="#BFDBFE" stroke="#1E40AF" stroke-width="2"/>
  <polygon points="160,70 240,50 240,150 160,170" fill="#93C5FD" stroke="#1E40AF" stroke-width="2"/>
  <text x="90" y="40" text-anchor="middle" font-size="10" fill="#1E40AF" font-weight="bold">長方體</text>
  <text x="20" y="105" text-anchor="middle" font-size="9" fill="#475569">高</text>
  <text x="20" y="117" text-anchor="middle" font-size="9" fill="#475569">6cm</text>
  <text x="140" y="180" text-anchor="middle" font-size="9" fill="#475569">長 12cm</text>
  <text x="200" y="110" text-anchor="middle" font-size="9" fill="#475569">闊 8cm</text>
  <text x="120" y="120" text-anchor="middle" font-size="8" fill="#1E3A5F">體積 = 12×8×6 = 576cm³</text>
  <text x="120" y="135" text-anchor="middle" font-size="8" fill="#1E3A5F">表面積 = 2(12×8+12×6+8×6)</text>
  <text x="120" y="150" text-anchor="middle" font-size="8" fill="#1E3A5F">= 2(96+72+48) = 432cm²</text>
</svg>