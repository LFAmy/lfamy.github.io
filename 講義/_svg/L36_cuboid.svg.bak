<svg viewBox="0 0 240 200" width="240" height="200" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <polygon points="50,50 150,35 220,50 120,65" fill="#DBEAFE" stroke="#1E40AF" stroke-width="2"/>
  <polygon points="50,50 50,140 120,155 120,65" fill="#BFDBFE" stroke="#1E40AF" stroke-width="2"/>
  <polygon points="120,65 220,50 220,140 120,155" fill="#93C5FD" stroke="#1E40AF" stroke-width="2"/>
  <text x="85" y="40" text-anchor="middle" font-size="10" fill="#1E40AF" font-weight="bold">長方體</text>
  <text x="35" y="100" font-size="8" fill="#475569">高 3cm</text>
  <text x="135" y="170" text-anchor="middle" font-size="8" fill="#475569">長 5cm</text>
  <text x="170" y="105" font-size="8" fill="#475569">闊 4cm</text>
  <text x="120" y="125" text-anchor="middle" font-size="8" fill="#059669">✅ 體積 = 5×4×3 = 60cm³</text>
  <text x="120" y="140" text-anchor="middle" font-size="8" fill="#DC2626">❌ 陷阱: 5×4=20cm² (混淆表面積！)</text>
</svg>