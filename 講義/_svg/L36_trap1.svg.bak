<svg viewBox="0 0 280 170" width="280" height="170" xmlns="http://www.w3.org/2000/svg" style="max-width:100%; height:auto;">
  <polygon points="40,130 240,130 200,40 80,40" fill="#FEE2E2" stroke="#DC2626" stroke-width="2"/>
  <text x="140" y="25" text-anchor="middle" font-size="11" fill="#DC2626" font-weight="bold">梯形面積 = (上底+下底)×高÷2</text>
  <line x1="80" y1="40" x2="80" y2="135" stroke="#DC2626" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="50" y="90" text-anchor="middle" font-size="9" fill="#DC2626">高 4cm</text>
  <text x="140" y="148" text-anchor="middle" font-size="9" fill="#475569">下底 10cm</text>
  <text x="140" y="40" text-anchor="middle" font-size="9" fill="#475569">上底 6cm</text>
  <polygon points="40,130 240,130 200,40 80,40" fill="none" stroke="#DC2626" stroke-width="2"/>
  <text x="140" y="165" text-anchor="middle" font-size="8" fill="#DC2626">❌ 陷阱: (6+10+4)÷2  ❌ — 不可加高進去！</text>
</svg>