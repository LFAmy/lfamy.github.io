<tr><td class="lf-qn">2</td><td>477+386=?</td><td style="color:#16A34A;font-weight:700;">863</td></tr>
<tr><td class="lf-qn">3</td><td>107÷8=?</td><td style="color:#16A34A;font-weight:700;">13...3</td></tr>
</table></div></div>

