  /* ════════════════════════════════════════════════════════
     LF Academy v8.0 — Enhanced A4 Print Styles
     新增: 學生答題空間優化 · 打印裝訂邊距 · 浮水印 · 頁碼美化
     ════════════════════════════════════════════════════════ */
  
  /* Page setup */
  @page {
    size: A4;
    margin: 14mm 16mm 20mm 22mm;  /* left=22mm for binding */
    @top-right {
      content: string(grade-header);
      font-size: 7pt;
      color: var(--lf-gray);
      font-family: var(--font-heading);
    }
    @bottom-left {
      content: "LF Academy | lfacademyhk.com";
      font-size: 6.5pt;
      color: #9CA3AF;
    }
    @bottom-right {
      content: "P " counter(page);
      font-size: 7pt;
      color: var(--lf-gray);
    }
  }
  
  /* Grade header for page top */
  .lf-page::before {
    string-set: grade-header attr(data-grade);
  }
  
  /* Student workspace */
  .lf-line {
    height: 2px;
    background: repeating-linear-gradient(90deg, #D1D5DB 0, #D1D5DB 4px, transparent 4px, transparent 8px);
    margin: 6pt 0 8pt 0;
  }
  
  .lf-answer-space {
    min-height: 28pt;
    border-bottom: 1.5px dashed #D1D5DB;
    margin: 4pt 0;
    padding: 2pt 4pt;
  }
  
  .lf-answer-lines {
    background: repeating-linear-gradient(0deg, transparent 0, transparent 21pt, #E5E7EB 21pt, #E5E7EB 21.5pt);
    min-height: 64pt;
    padding: 2pt 8pt;
    margin: 6pt 0;
  }
  
  /* Cover page */
  .lf-cover {
    page-break-after: always;
  }
  
  /* Trap cards - ensure visibility in B&W print */
  .lf-trap-card {
    border: 2px solid #333 !important;
    background: #FAFAFA !important;
  }
  
  .lf-trap-wrong {
    color: #333 !important;
    font-weight: 700 !important;
    text-decoration: line-through;
  }
  
  .lf-trap-right {
    color: #000 !important;
    font-weight: 900 !important;
    border-left: 3px solid #000;
    padding-left: 8pt;
  }
  
  /* SSPA Challenge questions */
  .enrichment-challenge {
    border: 2px solid #333 !important;
    background: #FAFAFA !important;
  }
  
  /* Prevent content breaks */
  .lf-trap-card, .enrichment-challenge, .lf-ex, .lf-kp {
    page-break-inside: avoid;
  }
  
  h2, h3 {
    page-break-after: avoid;
  }
  
  /* Hide interactive elements */
  .no-print, .lf-game, .lf-ai-section {
    display: none !important;
  }
  
  /* Score/name area */
  .lf-print-header {
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    padding: 8pt 0;
    border-bottom: 1px solid #333;
    margin-bottom: 12pt;
  }
  
  .lf-print-header .name-line {
    display: inline-block;
    min-width: 120pt;
    border-bottom: 1px solid #333;
    margin: 0 4pt;
  }
  
  /* Page break before major sections */
  .lf-sspa-section {
    page-break-before: always;
  }
  
  /* Watermark */
  .lf-page {
    position: relative;
  }
  
  .lf-page::after {
    content: "LF Academy";
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-30deg);
    font-size: 60pt;
    color: rgba(0,0,0,0.03);
    pointer-events: none;
    z-index: -1;
    font-family: var(--font-heading);
    white-space: nowrap;
  }

}

@media screen {
  .lf-footer { display: none; }
  .lf-print-only { display: none; }
