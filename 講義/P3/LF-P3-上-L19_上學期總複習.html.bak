<tr><td class="lf-qn">S3</td><td>計算：6,000 − 2,435 = ？</td><td class="lf-ans">3,565</td></tr>
<tr><td class="lf-qn">S4</td><td>計算：234 × 3 = ？</td><td class="lf-ans">702</td></tr>
