<tr><td class="lf-qn">2</td><td>69+203=?</td><td style="color:#16A34A;font-weight:700;">272</td></tr>
<tr><td class="lf-qn">3</td><td>16×13=?</td><td style="color:#16A34A;font-weight:700;">208</td></tr>
</table></div></div>

