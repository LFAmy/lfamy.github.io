                <span class="lf-trap-id">LF-T2-P5-0604</span>
            </div>
            <div>
                <div class="lf-trap-q">計算 4.56 × 0.3 = ?</div>
                <div class="lf-trap-wrong">
                    <span class="lf-ex-label">常見錯誤：</span>13.68
                </div>
                <div class="trap-correct">
