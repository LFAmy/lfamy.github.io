<!DOCTYPE html>

<html lang="zh-HK">
<head><meta content="小學四年級數學練習：倍數與因數進階。涵蓋小學數學 練習。霖楓學苑呈分試專家，陷阱題診斷教學法。" name="description"/>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>小學四年級數學 倍數與因數進階 | 霖楓學苑 LF Academy</title>
<style>
/* ═══════════════════════════════════════════════════════════════
   LF Academy v7.0 — A4 Print-First Lecture Stylesheet
   設計理念：A4打印優先 · 學生答題空間 · 教科書級排版
   角色視角：學生(清晰易讀+充足空間) · 教師(便於批改) · 家長(專業呈現)
   打印特色：姓名日期區 · 行線答題區 · 筆記區 · 頁碼 · 裝訂邊距
   v7.0 變更：全面重構打印體驗，強化學生做功課空間
   ═══════════════════════════════════════════════════════════════ */

@import url('"'"'https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@400;500;700;900&family=Noto+Serif+HK:wght@600;700;900&display=swap'"'"');

/* === CSS Custom Properties === */
:root {
  /* Brand */
  --lf-blue: #1A3C6D;
  --lf-gold: #C9A84C;
  --lf-ink: #1A1A1A;
  --lf-gray: #6B7280;
  --lf-light: #F9FAFB;
  --lf-border: #D1D5DB;
  
  /* Semantic */
  --red: #DC2626;
  --green: #059669;
  --purple: #7C3AED;
  --amber: #D97706;
  --sky: #0284C7;
  
  /* Typography */
  --font-body: '"'"'Noto Sans HK'"'"', -apple-system, '"'"'Microsoft YaHei'"'"', sans-serif;
  --font-heading: '"'"'Noto Serif HK'"'"', '"'"'Noto Sans HK'"'"', serif;
  --fs-body: 11pt;
  --fs-small: 9pt;
  --fs-h1: 15pt;
  --fs-h2: 12.5pt;
  --fs-h3: 11.5pt;
  --fs-title: 22pt;
  --lh-body: 1.9;
  --lh-tight: 1.4;
  --lh-answer: 2.2;  /* extra spacing for handwriting */
  
  /* Spacing */
  --sp-1: 4pt;
  --sp-2: 8pt;
  --sp-3: 12pt;
  --sp-4: 16pt;
  --sp-5: 24pt;
  --sp-6: 32pt;
  --sp-8: 48pt;
}

/* === Reset === */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

/* === Screen Base === */
body {
  font-family: var(--font-body);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--lf-ink);
  background: #E8E8E8;
  -webkit-font-smoothing: antialiased;
}

/* ═══════════════════════════════════════════════════════════════
   PAGE CONTAINER (A4 on screen)
   ═══════════════════════════════════════════════════════════════ */
.lf-page {
  width: 210mm;
  min-height: 297mm;
  margin: 12pt auto;
  background: #FFFFFF;
  box-shadow: 0 2px 20px rgba(0,0,0,0.12);
  padding: 14mm 15mm 20mm 20mm;  /* left=20mm for binding */
  position: relative;
  page-break-after: always;
}

/* ═══════════════════════════════════════════════════════════════
   STUDENT INFO BLOCK (NEW v7.0)
   ═══════════════════════════════════════════════════════════════ */
.lf-student-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12pt;
  align-items: center;
  padding: 8pt 12pt;
  margin-bottom: var(--sp-4);
  border: 0.5pt solid var(--lf-border);
  border-radius: 4pt;
  background: #FAFAFA;
  font-size: var(--fs-small);
  page-break-inside: avoid;
}

.lf-student-info .lf-si-label {
  font-weight: 700;
  color: var(--lf-blue);
  margin-right: 4pt;
}

.lf-student-info .lf-si-line {
  display: inline-block;
  min-width: 60pt;
  border-bottom: 0.5pt solid var(--lf-border);
  padding: 0 4pt;
}

.lf-student-info .lf-si-spacer { flex: 1; }

/* ═══════════════════════════════════════════════════════════════
   COVER PAGE
   ═══════════════════════════════════════════════════════════════ */
.lf-cover {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  min-height: 252mm;
  padding: 20mm 15mm;
}

.lf-cover-logo {
  font-family: var(--font-heading);
  font-size: 18pt;
  font-weight: 900;
  color: var(--lf-blue);
  letter-spacing: 6pt;
  margin-bottom: var(--sp-4);
}

.lf-cover-grade {
  display: inline-block;
  border: 1.5pt solid var(--lf-gold);
  color: var(--lf-gold);
  padding: 4pt 20pt;
  border-radius: 20pt;
  font-size: 11pt;
  letter-spacing: 3pt;
  margin-bottom: var(--sp-4);
}

.lf-cover-title {
  font-family: var(--font-heading);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--lf-blue);
  letter-spacing: 2pt;
  margin-bottom: var(--sp-2);
  line-height: 1.3;
}

.lf-cover-subtitle {
  font-size: var(--fs-small);
  color: var(--lf-gray);
  margin-bottom: var(--sp-5);
}

.lf-cover-info {
  display: inline-block;
  text-align: left;
  background: var(--lf-light);
  border: 0.5pt solid var(--lf-border);
  border-radius: 6pt;
  padding: 14pt 20pt;
  font-size: var(--fs-small);
  line-height: 2;
  max-width: 260pt;
}

.lf-cover-info b { color: var(--lf-blue); font-weight: 700; }

.lf-cover-row {
  margin-top: var(--sp-5);
  font-size: var(--fs-small);
  display: flex;
  gap: 24pt;
  flex-wrap: wrap;
  justify-content: center;
}

.lf-cover-row .lf-line {
  display: inline-block;
  width: 80pt;
  border-bottom: 0.5pt solid var(--lf-border);
}

/* ═══════════════════════════════════════════════════════════════
   SECTION HEADINGS
   ═══════════════════════════════════════════════════════════════ */
.lf-h1 {
  font-family: var(--font-heading);
  font-size: var(--fs-h1);
  font-weight: 900;
  color: var(--lf-blue);
  margin: var(--sp-6) 0 var(--sp-3) 0;
  padding-bottom: var(--sp-2);
  border-bottom: 1.5pt solid var(--lf-gold);
  page-break-after: avoid;
}

.lf-h2 {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--lf-blue);
  margin: var(--sp-4) 0 var(--sp-2) 0;
  padding-left: 8pt;
  border-left: 3pt solid var(--lf-gold);
  page-break-after: avoid;
}

.lf-h3 {
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--lf-ink);
  margin: var(--sp-3) 0 var(--sp-1) 0;
}

/* ═══════════════════════════════════════════════════════════════
   KNOWLEDGE POINT BOX
   ═══════════════════════════════════════════════════════════════ */
.lf-kp {
  background: var(--lf-light);
  border: 0.5pt solid var(--lf-border);
  border-radius: 6pt;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-3) 0;
  page-break-inside: avoid;
}

.lf-kp-title {
  font-weight: 900;
  color: var(--lf-blue);
  font-size: var(--fs-h3);
  margin-bottom: var(--sp-2);
}

.lf-kp-rules {
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.lf-kp-rules strong { color: var(--lf-blue); }

/* ═══════════════════════════════════════════════════════════════
   QUESTION TABLE
   ═══════════════════════════════════════════════════════════════ */
.lf-qt {
  width: 100%;
  border-collapse: collapse;
  margin: var(--sp-3) 0;
  font-size: var(--fs-body);
  table-layout: fixed;
}

.lf-qt th {
  background: var(--lf-blue);
  color: #FFFFFF;
  padding: 6pt 8pt;
  text-align: center;
  font-size: var(--fs-small);
  font-weight: 700;
  letter-spacing: 0.5pt;
}

.lf-qt td {
  padding: 5pt 8pt;
  border-bottom: 0.3pt solid var(--lf-border);
  vertical-align: top;
}

.lf-qt tr:nth-child(even) td { background: #FAFBFC; }

.lf-qt .lf-qt-num {
  width: 36pt;
  text-align: center;
  font-weight: 700;
  color: var(--lf-blue);
}

.lf-qt .lf-qt-ans {
  min-width: 80pt;
}

/* ═══════════════════════════════════════════════════════════════
   STORY / HOOK SECTION
   ═══════════════════════════════════════════════════════════════ */
.lf-story {
  background: #EFF6FF;
  border-left: 3pt solid #3B82F6;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-3) 0;
  border-radius: 0 6pt 6pt 0;
  page-break-inside: avoid;
}

.lf-story-title {
  font-weight: 900;
  font-size: var(--fs-h3);
  color: #1E40AF;
  margin-bottom: var(--sp-2);
}

/* ═══════════════════════════════════════════════════════════════
   GAME / INTERACTIVE SECTION
   ═══════════════════════════════════════════════════════════════ */
.lf-game {
  background: #F0FDF4;
  border-left: 3pt solid #22C55E;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-3) 0;
  border-radius: 0 6pt 6pt 0;
  page-break-inside: avoid;
}

.lf-game-title {
  font-weight: 900;
  font-size: var(--fs-h3);
  color: #15803D;
  margin-bottom: var(--sp-2);
}

/* ═══════════════════════════════════════════════════════════════
   WHY / MOTIVATION SECTION
   ═══════════════════════════════════════════════════════════════ */
.lf-why {
  background: #FFF7ED;
  border-left: 3pt solid #F97316;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-3) 0;
  border-radius: 0 6pt 6pt 0;
  page-break-inside: avoid;
}

.lf-why-title {
  font-weight: 900;
  font-size: var(--fs-h3);
  color: #C2410C;
  margin-bottom: var(--sp-2);
}

/* ═══════════════════════════════════════════════════════════════
   WORKED EXAMPLE SECTION (NEW v7.0 - enhanced)
   ═══════════════════════════════════════════════════════════════ */
.lf-ex {
  margin: var(--sp-4) 0;
  border: 0.5pt solid var(--lf-border);
  border-radius: 8pt;
  overflow: hidden;
  page-break-inside: avoid;
}

.lf-ex-title {
  background: var(--lf-blue);
  color: #FFFFFF;
  padding: 6pt 14pt;
  font-weight: 900;
  font-size: var(--fs-small);
  letter-spacing: 0.5pt;
}

.lf-ex-body {
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.lf-ex-wrong {
  background: #FEF2F2;
  border-left: 3pt solid var(--red);
  padding: var(--sp-2) var(--sp-3);
  border-radius: 0 4pt 4pt 0;
  margin-bottom: var(--sp-2);
  font-size: var(--fs-body);
}

.lf-ex-right {
  background: #F0FDF4;
  border-left: 3pt solid var(--green);
  padding: var(--sp-2) var(--sp-3);
  border-radius: 0 4pt 4pt 0;
  font-size: var(--fs-body);
}

/* ═══════════════════════════════════════════════════════════════
   TRAP CARD (enhanced v7.0)
   ═══════════════════════════════════════════════════════════════ */
.lf-trap-card {
  border: 1.2pt solid var(--red);
  border-radius: 8pt;
  margin: var(--sp-4) 0;
  overflow: hidden;
  page-break-inside: avoid;
}

.lf-trap-title {
  background: var(--red);
  color: #FFFFFF;
  padding: 6pt 14pt;
  font-weight: 900;
  font-size: var(--fs-h3);
}

.lf-trap-body {
  padding: var(--sp-3) var(--sp-4);
}

.lf-trap-wrong {
  background: #FEF2F2;
  border-left: 3pt solid var(--red);
  padding: var(--sp-2) var(--sp-3);
  border-radius: 0 4pt 4pt 0;
  margin-bottom: var(--sp-2);
  font-size: var(--fs-body);
}

.lf-trap-right {
  background: #D1FAE5;
  border-left: 3pt solid var(--green);
  padding: var(--sp-2) var(--sp-3);
  border-radius: 0 4pt 4pt 0;
  margin-bottom: var(--sp-1);
  font-size: var(--fs-body);
}

.lf-trap-note {
  font-size: var(--fs-small);
  color: var(--lf-gray);
  font-style: italic;
}

/* ═══════════════════════════════════════════════════════════════
   ANSWER SPACE — RULED LINES (v7.0 enhanced)
   ═══════════════════════════════════════════════════════════════ */
.lf-ans {
  min-height: 32mm;
  margin: var(--sp-2) 0 var(--sp-3) 0;
  padding: 4pt 8pt;
  border: 0.3pt solid var(--lf-border);
  border-radius: 3pt;
  background: repeating-linear-gradient(
    #FFFFFF, #FFFFFF 7.5mm, #D1D5DB 7.5mm, #D1D5DB 7.8mm
  );
  line-height: 2.2;
  font-size: var(--fs-body);
}

.lf-ans-sm {
  min-height: 18mm;
  margin: var(--sp-1) 0 var(--sp-2) 0;
  padding: 4pt 8pt;
  border: 0.3pt solid var(--lf-border);
  border-radius: 3pt;
  background: repeating-linear-gradient(
    #FFFFFF, #FFFFFF 7.5mm, #D1D5DB 7.5mm, #D1D5DB 7.8mm
  );
  line-height: 2.2;
}

.lf-ans-lg {
  min-height: 55mm;
  margin: var(--sp-3) 0;
  padding: 4pt 8pt;
  border: 0.3pt solid var(--lf-border);
  border-radius: 3pt;
  background: repeating-linear-gradient(
    #FFFFFF, #FFFFFF 7.5mm, #D1D5DB 7.5mm, #D1D5DB 7.8mm
  );
  line-height: 2.2;
}

/* ═══════════════════════════════════════════════════════════════
   STUDENT NOTES AREA (NEW v7.0)
   ═══════════════════════════════════════════════════════════════ */
.lf-notes {
  margin: var(--sp-4) 0;
  border: 0.5pt dashed var(--lf-border);
  border-radius: 6pt;
  padding: var(--sp-3);
  page-break-inside: avoid;
}

.lf-notes-title {
  font-weight: 900;
  font-size: var(--fs-h3);
  color: var(--lf-gray);
  margin-bottom: var(--sp-2);
  text-align: center;
}

.lf-notes-lines {
  min-height: 60mm;
  background: repeating-linear-gradient(
    #FFFFFF, #FFFFFF 7.5mm, #E5E7EB 7.5mm, #E5E7EB 7.8mm
  );
  border-radius: 3pt;
}

/* ═══════════════════════════════════════════════════════════════
   TIPS & NOTES
   ═══════════════════════════════════════════════════════════════ */
.lf-tip {
  background: #FFFBEB;
  border: 0.5pt solid #FCD34D;
  border-radius: 6pt;
  padding: var(--sp-2) var(--sp-3);
  margin: var(--sp-2) 0;
  font-size: var(--fs-small);
  page-break-inside: avoid;
}

.lf-note {
  background: #FFFBEB;
  border: 0.5pt solid #FCD34D;
  border-radius: 6pt;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-3) 0;
  font-size: var(--fs-small);
  page-break-inside: avoid;
}

/* ═══════════════════════════════════════════════════════════════
   PARENT SUMMARY
   ═══════════════════════════════════════════════════════════════ */
.lf-parent-summary {
  background: var(--lf-light);
  border: 0.5pt solid var(--lf-border);
  border-radius: 6pt;
  padding: var(--sp-3) var(--sp-4);
  margin-bottom: var(--sp-5);
  font-size: var(--fs-small);
  page-break-inside: avoid;
}

.lf-parent-summary .lf-ps-title {
  font-weight: 900;
  color: var(--lf-blue);
  font-size: var(--fs-h3);
  margin-bottom: var(--sp-1);
}

.lf-ps-tag {
  display: inline-block;
  padding: 1pt 6pt;
  border-radius: 3pt;
  font-size: 8pt;
  font-weight: 700;
  margin-right: 4pt;
}

.lf-ps-tag.trap { background: #FEE2E2; color: var(--red); }
.lf-ps-tag.goal { background: #D1FAE5; color: var(--green); }
.lf-ps-tag.sspa { background: #FEF3C7; color: #92400E; }
.lf-ps-tag.hk { background: #DBEAFE; color: #1E40AF; }

/* ═══════════════════════════════════════════════════════════════
   SSPA BADGE
   ═══════════════════════════════════════════════════════════════ */
.lf-sspa-badge {
  display: inline-block;
  padding: 2pt 8pt;
  border-radius: 3pt;
  font-size: 8pt;
  font-weight: 700;
  margin-left: 4pt;
}

.lf-sspa-high { background: #FEE2E2; color: var(--red); }
.lf-sspa-mid { background: #FEF3C7; color: #92400E; }
.lf-sspa-low { background: #D1FAE5; color: var(--green); }

/* ═══════════════════════════════════════════════════════════════
   AI QUESTION SECTION
   ═══════════════════════════════════════════════════════════════ */
.lf-ai-section {
  background: #F0F9FF;
  border: 0.5pt solid #BAE6FD;
  border-radius: 6pt;
  padding: var(--sp-3) var(--sp-4);
  margin: var(--sp-4) 0;
  page-break-inside: avoid;
}

.lf-ai-title {
  font-weight: 900;
  color: #0369A1;
  font-size: var(--fs-h3);
  margin-bottom: var(--sp-2);
}

/* ═══════════════════════════════════════════════════════════════
   PAGE FOOTER (v7.0 enhanced)
   ═══════════════════════════════════════════════════════════════ */
.lf-footer {
  position: absolute;
  bottom: 8mm;
  left: 15mm;
  right: 15mm;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 7pt;
  color: var(--lf-gray);
  border-top: 0.3pt solid var(--lf-border);
  padding-top: var(--sp-1);
}

.lf-footer-left {
  font-weight: 500;
}

.lf-footer-right {
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════
   UTILITIES
   ═══════════════════════════════════════════════════════════════ */
.lf-page-break { page-break-before: always; }
.lf-no-break { page-break-inside: avoid; }
.lf-text-center { text-align: center; }
.lf-text-right { text-align: right; }

/* ═══════════════════════════════════════════════════════════════
   PRINT OPTIMIZATION (v7.0 — comprehensive)
   ═══════════════════════════════════════════════════════════════ */

@media print {
  @page {
    size: A4;
    margin: 12mm 14mm 18mm 20mm;  /* left=20mm for binding/hole-punch */
    @bottom-center {
      content: "霖楓學苑 LF Academy";
      font-size: 7pt;
      color: #9CA3AF;
      font-family: var(--font-heading);
    }
    @bottom-right {
      content: counter(page);
      font-size: 7pt;
      color: #9CA3AF;
    }
  }
  
  body {
    background: #FFFFFF !important;
    font-size: 10.5pt;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  
  .lf-page {
    width: 100%;
    min-height: auto;
    margin: 0;
    box-shadow: none;
    padding: 0;
    page-break-after: always;
  }
  
  .lf-page:last-child { page-break-after: avoid; }
  
  /* Remove colored backgrounds for ink saving, keep left accents */
  .lf-story, .lf-game, .lf-why, .lf-tip, .lf-note, .lf-ai-section,
  .lf-kp, .lf-parent-summary, .lf-ex-wrong, .lf-ex-right,
  .lf-trap-wrong, .lf-trap-right, .lf-cover-info, .lf-student-info {
    background: #FFFFFF !important;
  }
  
  /* Preserve left border accents */
  .lf-story { border-left: 2pt solid #3B82F6 !important; background: #FFFFFF !important; }
  .lf-game { border-left: 2pt solid #22C55E !important; background: #FFFFFF !important; }
  .lf-why { border-left: 2pt solid #F97316 !important; background: #FFFFFF !important; }
  .lf-ex-wrong { border-left: 2pt solid var(--red) !important; }
  .lf-ex-right { border-left: 2pt solid var(--green) !important; }
  .lf-trap-wrong { border-left: 2pt solid var(--red) !important; }
  .lf-trap-right { border-left: 2pt solid var(--green) !important; }
  .lf-trap-card { border-color: var(--red) !important; }
  
  /* Answer ruled lines — preserved and enhanced for print */
  .lf-ans, .lf-ans-sm, .lf-ans-lg {
    background: repeating-linear-gradient(
      #FFFFFF, #FFFFFF 7.5mm, #C8CCD0 7.5mm, #C8CCD0 7.8mm
    ) !important;
    border-color: #9CA3AF !important;
  }
  
  .lf-notes-lines {
    background: repeating-linear-gradient(
      #FFFFFF, #FFFFFF 7.5mm, #D1D5DB 7.5mm, #D1D5DB 7.8mm
    ) !important;
  }
  
  /* Typography adjustments for print */
  .lf-cover-title { font-size: 20pt; }
  .lf-h1 { font-size: 14pt; }
  .lf-h2 { font-size: 12pt; }
  .lf-qt { font-size: 10pt; }
  .lf-qt th { background: var(--lf-blue) !important; color: #FFFFFF !important; }
  
  /* Avoid bad page breaks */
  .lf-h1, .lf-h2, .lf-h3, .lf-kp, .lf-ex, .lf-trap-card,
  .lf-story, .lf-game, .lf-why, .lf-notes, .lf-student-info { 
    page-break-inside: avoid; 
  }
  
  /* Hide screen-only elements */
  .lf-screen-only { display: none !important; }
  
  /* Show print-only elements */
  .lf-print-only { display: block !important; }
  .lf-footer { display: flex; }
  
  /* MathJax */
  mjx-container[display="true"] { margin: 8pt 0; }
  mjx-container > svg { max-width: 100%; height: auto; }


  /* ════════════════════════════════════════════════════════
     LF Academy v8.0 — Enhanced A4 Print Styles
     新增: 學生答題空間優化 · 打印裝訂邊距 · 浮水印 · 頁碼美化
     ════════════════════════════════════════════════════════ */
  
  /* Page setup */
  @page {
    size: A4;
    margin: 14mm 16mm 20mm 22mm;  /* left=22mm for binding */
    @top-right {
      content: string(grade-header);
      font-size: 7pt;
      color: var(--lf-gray);
      font-family: var(--font-heading);
    }
    @bottom-left {
      content: "LF Academy | lfacademyhk.com";
      font-size: 6.5pt;
      color: #9CA3AF;
    }
    @bottom-right {
      content: "P " counter(page);
      font-size: 7pt;
      color: var(--lf-gray);
    }
  }
  
  /* Grade header for page top */
  .lf-page::before {
    string-set: grade-header attr(data-grade);
  }
  
  /* Student workspace */
  .lf-line {
    height: 2px;
    background: repeating-linear-gradient(90deg, #D1D5DB 0, #D1D5DB 4px, transparent 4px, transparent 8px);
    margin: 6pt 0 8pt 0;
  }
  
  .lf-answer-space {
    min-height: 28pt;
    border-bottom: 1.5px dashed #D1D5DB;
    margin: 4pt 0;
    padding: 2pt 4pt;
  }
  
  .lf-answer-lines {
    background: repeating-linear-gradient(0deg, transparent 0, transparent 21pt, #E5E7EB 21pt, #E5E7EB 21.5pt);
    min-height: 64pt;
    padding: 2pt 8pt;
    margin: 6pt 0;
  }
  
  /* Cover page */
  .lf-cover {
    page-break-after: always;
  }
  
  /* Trap cards - ensure visibility in B&W print */
  .lf-trap-card {
    border: 2px solid #333 !important;
    background: #FAFAFA !important;
  }
  
  .lf-trap-wrong {
    color: #333 !important;
    font-weight: 700 !important;
    text-decoration: line-through;
  }
  
  .lf-trap-right {
    color: #000 !important;
    font-weight: 900 !important;
    border-left: 3px solid #000;
    padding-left: 8pt;
  }
  
  /* SSPA Challenge questions */
  .enrichment-challenge {
    border: 2px solid #333 !important;
    background: #FAFAFA !important;
  }
  
  /* Prevent content breaks */
  .lf-trap-card, .enrichment-challenge, .lf-ex, .lf-kp {
    page-break-inside: avoid;
  }
  
  h2, h3 {
    page-break-after: avoid;
  }
  
  /* Hide interactive elements */
  .no-print, .lf-game, .lf-ai-section {
    display: none !important;
  }
  
  /* Score/name area */
  .lf-print-header {
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    padding: 8pt 0;
    border-bottom: 1px solid #333;
    margin-bottom: 12pt;
  }
  
  .lf-print-header .name-line {
    display: inline-block;
    min-width: 120pt;
    border-bottom: 1px solid #333;
    margin: 0 4pt;
  }
  
  /* Page break before major sections */
  .lf-sspa-section {
    page-break-before: always;
  }
  
  /* Watermark */
  .lf-page {
    position: relative;
  }
  
  .lf-page::after {
    content: "LF Academy";
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-30deg);
    font-size: 60pt;
    color: rgba(0,0,0,0.03);
    pointer-events: none;
    z-index: -1;
    font-family: var(--font-heading);
    white-space: nowrap;
  }

}

@media screen {
  .lf-footer { display: none; }
  .lf-print-only { display: none; }
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE (mobile/tablet)
   ═══════════════════════════════════════════════════════════════ */
@media screen and (max-width: 768px) {
  .lf-page {
    width: 100%;
    padding: 10mm;
    margin: 0;
    min-height: auto;
  }
  .lf-cover { min-height: auto; padding: 30pt 15pt; }
}


