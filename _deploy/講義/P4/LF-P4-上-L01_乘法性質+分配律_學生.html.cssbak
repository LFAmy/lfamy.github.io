<tr><td colspan="4" style="background:#FEF3C7;font-weight:700;color:#92400E;padding:6px 10px;text-align:center;font-size:12px;">🌱 D1 · 基礎訓練 — 運用交換律和結合律</td></tr>
<tr><td class="lf-qn">1</td><td>5 × 9 × 2 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：交換律，5×2 先算</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">2</td><td>4 × 7 × 25 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：找 4×25 湊整</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">3</td><td>8 × 6 × 125 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：8×125=1000</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">4</td><td>3 × (4 × 5) = ?</td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">5</td><td>(25 × 2) × 7 = ?</td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">6</td><td>8 × (7 + 3) = ?<br/><span style="font-size:10px;color:var(--gray);">提示：用分配律展開</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<!-- D2 header -->
<tr><td colspan="4" style="background:#DCFCE7;font-weight:700;color:#166534;padding:6px 10px;text-align:center;font-size:12px;">🌿 D2 · 進階挑戰 — 分配律拆數技巧</td></tr>
<tr><td class="lf-qn">7</td><td>25 × 12 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：12 = 10 + 2</span></td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">8</td><td>15 × 14 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：15 × (10 + 4)</span></td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">9</td><td>125 × 8 × 3 = ?</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">10</td><td>36 × 25 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：36 = 9 × 4，再用結合律</span></td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">11</td><td>24 × 15 = ?</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">12</td><td>18 × 35 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：18 × (30 + 5)</span></td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<!-- D3 header -->
<tr><td colspan="4" style="background:#DBEAFE;font-weight:700;color:#1E40AF;padding:6px 10px;text-align:center;font-size:12px;">🌳 D3 · 高手挑戰 — 靈活運用三大性質</td></tr>
<tr><td class="lf-qn">13</td><td>48 × 25 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：48 = 12 × 4</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">14</td><td>125 × 32 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：32 = 8 × 4</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">15</td><td>99 × 25 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：99 = 100 − 1</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">16</td><td>75 × 16 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：75 = 3 × 25，16 = 4 × 4</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">17</td><td>64 × 125 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：64 = 8 × 8</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">18</td><td>125 × 72 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：72 = 8 × 9</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">19</td><td>25 × 44 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：44 = 40 + 4 或 44 = 4 × 11</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">20</td><td>36 × 35 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：36 × (30 + 5) 或拆成 6 × 6 × 5 × 7</span></td><td class="qd d3">🌳</td><td class="lf-ans"></td></tr>
