<tr><td class="lf-qn">2</td><td>25 × 3 × 4 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：25 找 4</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">3</td><td>125 × 7 × 8 = ?<br/><span style="font-size:10px;color:var(--gray);">提示：125 找 8</span></td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
