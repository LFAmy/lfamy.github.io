<tr><td class="lf-qn">8</td><td><b>56 × 34 = ?</b>（用豎式計算）</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">9</td><td><b>78 × 26 = ?</b>（用豎式計算）</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
</table>
