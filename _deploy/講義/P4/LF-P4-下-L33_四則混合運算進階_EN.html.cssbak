<tr><td class="lf-qn">7</td><td>18 - (7 + 4) = ？（兩種方法）</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:75px;"></td></tr>
<tr><td class="lf-qn">8</td><td>24 - (9 - 5) + (3 + 2) = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:75px;"></td></tr>
</table>
