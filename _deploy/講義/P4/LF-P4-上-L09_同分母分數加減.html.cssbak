<rect x="20" y="20" width="210.0" height="45" fill="#DBEAFE" stroke="#1A3C6D" stroke-width="1"/>
<text x="160.0" y="12" text-anchor="middle" font-size="14" fill="#1A3C6D" font-weight="700" font-family="Noto Sans HK,sans-serif">3/4</text>
