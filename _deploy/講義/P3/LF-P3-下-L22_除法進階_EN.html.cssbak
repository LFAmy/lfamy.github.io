<tr><th class="lf-qn">#</th><th>Question</th><th class="lf-qd">Difficulty</th><th>Answer Area</th></tr>
<tr><td class="lf-qn">16</td><td>74 ÷ 6 = ？（有餘數，檢查餘&lt;6）</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">17</td><td>89 ÷ 7 = ？（直式 + 驗證）</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">18</td><td>判斷對錯：93÷8=11...5。驗證！</td><td class="qd d2">🌿</td><td class="lf-ans"></td></tr>
</table>
<div class="lf-h2">🌳 Challenge Tier（共 3 題）</div>
<table class="lf-qt">
