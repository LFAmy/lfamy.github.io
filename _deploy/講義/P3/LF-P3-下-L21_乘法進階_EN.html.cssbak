<tr><td class="lf-qn">H2</td><td>147 x 2 = ？（直式，注意進位）</td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
<tr><td class="lf-qn">H3</td><td>250 x 4 = ？（尾有0祕技）</td><td class="qd d1">🌱</td><td class="lf-ans"></td></tr>
