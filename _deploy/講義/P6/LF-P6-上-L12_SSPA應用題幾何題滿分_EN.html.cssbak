<tr><td class="lf-qn">23</td><td>Circle形半徑 3 cm。Area = ？（ = 3.14）</td><td class="qd d1">基礎</td><td class="lf-ans" style="min-height:75px;"></td></tr>
<tr><td class="lf-qn">24</td><td>火車 1.5 小時行 135 km。Speed/Rate = ？km/h</td><td class="qd d1">基礎</td><td class="lf-ans" style="min-height:75px;"></td></tr>
