t fill="#6B7280" font-size="9" font-weight="700" text-anchor="end" x="77" y="39">(萬元)</text><text fill="#1A3C6D" font-size="11" text-anchor="middle" transform="rotate(-90,14,162)" x="14" y="162">營業額</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="118.125" y="308">第一季</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="184.375" y="308">第二季</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="250.625" y="308">第三季</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="316.875" y="308">第四季</text><text fill="#1A3C6D" font-size="13" font-weight="700" text-anchor="middle" x="185" y="25">請根據數據繪製折線圖</text><circle cx="115" cy="162" fill="#E5E7EB" r="2" stroke="none"></circle><circle cx="175" cy="162" fill="#E5E7EB" r="2" stroke="none"></circle><circle cx="235" cy="162" fill="#E5E7EB" r="2" stroke="none"></circle><circle cx="295" cy="162" fill="#E5E7EB" r="2" stroke="none"></circle><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="middle" x="185" y="322">（請按數據標出點並連線）</text></svg></div>
