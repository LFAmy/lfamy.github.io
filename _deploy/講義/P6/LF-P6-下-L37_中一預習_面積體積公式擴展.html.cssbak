<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Course", "name": "P6 LF-P6-下-L37 中一預習 面積體積公式擴展", "description": "P6 math: LF-P6-下-L37 中一預習 面積體積公式擴展", "provider": {"@type": "Organization", "name": "LF Academy", "url": "https://lfacademyhk.com"}, "educationalLevel": "P6", "inLanguage": ["zh-HK", "en"], "teaches": "Primary Mathematics"}</script>
