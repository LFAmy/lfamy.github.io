<tr><th class="lf-qn">題號</th><th>Question</th><th>選項</th><th>答案</th></tr>
<tr>
<td class="lf-qn">1</td>
<td>計算 3.14 × 0.6 = ？</td>
<td class="opt">A. 0.1884<br/>B. 1.884<br/>C. 18.84<br/>D. 188.4</td>
<td class="lf-ans" style="min-height:75px;text-align:center;vertical-align:middle;">A B C D</td>
</tr>
<tr>
<td class="lf-qn">2</td>
