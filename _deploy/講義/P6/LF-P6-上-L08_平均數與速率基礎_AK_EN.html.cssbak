</div>
<table>
<tr><th>#</th><th>Question</th><th>答案</th><th>類型</th></tr>
<tr><td class="qn">1</td><td class="qq">計算：(85 + 92 + 78 + 95) ÷ 4 = ？</td><td class="qa" style="color:#16A34A;font-weight:700;">177</td><td class="qt">auto</td></tr>
<tr><td class="qn">2</td><td class="qq">計算：(120 + 0 + 90 + 60) ÷ 4 = ？</td><td class="qa" style="color:#16A34A;font-weight:700;">120</td><td class="qt">auto</td></tr>
<tr><td class="qn">3</td><td class="qq">轉換：1 km = _____ m · 1 小時 = _____ min = _____ 秒</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">4</td><td class="qq">一輛車行駛 180 km 用了 2 小時，平均Speed/Rate = ？km/h</td><td class="qa" style="color:#16A34A;font-weight:700;">90 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">5</td><td class="qq">小明有 5 次測驗Fraction：80, 85, 90, 0, 95。平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">例1</td><td class="qq">6 個數的平均是 15。這 6 個數的總和 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">例2</td><td class="qq">4 次測驗Fraction：72, 0, 88, 92。平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">6</td><td class="qq">5 個數的總和是 225，Average/Mean = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">7</td><td class="qq">4 個數的平均是 18，總和 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">8</td><td class="qq">小明 5 次小測：100, 95, 0, 88, 92。平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">9</td><td class="qq">6 個數：12, 0, 8, 15, 0, 10。Average/Mean = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">例3</td><td class="qq">甲組 10 人平均 85 分，乙組 15 人平均 75 分。全體平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">例4</td><td class="qq">男同學 12 人平均體重 45 kg，女同學 8 人平均體重 40 kg。全班平均體重 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">10</td><td class="qq">240 km ÷ 4 h = ？km/h</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">11</td><td class="qq">把 36 km/h 換算成 m/s。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">12</td><td class="qq">把 15 m/s 換算成 km/h。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">13</td><td class="qq">一輛車以Speed/Rate 90 km/h 行駛，2.5 小時能走多遠？</td><td class="qa" style="color:#16A34A;font-weight:700;">36 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">14</td><td class="qq">一段路 300 km，以Speed/Rate 75 km/h 行駛，需時多久？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">例7</td><td class="qq">一車先以 80 km/h 走 2 小時，再以 60 km/h 走 3 小時。平均Speed/Rate = ？</td><td class="qa" style="color:#16A34A;font-weight:700;">40 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">例8</td><td class="qq">小華跑步 6 km 用了 0.5 小時，再走 4 km 用了 1 小時。全程平均Speed/Rate = ？</td><td class="qa" style="color:#16A34A;font-weight:700;">12 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">15</td><td class="qq">3 個數：45, 55, 50。Average/Mean = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">16</td><td class="qq">4 個數的平均是 25，總和 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">17</td><td class="qq">Fraction：88, 0, 92, 76, 94。平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">18</td><td class="qq">一車以 60 km/h 行駛 2.5 h，求距離。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">19</td><td class="qq">把 90 km/h 換算成 m/s。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">20</td><td class="qq">甲組 25 人平均 72 分，乙組 15 人平均 84 分。全體平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">21</td><td class="qq">小明 4 科平均 85 分，第 5 科拿 95 分。5 科新平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">22</td><td class="qq">一車去程 80 km/h，回程 60 km/h（同一路程 240 km）。全程平均Speed/Rate = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">23</td><td class="qq">先以 5 m/s 跑 200 秒，再以 4 m/s 跑 300 秒。平均Speed/Rate = ？m/s</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">24</td><td class="qq">某班平均分為 78 分。若總分增加 120 分而人數不變（30人），新平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">25</td><td class="qq">甲班 30 人平均 82 分，乙班 20 人平均 ？分。若兩班合共平均 79 分，求乙班平均分。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">26</td><td class="qq">一車首 100 km 以 50 km/h 行駛，次 150 km 以 75 km/h 行駛。全程平均Speed/Rate = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">27</td><td class="qq">一車從 A 到 B，全程平均Speed/Rate 48 km/h。去程用 60 km/h 走了 120 km。回程用相同路程，求回程Speed/Rate。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">28</td><td class="qq">家明 6 次數學測驗Fraction如下：78, 85, 92, 76, 89, 0（缺席）。求他的平均分。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">29</td><td class="qq">商店四天營業額：$3200, $4500, $2800, $0（休息）。求平均每日營業額。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">30</td><td class="qq">男工 8 人平均日薪 $650，女工 4 人平均日薪 $500。求全體工人平均日薪。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">31</td><td class="qq">爸爸開車從家到公司距離 72 km。去程用 1.2 小時，回程用 1.5 小時。求 (a) 去程平均Speed/Rate (b) 回程平均Speed/Rate (c) 全程平均Speed/Rate。</td><td class="qa" style="color:#16A34A;font-weight:700;">60 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">32</td><td class="qq">由家到公園 15 km。哥哥先以 5 km/h 步行了 3 km，再以 12 km/h 跑步餘下路程。求全程平均Speed/Rate。（取至Decimal點後一位）</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">33</td><td class="qq">5 個數的平均是 20。加入一個新數後，新平均變成 22。求加入的數。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">34</td><td class="qq">哥哥 5 次默書平均 82 分。第 6 次得分後，平均升至 85 分。第 6 次得分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">35</td><td class="qq">一架飛機飛行 2400 km 用了 3 小時。求其Speed/Rate：(a) 以 km/h 表示 (b) 以 m/s 表示。</td><td class="qa" style="color:#16A34A;font-weight:700;">800 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">H1</td><td class="qq">6 個數的平均是 30，總和 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H2</td><td class="qq">Fraction：85, 70, 0, 95, 80。平均分 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H3</td><td class="qq">甲組 20 人平均 70 分，乙組 10 人平均 85 分。全體平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H4</td><td class="qq">把 54 km/h 換算成 m/s。</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H5</td><td class="qq">一車以 72 km/h 行駛，3.5 小時走多遠？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H6</td><td class="qq">4 科平均 82 分，第 5 科 90 分。新的 5 科平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H7</td><td class="qq">去程 100 km/h 走 200 km，回程 80 km/h 走相同路程。全程平均Speed/Rate = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H8</td><td class="qq">小明先以 4 m/s 跑 3 min，再以 6 m/s 跑 2 min。平均Speed/Rate = ？m/s</td><td class="qa" style="color:#16A34A;font-weight:700;">1.3 km/h</td><td class="qt">auto</td></tr>
<tr><td class="qn">H9</td><td class="qq">5 個數的平均是 16。拿走一個數（設為 12）後，餘下 4 個數的平均 = ？</td><td class="qa" style="color:#DC2626;">___</td><td class="qt">manual</td></tr>
<tr><td class="qn">H10</td><td class="qq">某車的Speed/Rate是 25 m/s。若以這Speed/Rate行駛 5 min，走多遠（以km表示）？</td><td class="qa" style="color:#16A34A;font-weight:700;">5 km/h</td><td class="qt">auto</td></tr>
</table>
