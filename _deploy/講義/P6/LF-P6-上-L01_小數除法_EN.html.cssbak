<tr><td class="lf-qn">12</td><td>2.5 ÷ 0.7 = ？（求商和餘數）</td><td class="qd d3"></td><td class="lf-ans" style="min-height:75px;"></td></tr>
<tr><td class="lf-qn">13</td><td>4.3 ÷ 1.2 = ？（求商和餘數）</td><td class="qd d3"></td><td class="lf-ans" style="min-height:75px;"></td></tr>
<tr><td class="lf-qn">14</td><td>5.8 ÷ 1.6 = ？（求商和餘數）</td><td class="qd d3"></td><td class="lf-ans" style="min-height:75px;"></td></tr>
<tr><td class="lf-qn">15</td><td>3.2 ÷ 0.9 = ？（求商和餘數）</td><td class="qd d3"></td><td class="lf-ans" style="min-height:75px;"></td></tr>
