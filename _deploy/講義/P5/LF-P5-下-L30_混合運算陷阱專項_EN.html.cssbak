<tr><td class="lf-qn">17</td><td>0.2 + <span class="fd"><span class="n">2</span><span class="b"></span><span class="d">5</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
