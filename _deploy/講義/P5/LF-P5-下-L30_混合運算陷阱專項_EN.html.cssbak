<tr><td class="lf-qn">19</td><td>0.8 × <span class="fd"><span class="n">3</span><span class="b"></span><span class="d">4</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
