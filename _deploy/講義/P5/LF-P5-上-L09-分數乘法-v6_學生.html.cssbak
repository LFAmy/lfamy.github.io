<tr><td class="lf-qn">6</td><td>1<span class="fd"><span class="n">1</span><span class="b"></span><span class="d">4</span></span> × <span class="fd"><span class="n">1</span><span class="b"></span><span class="d">2</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">7</td><td>1<span class="fd"><span class="n">2</span><span class="b"></span><span class="d">3</span></span> × <span class="fd"><span class="n">1</span><span class="b"></span><span class="d">5</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">8</td><td><span class="fd"><span class="n">1</span><span class="b"></span><span class="d">2</span></span> × <span class="fd"><span class="n">1</span><span class="b"></span><span class="d">4</span></span> × <span class="fd"><span class="n">4</span><span class="b"></span><span class="d">5</span></span> = ？</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">9</td><td><span class="fd"><span class="n">1</span><span class="b"></span><span class="d">3</span></span> × <span class="fd"><span class="n">3</span><span class="b"></span><span class="d">4</span></span> × <span class="fd"><span class="n">4</span><span class="b"></span><span class="d">5</span></span> = ？</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:72px;"></td></tr>
</table>
</div>
