<tr><td class="lf-qn">H2</td><td>當 k = 12 時，求 5k − 8 的值。</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H3</td><td>解Equation：x + 13 = 37</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H4</td><td>解Equation：x − 11 = 26</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H5</td><td>解Equation：7x = 84</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
