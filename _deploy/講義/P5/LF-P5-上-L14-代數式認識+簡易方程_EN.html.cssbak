<div class="lf-page">
<!-- ═══════════════ PAGE 1: COVER ═══════════════ -->
<div class="lf-cover">
<div class="lf-cover-logo">LF Academy <span style="font-weight:400;color:#C9A84C;font-size:14px;">· LF Academy</span></div>
