<div class="mc-opts" style="margin-top:2px;">
<span class="opt">C. <span class="f"><span class="n">9</span><span class="b"></span><span class="d">12</span></span> + <span class="f"><span class="n">2</span><span class="b"></span><span class="d">12</span></span> = <span class="f"><span class="n">11</span><span class="b"></span><span class="d">12</span></span></span>
<span class="opt">D. <span class="f"><span class="n">3+1</span><span class="b"></span><span class="d">4+6</span></span> = <span class="f"><span class="n">4</span><span class="b"></span><span class="d">10</span></span></span>
</div>
</td>
<td class="qs"><span class="score-box">___ / 2分</span></td>
</tr>
