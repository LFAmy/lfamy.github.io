        <div class="mc-opts">
<span class="opt">A. <span class="f"><span class="n">4</span><span class="b"></span><span class="d">10</span></span> = <span class="f"><span class="n">2</span><span class="b"></span><span class="d">5</span></span></span>
<span class="opt">B. <span class="f"><span class="n">11</span><span class="b"></span><span class="d">12</span></span></span>
