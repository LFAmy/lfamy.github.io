"72"></rect><rect fill="url(#m3-hatchD)" height="38" stroke="#9A3412" stroke-width="0.5" width="14" x="116" y="90"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="109" y="138">一月</text><rect fill="url(#m3-hatchA)" height="52" stroke="#2563EB" stroke-width="0.5" width="14" x="168" y="76"></rect><rect fill="url(#m3-hatchB)" height="38" stroke="#C2410C" stroke-width="0.5" width="14" x="184" y="90"></rect><rect fill="url(#m3-hatchC)" height="64" stroke="#1E40AF" stroke-width="0.5" width="14" x="200" y="64"></rect><rect fill="url(#m3-hatchD)" height="44" stroke="#9A3412" stroke-width="0.5" width="14" x="216" y="84"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="209" y="138">二月</text><rect fill="url(#m3-hatchA)" height="64" stroke="#2563EB" stroke-width="0.5" width="14" x="268" y="64"></rect><rect fill="url(#m3-hatchB)" height="52" stroke="#C2410C" stroke-width="0.5" width="14" x="284" y="76"></rect><rect fill="url(#m3-hatchC)" height="72" stroke="#1E40AF" stroke-width="0.5" width="14" x="300" y="56"></rect><rect fill="url(#m3-hatchD)" height="56" stroke="#9A3412" stroke-width="0.5" width="14" x="316" y="72"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="309" y="138">三月</text><rect fill="url(#m3-hatchA)" height="56" stroke="#2563EB" stroke-width="0.5" width="14" x="368" y="72"></rect><rect fill="url(#m3-hatchB)" height="46" stroke="#C2410C" stroke-width="0.5" width="14" x="384" y="82"></rect><rect fill="url(#m3-hatchC)" height="68" stroke="#1E40AF" stroke-width="0.5" width="14" x="400" y="60"></rect><rect fill="url(#m3-hatchD)" height="52" stroke="#9A3412" stroke-width="0.5" width="14" x="416" y="76"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="409" y="138">四月</text><rect fill="url(#m3-hatchA)" height="7" stroke="#2563EB" stroke-width="0.3" width="10" x="110" y="153"></rect><text fill="#333" font-size="7" x="123" y="160">A店筆記本</text><rect fill="url(#m3-hatchB)" height="7" stroke="#C2410C" stroke-width="0.3" width="10" x="180" y="153"></rect><text fill="#333" font-size="7" x="193" y="160">A店文件夾</text><rect fill="url(#m3-hatchC)" height="7" stroke="#1E40AF" stroke-width="0.3" width="10" x="250" y="153"></rect><text fill="#333" font-size="7" x="263" y="160">B店筆記本</text><rect fill="url(#m3-hatchD)" height="7" stroke="#9A3412" stroke-width="0.3" width="10" x="320" y="153"></rect><text fill="#333" font-size="7" x="333" y="160">B店文件夾</text></svg><div style="font-size:8px;color:var(--gray);">▲ 請參考以上圖表作答。完整版見第2頁。</div></div>
<div class="lf-kp">
<div class="lf-kp-title">知識點五：統計應用題（呈分試文字題專項）<span class="lf-sspa-badge lf-sspa-mid">🟡 SSPA 必考</span></div>
<div class="lf-kp-rules">
<strong>解題四步法：</strong>❶ <strong>圈關鍵詞</strong>（「平均」「合共」「相差」「幾倍」→ 選對運算）❷ <strong>從圖表提取數據</strong> ❸ <strong>列式計算</strong> ❹ <strong>寫完整答句</strong>（不寫答句扣步驟分！）
    </div>
</div>
<div class="lf-ex"><div class="lf-ex-title">例題</div><div class="lf-ex-q">例9：小文統計了過去四個月圖書館的借書量（本）：270、310、290、330。(a)繪製簡單棒形圖（每格代表50本）(b)求月平均借書量 (c)若五月借書量是前四個月的平均值，問五月比一月多幾本？</div></div>
<div class="lf-h2">應用題練習（全部必做，列式 → 計算 → 答句）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">32</td><td>超級市場統計了三種飲品的月銷量（箱）：<br/>可樂 240 箱、橙汁 180 箱、檸檬茶 210 箱。<br/>如果把數據畫成棒形圖，縱軸每格代表 30 箱，各需多少格？（每種飲品分別計算）</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">33</td><td>玩具店一月賣了 85 件，二月賣了 95 件，三月賣了 120 件，四月賣了 100 件。<br/>(a) 求月平均銷量<br/>(b) 哪個月的銷量高於平均值？高出多少？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:80px;"></td></tr>
<tr><td class="lf-qn">34</td><td>下表是兩班捐贈圖書數量。用複合棒形圖表示（每格代表 10 本）。<br/><table class="dt"><tr><th></th><th>故事書</th><th>科普書</th><th>漫畫</th></tr><tr><td>5A(本)</td><td>40</td><td>30</td><td>50</td></tr><tr><td>5B(本)</td><td>35</td><td>45</td><td>25</td></tr></table>(a) 5A班漫畫數是多少格？(b) 哪一類書兩班合計最多？多少本？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:82px;"></td></tr>
<tr><td class="lf-qn">35</td><td>根據複合棒形圖數據：如果把 A店和 B店 合併成「連鎖店集團」，一至四月每月集團總銷量是多少？繪製一條集團總銷量的折線圖的數據表（不用畫圖，只列數據）。</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:78px;"></td></tr>
<tr><td class="lf-qn">36</td><td>根據複合棒形圖數據：(a) A店筆記本銷量佔A店總銷量的幾分之幾？(b) B店文件夾銷量佔B店總銷量的幾分之幾？（答案以最簡分數表示）</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:82px;"></td></tr>
</table>
<div class="lf-h1">四、課後功課</div>
<div class="lf-h2">基礎必做題（共 4 題）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">H1</td><td>根據複合棒形圖，四月份哪間店的總銷量（筆記本＋文件夾）較高？高多少件？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H2</td><td>根據複合棒形圖，一至四月「A店筆記本」的總銷量是多少？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H3</td><td>下表為比賽得分，畫簡單棒形圖（每格代表 2 分），求每條棒需要幾格。<br/><table class="dt"><tr><th>隊伍</th><th>紅隊</th><th>藍隊</th><th>綠隊</th><th>黃隊</th></tr><tr><td>得分</td><td>18</td><td>24</td><td>14</td><td>20</td></tr></table></td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H4</td><td>根據複合棒形圖，計算一至四月「B店筆記本」的月平均銷量。</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
</table>
<div class="lf-h2">進階選做題（共 3 題，🚀 選做）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">H5</td><td>下表是兩店銷售數據，畫複合棒形圖。如果縱軸每格代表 20，各棒需幾格？<br/><table class="dt"><tr><th></th><th>第一季</th><th>第二季</th></tr><tr><td>X店(件)</td><td>80</td><td>100</td></tr><tr><td>Y店(件)</td><td>60</td><td>120</td></tr></table></td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">H6</td><td>下表為小食部三天營業額（$）。畫複合棒形圖，每格代表 $100。<br/><table class="dt"><tr><th></th><th>星期一</th><th>星期二</th><th>星期三</th></tr><tr><td>上午($)</td><td>450</td><td>380</td><td>520</td></tr><tr><td>下午($)</td><td>600</td><td>550</td><td>480</td></tr></table>(a) 星期三上午的棒應畫多少格？(b) 哪個時段（上午或下午）的總營業額較高？</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:78px;"></td></tr>
<tr><td class="lf-qn">H7</td><td>根據複合棒形圖，回答：如果五月份兩店合計總銷量比四月上升 15%，五月的總銷量大約是多少件？（取整數）</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:75px;"></td></tr>
</table>
</div>
<div class="lf-h1">📐 綜合繪圖練習 — 三種圖表全覆蓋</div>
<div class="lf-kp"><div class="lf-kp-title">呈分試必備：能讀圖，更要能畫圖！</div><div class="lf-kp-rules">
SSPA 卷一常見題型：給你一個數據表，要求你 (a) 繪製棒形圖 (b) 繪製折線圖 (c) 回答數據問題。<br/>
以下三題提供了空白圖表模板，請根據題目數據完成繪製。
</div></div>
<table class="lf-qt">
<tr><th class="lf-qn">繪1</th><th>題目</th><th class="lf-qd">圖表</th></tr>
<tr><td class="lf-qn">📊</td><td>超級市場統計了三種飲品的月銷量（箱）：可樂 240 箱、橙汁 180 箱、檸檬茶 210 箱。請在下方空白棒形圖中畫出棒形。</td><td class="lf-qd"><svg height="320" viewbox="0 0 286 320" width="286" xmlns="http://www.w3.org/2000/svg"><line stroke="#374151" stroke-width="2" x1="85" x2="85" y1="35" y2="290"></line><line stroke="#374151" stroke-width="2" x1="85" x2="266" y1="290" y2="290"></line><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="290.0" y2="290.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="294.0">0</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="247.5" y2="247.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="251.5">50</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="205.0" y2="205.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="209.0">100</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="162.5" y2="162.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="166.5">150</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="120.0" y2="120.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="124.0">200</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="77.5" y2="77.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="81.5">250</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="266" y1="35.0" y2="35.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="39.0">300</text><text fill="#6B7280" font-size="9" font-weight="700" text-anchor="end" x="77" y="39">(箱)</text><text fill="#1A3C6D" font-size="11" text-anchor="middle" transform="rotate(-90,14,162)" x="14" y="162">銷量</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="115.16666666666667" y="308">可樂</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="175.5" y="308">橙汁</text><text fill="#1A3C6D" font-size="11" font-weight="700" text-anchor="middle" x="235.83333333333334" y="308">檸檬茶</text><text fill="#1A3C6D" font-size="13" font-weight="700" text-anchor="middle" x="143" y="25">請繪製飲品銷量棒形圖</text><rect fill="none" height="255" stroke="#E5E7EB" stroke-dasharray="4,3" stroke-width="1" width="40" x="94" y="35"></rect><rect fill="none" height="255" stroke="#E5E7EB" stroke-dasharray="4,3" stroke-width="1" width="40" x="152" y="35"></rect><rect fill="none" height="255" stroke="#E5E7EB" stroke-dasharray="4,3" stroke-width="1" width="40" x="210" y="35"></rect><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="middle" x="143" y="322">（請在虛線框內畫出棒形）</text></svg></td></tr>
<tr><td class="lf-qn">📊</td><td>下表是兩班捐贈圖書數量，請在下方空白複合棒形圖中畫出。<br/><table class="dt"><tr><th></th><th>故事書</th><th>科普書</th><th>漫畫</th></tr><tr><td>5A(本)</td><td>40</td><td>30</td><td>50</td></tr><tr><td>5B(本)</td><td>35</td><td>45</td><td>25</td></tr></table></td><td class="lf-qd"><svg height="380" viewbox="0 0 332 380" width="332" xmlns="http://www.w3.org/2000/svg"><line stroke="#374151" stroke-width="2" x1="85" x2="85" y1="35" y2="350"></line><line stroke="#374151" stroke-width="2" x1="85" x2="312" y1="350" y2="350"></line><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="350.0" y2="350.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="354.0">0</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="297.5" y2="297.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="301.5">10</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="245.0" y2="245.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="249.0">20</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="192.5" y2="192.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="196.5">30</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="140.0" y2="140.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="144.0">40</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="87.5" y2="87.5"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="91.5">50</text><line stroke="#E5E7EB" stroke-width="0.5" x1="85" x2="312" y1="35.0" y2="35.0"></line><text fill="#6B7280" font-size="10" font-weight="700" text-anchor="end" x="77" y="39.0">60</text><text fill="#6B7280" font-size="9" font-weight="700" text-anchor="end" x="77" y="39">(本)</text><text fill="#1A3C6D" font-size="11" text-anchor="middle" transform="rotate(-90,14,1