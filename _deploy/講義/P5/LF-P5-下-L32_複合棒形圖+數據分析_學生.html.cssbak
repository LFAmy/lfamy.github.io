"72"></rect><rect fill="url(#m2-hatchD)" height="38" stroke="#9A3412" stroke-width="0.5" width="14" x="116" y="90"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="109" y="138">一月</text><rect fill="url(#m2-hatchA)" height="52" stroke="#2563EB" stroke-width="0.5" width="14" x="168" y="76"></rect><rect fill="url(#m2-hatchB)" height="38" stroke="#C2410C" stroke-width="0.5" width="14" x="184" y="90"></rect><rect fill="url(#m2-hatchC)" height="64" stroke="#1E40AF" stroke-width="0.5" width="14" x="200" y="64"></rect><rect fill="url(#m2-hatchD)" height="44" stroke="#9A3412" stroke-width="0.5" width="14" x="216" y="84"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="209" y="138">二月</text><rect fill="url(#m2-hatchA)" height="64" stroke="#2563EB" stroke-width="0.5" width="14" x="268" y="64"></rect><rect fill="url(#m2-hatchB)" height="52" stroke="#C2410C" stroke-width="0.5" width="14" x="284" y="76"></rect><rect fill="url(#m2-hatchC)" height="72" stroke="#1E40AF" stroke-width="0.5" width="14" x="300" y="56"></rect><rect fill="url(#m2-hatchD)" height="56" stroke="#9A3412" stroke-width="0.5" width="14" x="316" y="72"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="309" y="138">三月</text><rect fill="url(#m2-hatchA)" height="56" stroke="#2563EB" stroke-width="0.5" width="14" x="368" y="72"></rect><rect fill="url(#m2-hatchB)" height="46" stroke="#C2410C" stroke-width="0.5" width="14" x="384" y="82"></rect><rect fill="url(#m2-hatchC)" height="68" stroke="#1E40AF" stroke-width="0.5" width="14" x="400" y="60"></rect><rect fill="url(#m2-hatchD)" height="52" stroke="#9A3412" stroke-width="0.5" width="14" x="416" y="76"></rect><text fill="#333" font-size="8" font-weight="700" text-anchor="middle" x="409" y="138">四月</text><rect fill="url(#m2-hatchA)" height="7" stroke="#2563EB" stroke-width="0.3" width="10" x="110" y="153"></rect><text fill="#333" font-size="7" x="123" y="160">A店筆記本</text><rect fill="url(#m2-hatchB)" height="7" stroke="#C2410C" stroke-width="0.3" width="10" x="180" y="153"></rect><text fill="#333" font-size="7" x="193" y="160">A店文件夾</text><rect fill="url(#m2-hatchC)" height="7" stroke="#1E40AF" stroke-width="0.3" width="10" x="250" y="153"></rect><text fill="#333" font-size="7" x="263" y="160">B店筆記本</text><rect fill="url(#m2-hatchD)" height="7" stroke="#9A3412" stroke-width="0.3" width="10" x="320" y="153"></rect><text fill="#333" font-size="7" x="333" y="160">B店文件夾</text></svg><div style="font-size:8px;color:var(--gray);">▲ 請參考以上圖表作答。完整版見第2頁。</div></div>
<div class="lf-kp">
<div class="lf-kp-title">知識點四：統計應用 — 平均數、估算與推理<span class="lf-sspa-badge lf-sspa-mid">🟡 SSPA</span></div>
<div class="lf-kp-rules">
<strong>從複合棒形圖做統計分析：</strong><br/>
      ❶ <strong>平均數</strong> = 總和 ÷ 項數。例如：A店筆記本四個月的月均銷量 = 四個月銷量總和 ÷ 4<br/>
      ❷ <strong>估算</strong>：根據走勢推測下一個月的銷量（看趨勢是升是降，再給合理數字）<br/>
      ❸ <strong>推理</strong>：分析為甚麼某月銷量特別高／低（可能節日、考試季節、天氣等）<br/>
      ❹ <strong>綜合</strong>：把讀圖＋計算＋推理結合，回答較複雜的開放式問題
    </div>
</div>
<div class="lf-ex"><div class="lf-ex-title">例題</div><div class="lf-ex-q">例7：根據複合棒形圖，求「A店筆記本」在一至四月的月平均銷量。</div></div>
<div class="lf-ex"><div class="lf-ex-title">例題</div><div class="lf-ex-q">例8：根據複合棒形圖中「B店筆記本」一至四月的變化趨勢，你估計五月份 B店筆記本的銷量大約是多少？為甚麼？</div></div>
<div class="lf-h2">知識點四 同步練習</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">19</td><td>根據複合棒形圖：求「A店文件夾」在一至四月的月平均銷量。</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">20</td><td>根據複合棒形圖：四個月中，「B店文件夾」的總銷量是多少？平均每月多少件？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">21</td><td>根據複合棒形圖：A店總銷量（筆記本＋文件夾，四個月合計）和B店總銷量，哪間店較高？相差多少？</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:78px;"></td></tr>
<tr><td class="lf-qn">22</td><td>如果五月份兩店都做「買二送一」大減價，你預計五月銷量會怎樣變化？為甚麼？（開放題，合理即可）</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:75px;"></td></tr>
</table>
<div class="lf-h1">三、課堂分層同步練習 （20 分鐘）</div>
<div class="lf-h2">🌱 基礎層（共 3 題，全體必做）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">23</td><td>根據複合棒形圖：三月份哪一種商品的銷量最高？是多少件？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">24</td><td>根據複合棒形圖：一月份 A店兩種商品的銷量相差多少件？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">25</td><td>根據複合棒形圖：四個月中，所有商品總銷量最低的是哪一個月？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
</table>
<div class="lf-h2">🌿 進階層（共 3 題，🚶 🚀 選做）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">26</td><td>根據複合棒形圖：比較「A店筆記本」和「B店筆記本」的銷售走勢（一至四月），兩者走勢有甚麼異同？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">27</td><td>根據複合棒形圖：四個月中，筆記本類（A店＋B店合計）在哪個月銷量最高？文件夾類呢？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">28</td><td>根據複合棒形圖：如果一月的數據不小心被遮蓋了 B店文件夾那一條棒，你能從其他月份的走勢推測大約數字嗎？說明理由。</td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:75px;"></td></tr>
</table>
<div class="lf-h2">🌳 挑戰層（共 3 題，🚀 選做，呈分試殺手題）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>題目</th><th class="lf-qd">難度</th><th>作答區</th></tr>
<tr><td class="lf-qn">29</td><td>沒有圖表輔助：下表為甲、乙兩店半年銷售數據。哪間店的月平均銷量較高？相差多少？<br/><table class="dt"><tr><th>月份</th><th>1月</th><th>2月</th><th>3月</th><th>4月</th><th>5月</th><th>6月</th></tr><tr><td>甲店(萬元)</td><td>12</td><td>15</td><td>18</td><td>14</td><td>20</td><td>17</td></tr><tr><td>乙店(萬元)</td><td>14</td><td>13</td><td>19</td><td>16</td><td>18</td><td>22</td></tr></table></td><td class="qd d3">🌳</td><td class="lf-ans" style="min-height:85px;"></td></tr>
<tr><td class="lf-qn">30</td><td>下表是學校三個學會的會員人數，要用一個複合棒形圖表示（縱軸每格代表 5 人）。<br/>5A：電腦8、音樂12、美術15   5B：電腦14、音樂9、美術11<br/>(a) 畫出縱軸標籤 (b) 計算每條棒的高度（格數）(c) 繪製簡圖（只需畫出相對位置和高度）</td><td class="qd d4">🏔️</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">31</td><td>下表是兩間書店三個月的銷售額，但缺失了部分數據。已知 A店四月銷售額 = B店四月銷售額 + 30，三月兩店合共賣出 720。<br/><table class="dt"><tr><th>月份</th><th>二月</th><th>三月</th><th>四月</th></tr><tr><td>A店($)</td><td>250</td><td>?</td><td>?</td></tr><tr><td>B店($)</td><td>200</td><td>380</td><td>?</td></tr></table>求：(a) A店三月銷售額 (b) 如果A店四月比三月少50，四月B店銷售額是多少？</td><td class="qd d4">🏔️</td><td class="lf-ans" style="min-height:75px;"></td></tr>
</table>
</div>
