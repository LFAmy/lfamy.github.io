<span class="opt">A. 7,000,500</span>
<span class="opt">B. 7,500,000</span>
<span class="opt">C. 7,050,000</span>
<span class="opt">D. 7,005,000</span>
</div>
</td>
<td class="qs"><span class="score-box">___ / 3分</span></td>
</tr>
<tr>
<td class="lf-qn">2</td>
<td>
