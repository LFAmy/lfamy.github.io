<tr><td class="lf-qn">19</td><td><span class="f"><span class="n">3</span><span class="b"></span><span class="d">8</span></span> + <span class="f"><span class="n">5</span><span class="b"></span><span class="d">12</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
<tr><td class="lf-qn">20</td><td><span class="f"><span class="n">7</span><span class="b"></span><span class="d">10</span></span> − <span class="f"><span class="n">2</span><span class="b"></span><span class="d">5</span></span> = ？</td><td class="qd d2">🌿</td><td class="lf-ans" style="min-height:72px;"></td></tr>
