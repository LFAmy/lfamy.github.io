<tr><td class="lf-qn">12</td><td><span class="f"><span class="n">1</span><span class="b"></span><span class="d">3</span></span> + <span class="f"><span class="n">1</span><span class="b"></span><span class="d">9</span></span> = ？</td><td class="qd d1">🌱</td><td class="lf-ans" style="min-height:72px;"></td></tr>
