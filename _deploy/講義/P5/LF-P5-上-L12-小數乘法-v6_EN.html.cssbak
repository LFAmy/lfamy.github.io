<!-- ═══════════════ PAGE 6: APPLICATION + CHALLENGE ═══════════════ -->
<div>
<div class="lf-h1">四、DecimalMultiplicationWord Problems（共 6 題，全部必做）</div>
<table class="lf-qt">
<tr><th class="lf-qn">#</th><th>Question</th><th class="lf-qd">Difficulty</th><th>Answer Area</th></tr>
