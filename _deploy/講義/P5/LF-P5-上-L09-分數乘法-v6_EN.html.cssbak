<text fill="#6B7280" font-size="10" text-anchor="middle" x="240" y="115">→ 6/12 = 1/2</text>
<!-- Cross-simplification diagram -->
<text fill="#1A3C6D" font-size="10" font-weight="700" text-anchor="middle" x="380" y="40">交叉約分示意</text>
