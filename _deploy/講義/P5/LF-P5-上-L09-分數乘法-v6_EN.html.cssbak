<rect fill="#DBEAFE" height="36" stroke="#1A3C6D" stroke-width="1.5" width="40" x="0" y="36"></rect>
<rect fill="#DBEAFE" height="36" stroke="#1A3C6D" stroke-width="1.5" width="40" x="40" y="36"></rect>
<rect fill="#DBEAFE" height="36" stroke="#1A3C6D" stroke-width="1.5" width="40" x="80" y="36"></rect>
<!-- Cell labels -->
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="20" y="23">1/12</text>
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="60" y="23">1/12</text>
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="100" y="23">1/12</text>
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="20" y="59">1/12</text>
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="60" y="59">1/12</text>
<text fill="#1A3C6D" font-size="8" text-anchor="middle" x="100" y="59">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="140" y="23">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="140" y="59">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="20" y="95">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="60" y="95">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="100" y="95">1/12</text>
<text fill="#9CA3AF" font-size="8" text-anchor="middle" x="140" y="95">1/12</text>
</g>
<!-- Bracket for 2/3 -->
<path d="M17,30 L17,130" fill="none" stroke="#1A3C6D" stroke-width="1.5"></path>
