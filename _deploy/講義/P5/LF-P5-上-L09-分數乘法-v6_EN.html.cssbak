<line stroke="#D1D5DB" stroke-width="0.8" x1="0" x2="160" y1="72" y2="72"></line>
<!-- Highlighted cells (2/3 × 3/4 = 6 out of 12) -->
<rect fill="#DBEAFE" height="36" stroke="#1A3C6D" stroke-width="1.5" width="40" x="0" y="0"></rect>
<rect fill="#DBEAFE" height="36" stroke="#1A3C6D" stroke-width="1.5" width="40" x="40" y="0"></rect>
